<?xml version="1.0"?>
<odoo>
    <record id="send_sms_template_data_invoice_paid" model="send.sms.template">
        <field name="name">Invoice Paid</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="msg_to">${object.partner_id.get_mobile_numbers() or ''}</field>
        <field name="template_body"><![CDATA[
Invoice ${object.number} paid successfully.
       ]]></field>
    </record>

    <record id="send_sms_template_data_invoice_validate" model="send.sms.template">
        <field name="name">Invoice Validate</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="msg_to">${object.partner_id.get_mobile_numbers() or ''}</field>
        <field name="template_body"><![CDATA[
Dear ${object.partner_id.name}
Here is invoice number ${object.number} with amount ${object.residual}
Mpesa Paybill: ${object.mpesa_paybill}
       ]]></field>
    </record>
    <data noupdate="1">
        <record id="gateway_template_one" model="sms.gateway">
            <field name="name">dummy</field>
            <field name="apiClientID">dummy</field>
            <field name="key">dummy</field>
            <field name="secret">dummy</field>
            <field name="txtMessage">this is test message</field>
            <field name="Msisdn">dummy</field>
        </record>
    </data>
</odoo>
