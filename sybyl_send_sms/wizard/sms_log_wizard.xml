<odoo>
    <record id="wizard_sms_send_log_form_view" model="ir.ui.view">
        <field name="name">wizard.sms.send.log.form</field>
        <field name="model">wizard.sms.send.log</field>
        <field name="arch" type="xml">
            <form string="Send Sms Logs">
                <p class="oe_grey">
                    Send sms selected logs.
                </p>
                <separator string="Sms Logs" colspan="4" />
                <field name="sms_log_ids" widget="many2many_tags" readonly="1" />
                <footer>
                    <button string="Send Sms" name="send_sms_logs" type="object"
                        default_focus="1" class="oe_highlight" />
                    or
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
