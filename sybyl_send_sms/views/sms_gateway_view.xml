<odoo>
    <data>
        <record id="view_sms_gateway_from" model="ir.ui.view">
            <field name="name">sms.gateway.from.view</field>
            <field name="model">sms.gateway</field>
            <field name="arch" type="xml">
                <form string="SMS GateWay">
                    <header>
                        <button name="test_send_sms_connection" type="object" string="Test Connection" icon="fa-television"/>
                    </header>
                     <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button"/>
                            </button>
                        </div>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <group>
                                <field name="apiClientID" string="ACCOUNT SID"/>
                            </group>
                            <group>
                                <field name="key" string="AUTH KEY"/>
                            </group>
                            <group>
                                <field name="secret" string="AUTH SECRET"/>
                            </group>
                            <group>
                                <field name="serviceID" string="Service ID"/>
                            </group>
                            <group>
                                <field name="txtMessage" string="Test Message"/>
                                <field name="Msisdn"/>
                            </group>
                        </group>
                     </sheet>
                </form>
            </field>
        </record>
        
        <record id="sms_gateway_view_tree" model="ir.ui.view">
            <field name="name">sms.gateway.view.tree</field>
            <field name="model">sms.gateway</field>
            <field name="arch" type="xml">
                <list string="SMS Account">
                    <field name="name"/>
                    <field name="apiClientID"/>
                    <field name="key"/>
                    <field name="secret"/>
                    <field name="serviceID"/>
                </list>
            </field>
        </record>

        <record id="sms_gateway_action" model="ir.actions.act_window">
            <field name="name">SMS Account</field>
            <field name="res_model">sms.gateway</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Add SMS Gateway Accounts</p>
            </field>
        </record>

        <menuitem id="sms_parent_menu"
                  parent="base.menu_custom"
                  name="Send SMS"
                  sequence="1"/>

        <menuitem id="sms_account_menu"
                  name="Accounts"
                  parent="sms_parent_menu"
                  action="sms_gateway_action"
                  sequence="10"/>
    </data>
</odoo>