<odoo noupdate="1">
    <record id="dtb_journal" model="account.journal">
        <field name="name">DTB bank</field>
        <field name="code">DTB</field>
        <field name="type">bank</field>
        <field name="is_dtb_journal" eval="True"/>
    </record>
    <record id="dtb_match_invoice_record_cron" model="ir.cron">
        <field name="name">DTB Payment Transaction: Auto Reconcile</field>
        <field name="model_id" ref="model_dtb_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_validate_move_payment_new()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
<!--        <field name="numbercall">-1</field>-->
<!--        <field name="doall" eval="False"/>-->
        <field name="active" eval="False"/>
    </record>
</odoo>