<odoo noupdate="1">
    <record id="sequence_dtb_transaction" model="ir.sequence">
        <field name="name">DTB bank transaction sequence</field>
        <field name="code">dtb.transaction</field>
        <field name="prefix">DTB.REF/%(range_year)s/</field>
        <field eval="1" name="number_next"/>
        <field eval="1" name="number_increment"/>
        <field eval="True" name="use_date_range"/>
        <field eval="False" name="company_id"/>
        <field name="padding">4</field>
    </record>
</odoo>