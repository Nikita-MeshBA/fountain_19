<odoo>
    <record id="from_dtb_transaction_view" model="ir.ui.view">
        <field name="name">from.dtb.transaction.view</field>
        <field name="model">dtb.transaction</field>
        <field name="arch" type="xml">
            <form string="DTB BANK Transaction" create="false" edit="false">
                <header>
<!--                    <button name="validate_move_payment_new" type="object" string="Reconcile" class="oe_highlight"-->
<!--                            invisible="'state', 'in', ('done', 'cancel')"/>-->
                       <button name="validate_move_payment_new" type="object" string="Reconcile" class="oe_highlight"
        invisible="state in ('done', 'cancel')"/>
                    <button name="state_cancel" type="object" string="Cancel" class="oe_highlight"
                            invisible="'state', 'in', ('cancel', 'done')"/>
                    <button name="state_draft" type="object" string="Set to Draft"
                            invisible="'state', 'in', ('draft', 'done')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title mw-100 pr-0">
                        <h1 class="flex-fill d-flex flex-row">
                            <field name="name" class="text-truncate w-100"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="cbs_reference" readonly="1"/>
                            <field name="account_number" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="value_date" readonly="1"/>
                            <field name="reversal_indicator" readonly="1"/>
                            <field name="exchange_rate" readonly="1"/>
                            <field name="transaction_code" readonly="1"/>
                            <field name="virtual_pan" readonly="1"/>
                            <field name="customer_name" readonly="1"/>
                            <field name="serial_number" readonly="1"/>
                            <field name="move_name" readonly="1" invisible="1"/>
                            <field name="payment_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="cbs_module" readonly="1"/>
                            <field name="branch_code" readonly="1"/>
                            <field name="dblAmount" readonly="1"/>
                            <field name="currency" readonly="1"/>
                            <field name="debit_credit_indicator" readonly="1"/>
                            <field name="financial_year" readonly="1"/>
                            <field name="transaction_description" readonly="1"/>
                            <field name="rrn" readonly="1"/>
                            <field name="customer_mobile" readonly="1"/>
                            <field name="narration" readonly="1"/>
                            <field name="move_id" readonly="1" invisible="1"/>
                            <field name="move_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dtb_transaction_list" model="ir.ui.view">
        <field name="name">tree.dtb.transaction</field>
        <field name="model">dtb.transaction</field>
        <field name="arch" type="xml">
            <list string="DTBBANK Transaction" create="false" edit="false" decoration-info="state == 'draft'"
                  decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="state" invisible="1"/>
                <field name="name"/>
                <!--                <field name="bill_ref_no"/>-->
                <!--                <field name="strTransNo"/>-->
                <!--                <field name="student_id"/>-->
                <field name="transaction_description"/>
                <field name="create_date"/>
                <field name="dblAmount"/>
                <field name="debit_credit_indicator"/>
<!--                <button name="validate_move_payment_new" string="Reconcile" type="object"-->
<!--                        invisible="'state', 'in', ('done', 'cancel')"/>-->
<!--                <button name="state_cancel" string="Cancel" type="object"-->
<!--                        invisible="'state', 'in', ('done', 'cancel')"/>-->
                        <button name="validate_move_payment_new" string="Reconcile" type="object"
                                     invisible="state in ('done', 'cancel')"/>
                   <button name="state_cancel" string="Cancel" type="object"
                         invisible="state in ('done', 'cancel')"/>
            </list>
        </field>
    </record>

    <record id="view_dtb_transaction_search" model="ir.ui.view">
        <field name="name">dtb.transaction.search</field>
        <field name="model">dtb.transaction</field>
        <field name="arch" type="xml">
            <search string="DTBBANK Transaction">
                <field name="narration" string="Narration"/>
                <field name="dblAmount" string="Amount"/>
                <field name="create_date" string="Created On"/>
                <field name="state" string="State"/>
                <separator/>
                <filter domain="[('state', '=', 'draft')]" name="draft" string="Draft"/>
                <filter domain="[('state', '=', 'done')]" name="done" string="Reconciled"/>
                <filter domain="[('state', '=', 'cancel')]" name="cancel" string="Cancelled"/>
                <filter
                        name="Today"
                        domain="[('create_date','=', datetime.datetime.today())]"
                        help="Today"
                />
                <filter domain="[('debit_credit_indicator', '=', 'D')]" name="debit" string="Debit"/>
                <filter domain="[('debit_credit_indicator', '=', 'C')]" name="credit" string="Credit"/>

                <separator/>
<!--                <group string="Group By">-->
                    <!--                    <filter context="{'group_by':'bill_ref_no'}" domain="[]" name="group_strRegNo" string="Reference Number"/>-->
                    <filter context="{'group_by':'state'}" domain="[]" name="group_state" string="Status"/>
                    <filter context="{'group_by':'create_date'}" domain="[]" name="group_create_date"
                            string="Created on"/>
<!--                </group>-->
            </search>
        </field>
    </record>

    <record id="action_dtb_transaction" model="ir.actions.act_window">
        <field name="name">Transaction</field>
        <field name="res_model">dtb.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dtb_transaction_search"/>
        <field name="view_id" ref="dtb_transaction_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Transaction is not found
            </p>
            <p>
            </p>
        </field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_dtb_transaction" name="DTB-BANK Transaction" action="action_dtb_transaction"
              groups="account.group_account_user,account.group_account_manager" sequence="30"
              parent="account.menu_finance_receivables"/>
</odoo>