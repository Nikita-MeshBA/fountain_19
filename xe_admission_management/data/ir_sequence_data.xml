<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequences for admission -->
    <record id="seq_xe_admission" model="ir.sequence">
        <field name="name">Admission</field>
        <field name="code">xe.admission.enquiry</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_xe_enquiry" model="ir.sequence">
        <field name="name">Enquiry</field>
        <field name="code">xe.admission.inquiry</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>


