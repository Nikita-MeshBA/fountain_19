<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pass_or_fail_reason_form" model="ir.ui.view">
        <field name="name">Enter Reason</field>
        <field name="model">pass.or.fail.reason</field>
        <field name="arch" type="xml">
            <form string="Enter Reason">
                <group>
                    <group>
                        <field name="student_name"/>
                        <field name="interview_end_date"/>
                    </group>
                    <group>
                        <field name="interview_start_date"/>
                    </group>
                </group>
                <field name="description" placeholder="Notes..."/>
                <footer>
                    <button string="OK" name="action_ok" type="object" default_focus="1" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pass_or_fail_reason" model="ir.actions.act_window">
        <field name="name">Enter Reason for Pass</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pass.or.fail.reason</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id"
               ref="xe_admission_management.model_xe_admission_enquiry"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>