<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assign_employee_form" model="ir.ui.view">
        <field name="name">Assign Enquiry</field>
        <field name="model">assign.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Enquiry">
                <group>
                    <field name="employee_id"/>
                </group>
                <footer>
                    <button string="Assign" name="action_ok" type="object" default_focus="1" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_assign_employee" model="ir.actions.act_window">
        <field name="name">Assign Enquiry</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">assign.employee.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="xe_admission_management.model_xe_admission_enquiry"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
