<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="admission_fee_wizard_form" model="ir.ui.view">
        <field name="name">Admission Fee Wizard</field>
        <field name="model">admission.fee.wizard</field>
        <field name="arch" type="xml">
            <form string="Admission Fee">
                <group>
                    <group>
                        <field name="student_id" readonly="1"/>
                        <field name="course_id" readonly="1"/>
                        <field name="application_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="classroom_id" readonly="1"/>
                        <field name="current_academic_year_id" readonly="1"/>
                        <field name="is_transport" invisible="1"/>
                        <!--  <field name="fees_to_zone_id"
                                domain="[('is_transport_fees', '=', is_transport)]"
                                invisible="is_transport == False" readonly="1"/> -->
                        <field name="is_activity" invisible="1"/>
                        <!-- <field name="activity_fee_ids" string="Activities"
                               force_save="1" domain="[('is_activity', '=', is_activity)]"
                               widget="many2many_tags" readonly="1"
                               invisible="is_activity == False"/> -->
                        <field name="is_boarding" invisible="1"/>
                        <field name="is_optional" invisible="1"/>
                        <!-- <field name="optional_fee_ids" string="Optional"
                               force_save="1" domain="[('is_optional', '=', is_optional)]"
                               widget="many2many_tags" readonly="1"
                               invisible="is_optional == False"/> -->
                        <field name="term_id" domain="[('academic_year_id', '=', current_academic_year_id)]"
                               readonly="1"/>
                    </group>
                </group>
                <notebook>
                    <page name="fees_details" string="Fees Details">
                        <field name="fee_details_ids">
                            <list editable="bottom">
                                <field name="is_transport_fees" column_invisible="1"/>
                                <field name="is_activity" column_invisible="1"/>
                                <field name="is_boarding" column_invisible="1"/>
                                <field name="is_optional" column_invisible="1"/>
                                <field name="fee_type_id"
                                       domain="[('is_transport_fees','=',parent.is_transport),('is_activity','=',parent.is_activity),('is_boarding','=',parent.is_boarding),('is_optional','=',parent.is_optional)]"/>
                                <field name="term_id"/>
                                <field name="invoice_date"/>
                                <field name="due_days" column_invisible="1"/>
                                <field name="due_date"/>
                                <field name="schedule_date"/>
                                <field name="receipt_name_id"/>
                                <field name="amount"/>
                                <field name="activity_fee" column_invisible="1"/>
                                <field name="academic_fee" column_invisible="1"/>
                                <field name="optional_fee" column_invisible="1"/>
                                <field name="transport_fee" column_invisible="1"/>
                                <field name="boarding_fee" column_invisible="1"/>
                                <field name="discount"/>
                                <field name="fixed_discount"/>
                                <field name="discounted_amt"/>
                                <field name="fee_structure_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Generate" name="generate_new" type="object"
                            default_focus="1" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_admission_fee" model="ir.actions.act_window">
        <field name="name">Admission Fee Action</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">admission.fee.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- TODO: check if we need this -->
        <field name="binding_model_id"
               ref="xe_admission_management.model_admission_fee_wizard"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
