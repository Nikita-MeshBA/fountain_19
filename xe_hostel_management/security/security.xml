<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="module_category_hostel_management" model="ir.module.category">
            <field name="name">Hostel</field>
            <field name="description">Helps you to Manage Access Rights</field>
            <field name="sequence">25</field>
        </record>

        <record id="privilege_hostel_management" model="res.groups.privilege">
            <field name="name">Hostel Management</field>
            <field name="category_id" ref="module_category_hostel_management"/>
            <field name="sequence">25</field>
        </record>

        <record id="group_hostel_warden" model="res.groups">
            <field name="name">Warden</field>
            <field name="privilege_id" ref="privilege_hostel_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
