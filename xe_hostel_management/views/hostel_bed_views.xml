<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="xe_hostel_bed_tree_view" model="ir.ui.view">
        <field name="name">xe.hostel.bed.tree.view</field>
        <field name="model">xe.hostel.bed</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="bed_category_id"/>
                <field name="room_id" string="Assign to Room"/>
                <field name="floor_id"/>
                <field name="student_id"/>
            </list>
        </field>
    </record>

    <record id="xe_hostel_bed_form_view" model="ir.ui.view">
        <field name="name">xe.hostel.bed.form.view</field>
        <field name="model">xe.hostel.bed</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="product_image" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image':'product_image'}" force_save="1"/>
                    <group>
                        <group>
                            <field name="product_id" string="Product" required="1" options="{'no_create': true, 'no_edit': true}"/>
                            <field name="name"/>
                            <field name="bed_category_id" options="{'no_create': true, 'no_edit': true}"/>
                            <field name="room_id" string="Assign to Room" options="{'no_create': true, 'no_edit': true}"/>
                            <field name="floor_id" string="Floor" options="{'no_create': true, 'no_edit': true}" force_save="1"/>
                        </group>
                        <group>
                            <field name="student_id" options="{'no_create': true, 'no_edit': true}" readonly="1"/>
                            <field name="product_categ_id" string="Category" options="{'no_create': true, 'no_edit': true}"/>
                            <field name="product_uom_id" string="Unit of measure" options="{'no_create': true, 'no_edit': true}"/>
                            <field name="product_type" string="Type" options="{'no_create': true, 'no_edit': true}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hostel_beds" model="ir.actions.act_window">
        <field name="name">Beds</field>
        <field name="res_model">xe.hostel.bed</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>