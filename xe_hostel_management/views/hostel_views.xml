<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="xe_hostel_tree_view" model="ir.ui.view">
        <field name="name">xe.hostel.tree.view</field>
        <field name="model">xe.hostel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Hostel Name"/>
                <field name="code" string="Hostel Code"/>
            </list>
        </field>
    </record>

    <record id="xe_hostel_form_view" model="ir.ui.view">
        <field name="name">xe.hostel.form.view</field>
        <field name="model">xe.hostel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="get_hostel_admission" type="object" string="Admissions" class="oe_stat_button"
                        icon="fa-list"/>
                    </div>
                    <group>
                        <group>
                            <field name="name" string="Hostel Name" required="1"/>
                            <field name="code" string="Hostel Code" required="1"/>
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                            </div>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone" class="o_force_ltr"/>
                            <field name="mobile" class="o_force_ltr"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Basic Info">
                            <group>
                                <group string="Hostel Details">
                                    <field name="warden_id" string="Warden"/>
                                    <field name="capacity" readonly="1" force_save="1"/>
                                    <field name="total_floors"/>
                                    <field name="vacancy" readonly="1" force_save="1"/>
                                    <field name="total_rooms" readonly="1" force_save="1"/>
                                    <field name="student_ids" string="Students" readonly="1" widget="many2many_tags"/>
                                    <field name="admission_count" invisible="1"/>
                                </group>
                                <group>
                                </group>
                            </group>
                        </page>
                        <page string="Rooms">
                            <field name="room_ids" readonly="1">
                                <list>
                                    <field name="name" string="Room"/>
                                    <field name="floor_id"/>
                                </list>
                            </field>
                        </page>
                        <page id="assets" string="Assets">
                            <field name="asset_ids">
                                <list editable="bottom">
                                    <field name="name" required="1"/>
                                    <field name="room_id" options="{'no_create': true, 'no_edit': true}"/>
                                    <field name="product_id" required="1" options="{'no_create': true, 'no_edit': true}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="xe_hostel_kanban_view" model="ir.ui.view">
        <field name="name">xe.hostel.kanban.view</field>
        <field name="model">xe.hostel</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <!-- <field name="name"/>
                <field name="code"/> -->
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="code"/>
                                        </strong>
                                    </div>
                                </div>
                                <ul>
                                    <li class="o_text_overflow">
                                        <field name="warden_id"/>
                                    </li>
                                    <br></br>
                                    <li class="o_text_overflow">
                                        <b>Students:</b> <field name="admission_count"/>
                                    </li>
                                    <br></br>
                                    <li class="o_text_overflow">
                                        <b>Vacancy:</b> <field name="vacancy"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hostel" model="ir.actions.act_window">
        <field name="name">Hostel</field>
        <field name="res_model">xe.hostel</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>