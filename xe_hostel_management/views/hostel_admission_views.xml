<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="xe_hostel_admission_tree_view" model="ir.ui.view">
        <field name="name">xe.hostel.admission.tree.view</field>
        <field name="model">xe.hostel.admission</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="number" string="Admission / Employee Number"/>
                <field name="member_type" string="Member Type"/>
                <field name="hostel_id" string="Hostel"/>
                <field name="room_id" string="Room"/>
                <field name="bed_id" string="Bed"/>
                <field name="vacated_date" string="Vacated Date"/>
                <field name="state" string="Status" widget="badge" decoration-success="state == 'allocated'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'vacated'"/>
            </list>
        </field>
    </record>

    <record id="xe_hostel_admission_form_view" model="ir.ui.view">
        <field name="name">xe.hostel.admission.form.view</field>
        <field name="model">xe.hostel.admission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="button_allocate" string="Allocate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="button_vacate" string="Vacate" type="object" invisible="state != 'allocated'"/>
                    <button name="button_reallocate" string="Reallocate" type="object" invisible="state != 'vacated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,allocated,vacated"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" readonly="1"
                           options="{&quot;zoom&quot;: true, &quot;preview_image&quot;:&quot;image&quot;}"
                           force_save="True"/>
                    <div class="oe_title mb24">
                        <field name="member_type" widget="radio" options="{'horizontal': true}"/>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" string="Admission Number" domain="[('is_hostel_facility', '=', True)]" options="{'no_create': true, 'no_edit': true}" invisible="member_type == 'is_faculty'" required="member_type == 'is_student'" context="{'show_roll_number': True}"/>
                            <field name="employee_id" string="Faculty" options="{'no_create': true, 'no_edit': true}" invisible="member_type == 'is_student'" required="member_type == 'is_faculty'"/>
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                            </div>
                        </group>
                        <group>
                            <field name="gender"/>
                            <field name="dob" string="Date of Birth"/>
                            <field name="phone" class="o_force_ltr"/>
                            <field name="mobile" class="o_force_ltr"/>
                            <field name="email"/>
                            <field name="number" invisible="1"/>
                            <field name="hostel_id" invisible="1" force_save="1"/>
                            <field name="bed_id" invisible="1" force_save="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allotment Details">
                            <field name="room_member_ids">
                                <list editable="bottom">
                                    <field name="hostel_id" options="{'no_create': true, 'no_edit': true}" required="1"/>
                                    <field name="room_id" options="{'no_create': true, 'no_edit': true}" domain="[('hostel_id','=', hostel_id)]"/>
                                    <field name="bed_id" options="{'no_create': true, 'no_edit': true}" domain="[('room_id','=', room_id)]"/>
                                    <field name="allocated_date"/>
                                    <field name="vacated_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="xe_hostel_admission_kanban_view" model="ir.ui.view">
        <field name="name">xe.hostel.admission.kanban.view</field>
        <field name="model">xe.hostel.admission</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <field name="image" widget="image" class="o_kanban_image_fill_left"
                                   options="{'zoom': true, 'zoom_delay': 1000, 'background': true, 'preventClicks': false}"/>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="number"/>
                                        </strong>
                                    </div>
                                </div>
                                <ul>
                                    <li t-if="record.student_name">
                                        <strong><field name="student_name"/></strong>
                                    </li>
                                    <li t-if="record.employee_id">
                                        <strong><field name="employee_id"/></strong>
                                    </li>
                                    <li t-if="record.email">
                                        <field name="email"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="xe_hostel_admission_search_view" model="ir.ui.view">
        <field name="name">xe.hostel.admission.search.view</field>
        <field name="model">xe.hostel.admission</field>
        <field name="arch" type="xml">
            <search>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="allocated" string="Allocated" domain="[('state', '=', 'allocated')]"/>
                <filter name="vacated" string="Vacated" domain="[('state', '=', 'vacated')]"/>
            </search>
        </field>
    </record>

    <record id="action_hostel_admission" model="ir.actions.act_window">
        <field name="name">Hostel Admission</field>
        <field name="res_model">xe.hostel.admission</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{"show_roll_number": True, 'search_default_allocated': 1}</field>
    </record>

</odoo>