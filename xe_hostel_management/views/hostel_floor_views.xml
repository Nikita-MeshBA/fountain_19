<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="xe_hostel_floor_tree_view" model="ir.ui.view">
        <field name="name">xe.hostel.floor.tree.view</field>
        <field name="model">xe.hostel.floor</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="floor_no" required="1"/>
                <field name="hostel_id" required="1"/>
                <field name="responsible_staff_id"/>
            </list>
        </field>
    </record>

    <record id="action_hostel_floor" model="ir.actions.act_window">
        <field name="name">Hostel</field>
        <field name="res_model">xe.hostel.floor</field>
        <field name="view_mode">list</field>
    </record>

</odoo>