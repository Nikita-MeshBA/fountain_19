<!--    </record>-->
    <record id="group_s_attendance_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_s_attendances"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_s_attendance_admin" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_s_attendances"/>
        <field name="implied_ids" eval="[(4, ref('group_s_attendance_user')), (4, ref('base.group_user'))]"/>
    </record>
