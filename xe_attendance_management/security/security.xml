    <record model="ir.rule" id="s_attendance_manager_rule">
        <field name="name">Student Attendance - Manager Rule</field>
        <field name="model_id" ref="model_xe_student_attendance"/>
        <field name="groups" eval="[(4, ref('group_s_attendance_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record model="ir.rule" id="s_attendance_user_rule">
        <field name="name">Student Attendance - User Rule</field>
        <field name="model_id" ref="model_xe_student_attendance"/>
        <field name="groups" eval="[(4, ref('group_s_attendance_user'))]"/>
        <field name="domain_force">[('attendance_register_id.allowed_teachers_ids.user_id','in',[user.id])]</field>
    </record>
    <record id="attendance_register_multi_company_rule" model="ir.rule">
        <field name="name">multi-company attendance register rule</field>
        <field name="model_id" ref="model_xe_attendance_register"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="attendance_remarks_multi_company_rule" model="ir.rule">
        <field name="name">multi-company attendance remarks type rule</field>
        <field name="model_id" ref="model_xe_remarks_type"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="attendance_details_multi_company_rule" model="ir.rule">
        <field name="name">multi-company attendance details rule</field>
        <field name="model_id" ref="model_xe_attendance_details"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="student_attendance_multi_company_rule" model="ir.rule">
        <field name="name">multi-company student attendance rule</field>
        <field name="model_id" ref="model_xe_student_attendance"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
</odoo>