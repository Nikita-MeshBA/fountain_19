        <record id="module_category_s_attendances" model="ir.module.category">
        <field name="name">Attendance Access Rights</field>
        <field name="description">Helps you to Manage Access Rights</field>
        <field name="sequence">15</field>
    </record>

    <record id="privilege_s_attendances" model="res.groups.privilege">
        <field name="name">Attendance Access Rights</field>
        <field name="category_id" ref="module_category_s_attendances"/>
    </record>

<!--    <record id="group_s_attendance_user" model="res.groups">-->
