<odoo>
    <record id="view_xe_remarks_type_tree" model="ir.ui.view">
        <field name="name">xe.remarks.type.tree</field>
        <field name="model">xe.remarks.type</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Remarks Type" editable="bottom">
                <field name="name"/>
                <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record model="ir.actions.act_window" id="remarks_type_act">
        <field name="name">Remarks Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xe.remarks.type</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem name="Configuration" id="xe_config_menu" parent="xe_attendance_menu_root"
              groups="xe_attendance_management.group_s_attendance_admin"/>
    <menuitem name="Remarks Type" id="remarks_type" parent="xe_config_menu"
              action="remarks_type_act" sequence="1"/>
</odoo>