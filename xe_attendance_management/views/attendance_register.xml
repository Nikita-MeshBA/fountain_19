<odoo>
    <record id="view_xe_attendance_register_tree" model="ir.ui.view">
        <field name="name">xe.attendance.register.tree</field>
        <field name="model">xe.attendance.register</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <tree string="Attendance Register">
                <field name="name"/>
                <field name="code"/>
                <field name="course_id"/>
                <field name="class_room_id"/>
                <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>
    <record id="view_xe_attendance_register_form" model="ir.ui.view">
        <field name="name">xe.attendance.register.form</field>
        <field name="model">xe.attendance.register</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Attendance Register">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="course_id" required="1"/>
                            <field name="allowed_teachers_ids" domain="[('teach_type', '=', 'teaching')]" required="1"
                                   widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="code" required="1"/>
                            <field name="class_room_id" domain="[('course_id','=',course_id)]" required="1"/>
                            <field name="company_id" options="{'no_create':True}"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="attendance_register_act">
        <field name="name">Attendance Registers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xe.attendance.register</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem name="Attendance Register" id="xe_attendance_register" parent="xe_attendance_menu_root"
              action="attendance_register_act" sequence="1"
              groups="xe_attendance_management.group_s_attendance_admin"/>
</odoo>