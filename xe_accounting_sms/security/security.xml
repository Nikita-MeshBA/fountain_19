<odoo>

    <record id="xe_send_sms_config_company_rule" model="ir.rule">
        <field name="name">sms config multi-company rule</field>
        <field name="model_id" ref="xe_accounting_sms.model_xe_send_sms_config"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="send_sms_template_company_rule" model="ir.rule">
        <field name="name">sms template multi-company rule</field>
        <field name="model_id" ref="xe_accounting_sms.model_send_sms_template"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

</odoo>