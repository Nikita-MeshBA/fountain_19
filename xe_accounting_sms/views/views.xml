<odoo>
    <record id="sms_alert_view_form" model="ir.ui.view">
        <field name="name">xe.send.sms.config.view.form</field>
        <field name="model">xe.send.sms.config</field>
        <field name="arch" type="xml">
            <form string="SMS Alert">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" required="1" readonly="1" force_save="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Accounting">
                            <group>
                                <group>
                                    <field name="is_invoice_validate"/>
                                    <field name="is_payment"/>
                                    <field name="is_manual_sms"/>
                                </group>
                                <group>
                                    <field name="invoice_validate_tmpl_id"
                                           invisible="is_invoice_validate == False" required="is_invoice_validate" domain="[('company_id', '=', company_id)]"/>
                                    <field name="payment_tmpl_id" invisible="is_payment == False" required="is_payment" domain="[('company_id', '=', company_id)]"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="company_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sms_alert_view_tree" model="ir.ui.view">
        <field name="name">xe.send.sms.config.tree</field>
        <field name="model">xe.send.sms.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_invoice_validate"/>
            </list>
        </field>
    </record>

    <record id="sms_alert_action" model="ir.actions.act_window">
        <field name="name">SMS Alert</field>
        <field name="res_model">xe.send.sms.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sub_menu_admin4" name="Alert" parent="xenesis_school_base.sub_menu_admin"
              groups="xenesis_school_base.group_xe_admin" sequence="4"/>
    <menuitem id="sms_alert_menu" name="SMS Alert" parent="sub_menu_admin4"
              action="xe_accounting_sms.sms_alert_action" sequence="40"/>
    <menuitem id="send_sms_template_menu" name="SMS Templates" parent="sub_menu_admin4"
              action="xe_accounting_sms.send_sms_template_action" sequence="39"/>
</odoo>