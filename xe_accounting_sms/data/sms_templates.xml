<?xml version="1.0"?>
<odoo>
    <data>
        <record id="send_sms_template_data_invoice_validate" model="send.sms.template">
            <field name="name">Invoice Validate</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="msg_to">${object.partner_id.get_mobile_numbers() or ''}</field>
            <field name="template_body"><![CDATA[
                Dear ${object.partner_id.name}
                Here is invoice number ${object.name} with amount ${object.amount_total}
               ]]>
            </field>
        </record>
    </data>
</odoo>
