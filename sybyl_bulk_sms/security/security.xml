<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bulk_sms" model="ir.module.category">
        <field name="name">Bulk SMS</field>
        <field name="description">Helps you to Manage Access Rights</field>
        <field name="sequence">19</field>
    </record>

    <!-- Odoo 19: Define a privilege for the Bulk SMS category -->
    <record id="privilege_bulk_sms" model="res.groups.privilege">
        <field name="name">Bulk SMS Access Rights</field>
        <field name="category_id" ref="module_category_bulk_sms"/>
    </record>

    <record id="group_bulk_sms_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_bulk_sms"/>
        <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bulk_sms_admin" model="res.groups">
        <field name="name">SMS Admin</field>
        <field name="privilege_id" ref="privilege_bulk_sms"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_ids"
               eval="[(4, ref('group_bulk_sms_user')), (4, ref('base.group_user'))]"/>
    </record>
    <record id="mobile_property_company_rule" model="ir.rule">
        <field name="name">sms mobile property multi-company rule</field>
        <field name="model_id" ref="sybyl_bulk_sms.model_mobile_property_config"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="message_property_company_rule" model="ir.rule">
        <field name="name">sms message property multi-company rule</field>
        <field name="model_id" ref="sybyl_bulk_sms.model_message_property_config"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="sms_gateway_config_company_rule" model="ir.rule">
        <field name="name">sms gateway config multi-company rule</field>
        <field name="model_id" ref="sybyl_bulk_sms.model_sms_gateway_config"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="sms_gateway_config_company_rule" model="ir.rule">
        <field name="name">sms gateway config multi-company rule</field>
        <field name="model_id" ref="sybyl_bulk_sms.model_sms_gateway_config"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="sms_gateway_attributes_company_rule" model="ir.rule">
        <field name="name">sms gateway attributes multi-company rule</field>
        <field name="model_id" ref="sybyl_bulk_sms.model_sms_gateway_attributes"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="sms_header_attributes_company_rule" model="ir.rule">
        <field name="name">sms header attributes multi-company rule</field>
        <field name="model_id" ref="sybyl_bulk_sms.model_sms_header_attributes"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="bulk_sms_send_log_company_rule" model="ir.rule">
        <field name="name">bulk sms send log multi-company rule</field>
        <field name="model_id" ref="sybyl_bulk_sms.model_bulk_sms_send_log"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
