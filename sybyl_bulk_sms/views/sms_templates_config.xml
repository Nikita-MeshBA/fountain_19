<odoo>
    <record id="mobile_property_config_tree" model="ir.ui.view">
        <field name="name">mobile.property.config.tree</field>
        <field name="model">mobile.property.config</field>
        <field name="arch" type="xml">
            <list string="Property Name of Mobile" editable="top">
                <field name="name" required="1"/>
                <field name="company_id" required="1" options="{'no_create': True}" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="message_property_config_tree" model="ir.ui.view">
        <field name="name">message.property.config.tree</field>
        <field name="model">message.property.config</field>
        <field name="arch" type="xml">
            <list string="Property Name of Message" editable="top">
                <field name="name" required="1"/>
                <field name="company_id" required="1" options="{'no_create': True}" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="mobile_property_action" model="ir.actions.act_window">
        <field name="name">Mobile Property Name</field>
        <field name="res_model">mobile.property.config</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="message_property_action" model="ir.actions.act_window">
        <field name="name">Message Property Name</field>
        <field name="res_model">message.property.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="bulk_sms_config_menu"
              name="Configurations"
              parent="sybyl_bulk_sms_parent_menu"
              groups="group_bulk_sms_admin"
              sequence="90"/>
    <menuitem id="mobile_property_menu"
              name="Mobile Property Names"
              parent="bulk_sms_config_menu"
              action="mobile_property_action"
              groups="group_bulk_sms_admin"
              sequence="1"/>
    <menuitem id="message_property_menu"
              name="Message Property Names"
              parent="bulk_sms_config_menu"
              action="message_property_action"
              groups="group_bulk_sms_admin"
              sequence="2"/>
</odoo>