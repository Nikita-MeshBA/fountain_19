<odoo>
    <record id="xe_rubric_view_form" model="ir.ui.view">
        <field name="name">xe.rubric.form.view</field>
        <field name="model">xe.rubric</field>
        <field name="arch" type="xml">
            <form string="School">
                <sheet>
                    <group string="Rubric Info">
                        <group>
                            <field name="code"/>
                            <field name="substrand_id" required="1"/>
                            <field name="subject_id" invisible="1"/>
                            <field name='activity'/>
                            <field name="subject_from" string="Subject From" widget="radio"
                                   options="{'horizontal': true}" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="xe_rubric_view_tree" model="ir.ui.view">
        <field name="name">xe.rubric.tree.view</field>
        <field name="model">xe.rubric</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" string="Rubric ID" required="1"/>
                <field name="name" string="Rubric Name" required="1"/>
                <field name="strand_id" string="Strand"/>
                <field name="theme_id" string="Theme"/>
                <field name="activity" string="Activity" optional="show"/>
                <field name="subject_id" string="Subject" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_xe_rubric" model="ir.actions.act_window">
        <field name="name">Rubric</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xe.rubric</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Rubric Record
            </p>
        </field>
    </record>
</odoo>