<odoo>
    <record model="ir.ui.view" id="progress_book_tree_view">
        <field name="name">xe.progress.book.tree.view</field>
        <field name="model">xe.progress.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="roll_number"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="classroom_id"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="progress_book_form_view">
        <field name="name">xe.progress.book.form.view</field>
        <field name="model">xe.progress.book</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{&quot;zoom&quot;: true, &quot;preview_image&quot;:&quot;image_1920&quot;}"
                           force_save="True"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="course_id" required="1"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="classroom_id" required="1"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="student_id" required="1"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="roll_number" force_save="1"/>
                            <field name="academic_year_id" force_save="1"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="progress_book_line_ids" widget="section_and_note_one2many">
                                <list editable="bottom">
                                    <control>
                                        <create name="add_section_control" string="Add a header"
                                                context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a sub header"
                                                context="{'default_display_type': 'line_note'}"/>
                                        <create name="add_product_control" string="Add a content"/>
                                    </control>
                                    <field name="display_type" invisible="1"/>
                                    <field name="name" required="1"/>
                                    <field name="name" widget="section_and_note_text" optional="show"/>
                                    <field name="types"/>
                                    <field name="comments"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="progress_book_search_view" model="ir.ui.view">
        <field name="name">progress.book.search.view</field>
        <field name="model">xe.progress.book</field>
        <field name="arch" type="xml">
            <search>
                <group expand="0">
                    <filter string="Course" name="course_id" context="{'group_by': 'course_id'}"/>
                    <filter string="Classroom" name="classroom_id" context="{'group_by': 'classroom_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_progress_book">
        <field name="name">Progress Book</field>
        <field name="res_model">xe.progress.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_root_progress_book" name="Progress Book" parent="xenesis_school_base.menu_administration_root"/>
    <menuitem id="menu_progress_book" name="Progress Book" parent="menu_root_progress_book"
              action="action_progress_book"/>
</odoo>