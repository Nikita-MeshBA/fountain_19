<odoo>
    <record id="xe_strand_view_form" model="ir.ui.view">
        <field name="name">xe.strand.form.view</field>
        <field name="model">xe.strand</field>
        <field name="arch" type="xml">
            <form string="School">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="code"/>
                            <field name="theme_id"/>
                            <field name="subject_id" string="Subject"/>
                        </group>
                    </group>
                    <notebook position="inside">
                        <page string="Substrands">
                            <list editable="top">
                                <field name="substrand_ids"/>
                            </list>
                        </page>
                        <page string="Students">
                            <list editable="top">
                                <field name="student_ids" multi_edit="1"/>
                            </list>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="xe_strand_view_tree" model="ir.ui.view">
        <field name="name">xe.strand.tree.view</field>
        <field name="model">xe.strand</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" string="ID"/>
                <field name="name" string="Strand Name"/>
                <field name="theme_id" string="Theme"/>
                <field name="subject_id" string="Subject"/>
            </list>
        </field>
    </record>
    <record id="action_xe_strand" model="ir.actions.act_window">
        <field name="name">Strand</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xe.strand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Strand Record
            </p>
        </field>
    </record>
</odoo>