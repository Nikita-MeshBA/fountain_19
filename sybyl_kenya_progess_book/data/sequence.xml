<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_progress_book" model="ir.sequence">
        <field name="name">Progress Book</field>
        <field name="code">xe.progress.book</field>
        <field name="prefix">PB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_marking" model="ir.sequence">
        <field name="name">Marking Sequence</field>
        <field name="code">xe.marking</field>
        <field name="prefix">MR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>