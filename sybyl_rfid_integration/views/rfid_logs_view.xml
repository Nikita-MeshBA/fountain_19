<odoo>

    <record id="rfid_log_list_view" model="ir.ui.view">
        <field name="name">RFID Logs</field>
        <field name="model">rfid.logs</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="device_serial_number"/>
                <field name="badge_number"/>
                <field name="card_number"/>
                <field name="date" />
            </list>
        </field>
    </record>

    <record id="rfid_log_action" model="ir.actions.act_window">
        <field name="name">RFID Log</field>
        <field name="res_model">rfid.logs</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="rfid_log_list_view"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Logs is not found
          </p><p>
          </p>
        </field>
        <field name="context">{}</field>
    </record>
</odoo>