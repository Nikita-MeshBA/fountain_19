<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.java.setup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id='contacts_settings' position="after">

                <h2>RFID Configuration</h2>
                <div class="row mt16 o_settings_container" name="rfid_integration">
                    <div class="col-xs-12 col-md-12 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <!-- <label string="Java Configuration" for="jar_file_path"/>
                            <div class="text-muted">
                                RFID Configuraion
                            </div> -->
                            <div id="model_sma">
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="databse_url" string="Databse Url" class="col-xs-3 col-md-3 o_light_label"/>
                                        <field name="databse_url" nolabel="1"/>
                                    </div>
                                    <div class="mt16 row">
                                        <label for="databse_port" string="Databse Port" class="col-xs-3 col-md-3 o_light_label"/>
                                        <field name="databse_port" nolabel="1"/>
                                    </div>
                                    <div class="mt16 row">
                                        <label for="authorization_value" string="Authorization Value" class="col-xs-3 col-md-3 o_light_label"/>
                                        <field name="authorization_value" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </field>
    </record>
</odoo>