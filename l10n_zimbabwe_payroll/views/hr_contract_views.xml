<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_trcs" model="ir.ui.view">
        <field name="name">hr.version.form.zimbabwe.payroll</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='salary_info']" position="after">
                <group string="Zimbabwe Payroll" name="zimbabwe_payroll">
                    <group string="Monthly Reliefs in Cash"
                           name="salary_and_relief_zimbabwe">
                        <field name="age" readonly="1"/>
                        <field name="communication"/>
                        <field name="house_allowance"/>
                        <field name="transport_allowance"/>
                        <field name="bonus"/>
                    </group>

                    <group string="Monthly Deductions in Cash"
                           name="salary_and_deductions_zimbabwe">
                        <field name="medical_aid"/>
                        <field name="nsa"/>
                        <field name="loan"/>
                        <field name="schoolfees_deduction"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
