<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_xe_route_line_tree" model="ir.ui.view">
            <field name="name">xe.route.line.tree</field>
            <field name="model">xe.route.line</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <list string="Routes">
                    <field name="route_id" />
                    <field name="name" />
                    <field name="route_date" />
                </list>
            </field>
        </record>
        <record id="view_xe_route_line_form" model="ir.ui.view">
            <field name="name">xe.route.line.form</field>
            <field name="model">xe.route.line</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <form string="Routes">
                    <header>
                        <button type="object" name="start_trip" invisible="state not in ['draft']" string="Start Trip" class="oe_highlight"/>
                        <button type="object" name="end_trip" invisible="state not in ['start']" string="End Trip" class="oe_highlight"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,start,end" />
                    </header>
                    <sheet>
                        <group col="4">
                            <field name="name" />
                            <field name="route_id" />
                            <field name="route_type" />
                            <field name="start_time" />
                            <field name="route_date" />
                            <field name="driver_id" />
                            <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                        </group>
                        <notebook>
                            <page string="Stops">
                                <group>
                                    <button type="object" name="create_route_stop_line" string="Get Stops" />
                                </group>
                                <group>
                                    <field name="route_stop_ids" nolabel="1">
                                        <list>
                                            <field name="sequence"  />
                                            <field name="stop_id" />
                                            <field name="estimated_time" widget="float_time"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Passengers">
                                <field name="route_passenger_ids"  nolabel="1">
                                    <list editable="top">
                                        <field name="partner_id" />
                                        <field name="present" />
                                        <field name="stop_id" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="view_xe_route_line_search" model="ir.ui.view">
            <field name="name">xe.route.line.search</field>
            <field name="model">xe.route.line</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <search string="Routes">
                    <field name="name" />
                    <field name="route_id" />
                    <field name="route_date" />
                    <newline />
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="act_open_xe_route_line_view">
            <field name="name">Trips</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">xe.route.line</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_xe_route_line_search" />
        </record>
        <record model="ir.actions.act_window.view" id="act_open_xe_route_line_view_form">
            <field name="act_window_id" ref="act_open_xe_route_line_view" />
            <field name="sequence" eval="20" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_xe_route_line_form" />
        </record>
        <record model="ir.actions.act_window.view" id="act_open_xe_route_line_view_tree">
            <field name="act_window_id" ref="act_open_xe_route_line_view" />
            <field name="sequence" eval="10" />
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_xe_route_line_tree" />
        </record>
    </data>
</odoo>
