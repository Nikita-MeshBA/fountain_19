<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_xe_route_stop_line_tree" model="ir.ui.view">
            <field name="name">xe.route.stop.line.tree</field>
            <field name="model">xe.route.stop.line</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <list string="Routes">
                    <field name="sequence" />
                    <field name="route_line_id" />
                    <field name="stop_id" />
                </list>
            </field>
        </record>
        <record id="view_xe_route_stop_line_form" model="ir.ui.view">
            <field name="name">xe.route.stop.line.form</field>
            <field name="model">xe.route.stop.line</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <form string="Routes">
                    <sheet>
                        <group col="4">
                            <field name="route_line_id" required="1" />
                            <field name="stop_id" required="1" />
                            <field name="estimated_time" widget="float_time" readonly="1" />
                            <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
