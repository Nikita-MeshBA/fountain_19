        <record id="view_xe_route_stop_line_search" model="ir.ui.view">
    <field name="name">xe.route.stop.line.search</field>
    <field name="model">xe.route.stop.line</field>
    <field name="priority" eval="8"/>
    <field name="arch" type="xml">
        <search string="Routes">
            <field name="route_line_id"/>
            <field name="stop_id"/>
        </search>
    </field>
</record>
        <record model="ir.actions.act_window" id="act_open_xe_route_stop_line_view">
            <field name="name">Routes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">xe.route.stop.line</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_xe_route_stop_line_search" />
        </record>
        <record model="ir.actions.act_window.view" id="act_open_xe_route_stop_line_view_form">
            <field name="act_window_id" ref="act_open_xe_route_stop_line_view" />
            <field name="sequence" eval="20" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_xe_route_stop_line_form" />
        </record>
        <record model="ir.actions.act_window.view" id="act_open_xe_route_stop_line_view_tree">
            <field name="act_window_id" ref="act_open_xe_route_stop_line_view" />
            <field name="sequence" eval="10" />
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_xe_route_stop_line_tree" />
        </record>
    </data>
</odoo>
