<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Transportation Module Category -->
        <record id="module_category_xenesis_transportation" model="ir.module.category">
            <field name="name">Xenesis Transportation</field>
            <field name="description">Helps you manage user related to transportation.</field>
            <field name="sequence">25</field>
        </record>

        <!-- Odoo 19: Groups Privilege -->
        <record id="privilege_xe_transportation" model="res.groups.privilege">
            <field name="name">Transportation</field>
            <field name="category_id" ref="module_category_xenesis_transportation"/>
        </record>

        <!-- Transportation User Group -->
        <record id="group_xe_transport_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_xe_transportation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('fleet.fleet_group_user'))]"/>
        </record>

        <!-- Transportation Manager Group -->
        <record id="group_xe_transport_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_xe_transportation"/>
            <field name="implied_ids" eval="[(4, ref('group_xe_transport_user')), (4, ref('fleet.fleet_group_manager'))]"/>
        </record>

        <!-- Multi-Company Rules -->
        <record model="ir.rule" id="stop_multi_comp_rule">
            <field name="name">Stop multi-company</field>
            <field name="model_id" ref="xe_transportation_management.model_xe_stop"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record model="ir.rule" id="transportation_multi_comp_rule">
            <field name="name">Transportation multi-company</field>
            <field name="model_id" ref="xe_transportation_management.model_xe_route"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record model="ir.rule" id="route_line_multi_comp_rule">
            <field name="name">Route Line multi-company</field>
            <field name="model_id" ref="xe_transportation_management.model_xe_route_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record model="ir.rule" id="route_passenger_multi_comp_rule">
            <field name="name">Route Passenger multi-company</field>
            <field name="model_id" ref="xe_transportation_management.model_xe_route_passenger"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record model="ir.rule" id="stop_line_multi_comp_rule">
            <field name="name">Stop Line multi-company</field>
            <field name="model_id" ref="xe_transportation_management.model_xe_route_stop_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
