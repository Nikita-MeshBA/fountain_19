<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.rule" id="subject_register_stud_user_rule">
        <field name="name">Subject Registration Student - User Rule</field>
        <field name="model_id" ref="model_xe_subject_registration"/>
        <field name="groups" eval="[(4, ref('xenesis_school_base.group_xe_student'))]"/>
        <field name="domain_force">[('create_user_id','in',[user.id])]</field>
    </record>
    <record model="ir.rule" id="subject_register_admin_user_rule">
        <field name="name">Subject Registration Admin Rule</field>
        <field name="model_id" ref="model_xe_subject_registration"/>
        <field name="groups" eval="[(4, ref('xenesis_school_base.group_xe_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>
</odoo>