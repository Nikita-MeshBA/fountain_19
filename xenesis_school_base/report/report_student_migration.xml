<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_studentmigration">
        <style>.font{
            font-size:14px;
            font-family:"Helvetica"
            }
            @page{
            margin-top:1%;
            size: A4;
            }
        </style>
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="font">
                    <center>
                        <h2>Student Migration Details</h2>
                    </center>
                    <br/>
                    <div class="col-sm-12">
                        <table width="100%;">
                            <tr style="padding:5px;">
                                <th width="25%;">
                                    From Date:
                                </th>
                                <th width="25%;">
                                    <span t-esc="date_from"/>
                                </th>
                                <th width="25%;">
                                    To Date:
                                </th>
                                <th width="25%;">
                                    <span t-esc="date_to"/>
                                </th>
                            </tr>
                            <tr style="padding:5px;">
                                <th width="25%;" t-if="'Term' in variant_header">
                                    Term:
                                </th>
                                <th width="25%;" t-if="'Class' in variant_header">
                                    Class:
                                </th>
                                <th width="25%;" t-if="'Student' in variant_header">
                                    Student:
                                </th>
                                <th width="25%;">
                                    <span t-esc="variant_value"/>
                                </th>
                            </tr>
                        </table>
                    </div>
                    <br/>

                    <table>
                        <tbody>
                            <tr>
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>
                                                <span>Roll Number</span>
                                            </th>
                                            <th>
                                                <span>Student</span>
                                            </th>
                                            <th>
                                                <span>From Class</span>
                                            </th>
                                            <th>
                                                <span>To Class</span>
                                            </th>
                                            <th>
                                                <span>From Term</span>
                                            </th>
                                            <th>
                                                <span>To Term</span>
                                            </th>
                                            <th>
                                                <span>User</span>
                                            </th>
                                            <th>
                                                <span>Remarks</span>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="get_details" t-as="detail">
                                            <td width="10%">
                                                <span t-esc="detail['date']"/>
                                            </td>
                                            <td width="10%">
                                                <span t-esc="detail['roll_number']"/>
                                            </td>
                                            <td width="10%">
                                                <span t-esc="detail['student']"/>
                                            </td>
                                            <td width="10%">
                                                <span t-esc="detail['from_course']"/>
                                            </td>
                                            <td width="10%">
                                                <span t-esc="detail['to_course']"/>
                                            </td>
                                            <td width="10%">
                                                <span t-esc="detail['from_term']"/>
                                            </td>
                                            <td width="10%">
                                                <span t-esc="detail['to_term']"/>
                                            </td>
                                            <td width="10%">
                                                <span t-esc="detail['user']"/>
                                            </td>
                                            <td width="10%">
                                                <span t-esc="detail['remarks']"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <p style="page-break-after: always;"/>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </t>
        </t>
    </template>
</odoo>


