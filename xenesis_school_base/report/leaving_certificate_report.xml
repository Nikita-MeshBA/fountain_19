<odoo>
    <template id="leave_certificate_external_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout {{  'o_layout_background' if company.layout_background in ['Geometric', 'Custom']  else  '' }}"
             t-attf-style="background-image: url({{ 'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/bg_background_template.jpg' if company.layout_background == 'Geometric' else ''}});"
             t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <div class="pt-5">
                <!-- This div ensures that the address is not cropped by the header. -->
                <t t-call="web.address_layout"/>
            </div>
            <t t-out="0"/>
        </div>
        <div t-attf-class="o_company_#{company.id}_layout footer o_background_footer">
            <div class="text-center">
                This certificate is issued without an erasure or alteration whatsoever
            </div>
        </div>
    </template>
    <template id="report_leaving_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="xenesis_school_base.leave_certificate_external_layout">
                    <div class="page">
                        <t t-set="company" t-value="o.student_id.company_id.sudo()"/>
                        <div t-att-style="report_header_style" style="padding-bottom:10px;">
                            <div class="row">
                                <div class="col-3 mb4">
                                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                         style="max-height: 45px;" alt="Logo"/>
                                </div>
                                <div class="col-6" name="company_address">
                                    <center>
                                        <span t-if="company.company_details" t-field="company.company_details"/>
                                    </center>

                                </div>
                                <div class="col-3 text-right" style="margin-top:22px;" t-field="company.report_header"
                                     name="moto"/>
                            </div>
                            <div t-if="company.logo or company.report_header" class="row zero_min_height">
                                <div class="col-12">
                                    <div style="border-bottom: 1px solid black;"/>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <br/>
                        <div>
                            <h2>
                                <center>SCHOOL LEAVING CERTIFICATE</center>
                            </h2>
                            <br/>
                        </div>
                        <p>
                            <strong>ADMISSION NO:
                                <span t-esc="o.roll_number"/>
                            </strong>
                        </p>
                        <div>
                            <table class="table table-condensed table-borderless">
                                <tr t-foreach="attribute_lines_ids" t-as="line">
                                    <td>
                                        <strong>
                                            <span t-esc="line.attribute_id.name"/>
                                        </strong>
                                    </td>
                                    <td>
                                        <span t-esc="line.value"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:30%;">Pupil’s Signature:</td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td>Date of Issue:</td>
                                    <td>
                                        <span t-esc="current_date"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td>
                                        Signed:
                                        <br/>
                                        <!--                                        <img t-if="o.company_id.signature" t-att-src="image_data_uri(o.company_id.signature)"/><br/>-->

                                        <strong>(PRINCIPAL)</strong>
                                    </td>
                                </tr>

                            </table>
                        </div>
                        <br/>
                        <br/>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="leaving_certificate_paperformat" model="report.paperformat">
        <field name="name">Leaving Certificate Letter</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_leaving_certificate_report" model="ir.actions.report">
        <field name="name">Leaving Certificate</field>
        <field name="model">xe.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">xenesis_school_base.report_leaving_certificate</field>
        <field name="report_file">xenesis_school_base.leaving_certificate_report</field>
        <field name="print_report_name">'School Leaving Certificate'</field>
        <field name="paperformat_id" ref="leaving_certificate_paperformat"/>
    </record>

</odoo>