<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_xe_school" model="ir.module.category">
            <field name="name">School</field>
            <field name="description">Helps you to Manage Access Rights</field>
            <field name="sequence">15</field>
        </record>
        <record id="group_xe_student" model="res.groups">
            <field name="name">Student</field>
<!--            <field name="category_id" ref="module_category_xe_school"/>-->
<!--            <field name="users" eval="[(4, ref('base.user_root'))]"/>-->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_xe_parent" model="res.groups">
            <field name="name">Parent</field>
<!--            <field name="category_id" ref="module_category_xe_school"/>-->
<!--            <field name="users" eval="[(4, ref('base.user_root'))]"/>-->
            <field name="implied_ids"
                   eval="[(4, ref('xenesis_school_base.group_xe_student')), (4, ref('base.group_user'))]"/>
        </record>

        <record id="group_xe_staff" model="res.groups">
            <field name="name">Teacher</field>
<!--            <field name="category_id" ref="module_category_xe_school"/>-->
<!--            <field name="users" eval="[(4, ref('base.user_root'))]"/>-->
            <field name="implied_ids"
                   eval="[(4, ref('xenesis_school_base.group_xe_student')), (4, ref('base.group_user')),(4, ref('xenesis_school_base.group_xe_parent'))]"/>
        </record>

        <record id="group_xe_admin" model="res.groups">
            <field name="name">Admin</field>
<!--            <field name="category_id" ref="module_category_xe_school"/>-->
<!--            <field name="users" eval="[(4, ref('base.user_root'))]"/>-->
            <field name="implied_ids"
                   eval="[(4, ref('xenesis_school_base.group_xe_staff')),(4, ref('xenesis_school_base.group_xe_parent')), (4, ref('base.group_user'))]"/>
<!--            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>-->
        </record>

        <record id="group_xe_health_details" model="res.groups">
            <field name="name">Student Health Details</field>
<!--            <field name="users" eval="[(4, ref('base.user_root'))]"/>-->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record Rule for student object-->
        <record model="ir.rule" id="student_rule">
            <field name="name">Student Rule</field>
            <field name="model_id" ref="model_xe_student"/>
            <field name="groups" eval="[(4, ref('xenesis_school_base.group_xe_student'))]"/>
            <field name="domain_force">
                ['|',('user_id','=',user.id),('parent_ids.student_user_ids.user_id','in',[user.id])]
            </field>
        </record>
        <record model="ir.rule" id="student_parent_rule">
            <field name="name">Parent login rule for Student</field>
            <field name="model_id" ref="model_xe_student"/>
            <field name="groups" eval="[(4, ref('xenesis_school_base.group_xe_parent'))]"/>
            <field name="domain_force">[('parent_ids.user_id','in',[user.id])]</field>
        </record>
        <record model="ir.rule" id="view_student_teacher_rule">
            <field name="name">Teacher Login rule for Student</field>
            <field name="model_id" ref="model_xe_student"/>
            <field name="groups" eval="[(4, ref('xenesis_school_base.group_xe_staff'))]"/>
            <field name="domain_force">['|',('course_id','in',user.employee_ids.subjects_ids.mapped('course_id.id')),
                ('course_id','=',False),'|',('classroom_id','in',user.employee_ids.subjects_ids.mapped('classroom_ids.id')),('classroom_id','=',False)]
            </field>
        </record>
        <record model="ir.rule" id="view_student_admin_rule">
            <field name="name">Admin Login rule for Student</field>
            <field name="model_id" ref="model_xe_student"/>
            <field name="groups" eval="[(4, ref('xenesis_school_base.group_xe_admin'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>


        <!-- Record Rule for parent object-->
        <record model="ir.rule" id="view_parent_rule_student">
            <field name="name">Parent Rule for Student</field>
            <field name="model_id" ref="model_xe_parent"/>
            <field name="groups" eval="[(4, ref('xenesis_school_base.group_xe_student'))]"/>
            <field name="domain_force">[('student_detail_ids.student_id.user_id','=',user.id)]</field>
            <field name="active">False</field>
        </record>

        <record model="ir.rule" id="view_parent_rule_staff">
            <field name="name">Parent view Rule Staff</field>
            <field name="model_id" ref="model_xe_parent"/>
            <field name="groups" eval="[(4, ref('xenesis_school_base.group_xe_staff'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <record model="ir.rule" id="view_parent_rule_parent">
            <field name="name">Parent login for Parent</field>
            <field name="model_id" ref="model_xe_parent"/>
            <field name="groups" eval="[(4, ref('xenesis_school_base.group_xe_parent'))]"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
        </record>

        <record id="group_account_officer" model="res.groups">
            <field name="name">Accounting Officer</field>
<!--            <field name="category_id" ref="base.module_category_accounting_accounting"/>-->
            <field name="implied_ids"
                   eval="[(4, ref('account.group_account_invoice')),(4, ref('xenesis_school_base.group_xe_admin'))]"/>
        </record>
        <record id="group_student_balance_readonly" model="res.groups">
            <field name="name">Balance on Student Profile</field>
<!--            <field name="category_id" ref="base.module_category_usability"/>-->
            <field name="implied_ids" eval="[(4, ref('xenesis_school_base.group_xe_student'))]"/>
        </record>
        <record id="group_popup_disable" model="res.groups">
            <field name="name">Disable Many2one Popup Parent</field>
            <field name="implied_ids" eval="[(4, ref('xenesis_school_base.group_xe_parent'))]"/>
        </record>
        <record id="group_popup_disable_stud" model="res.groups">
            <field name="name">Disable Many2one Popup Student</field>
            <field name="implied_ids" eval="[(4, ref('xenesis_school_base.group_xe_student'))]"/>
        </record>
        <record id="group_hide_action" model="res.groups">
            <field name="name">Hide Action Menu</field>
            <field name="implied_ids" eval="[(4, ref('xenesis_school_base.group_xe_student'))]"/>
        </record>
<!--        <record id="hr.menu_hr_root" model="ir.ui.menu">-->
<!--            <field name="groups_id" eval="[(3,ref('base.group_user'))]"/>-->
<!--        </record>-->
<!--        <record id="hr_holidays.menu_hr_holidays_root" model="ir.ui.menu">-->
<!--            <field name="groups_id" eval="[(3,ref('base.group_user'))]"/>-->
<!--        </record>-->


    </data>
</odoo>
