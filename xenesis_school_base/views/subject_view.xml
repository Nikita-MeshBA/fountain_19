<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subject_tree" model="ir.ui.view">
        <field name="name">xe.subject.tree</field>
        <field name="model">xe.subject</field>
        <field name="arch" type="xml">
            <list string="Subject">
                <field name="name"/>
                <field name="code"/>
                <field name="subject_mode" column_invisible="1"/>
                <field name="course_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_subject_search" model="ir.ui.view">
        <field name="name">subject.search</field>
        <field name="model">xe.subject</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Subject">
                <field name="name"/>
                <field name="code"/>
                <newline/>
            </search>
        </field>
    </record>
    <record id="view_subject_form" model="ir.ui.view">
        <field name="name">xe.subject.form</field>
        <field name="model">xe.subject</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="code" required="1"/>
                            <field name="subject_mode" string="Elective" required="1" widget="radio"/>
                            <field name="course_ids" string="Class" required="1" widget="many2many_tags"/>
                        </group>
                        <field name="description" placeholder="Insert Description" required="0"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="act_subject" model="ir.actions.act_window">
        <field name="name">Subject</field>
        <field name="res_model">xe.subject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subject_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Subject
            </p>
        </field>
    </record>

    <record id="view_assignsubject_tree" model="ir.ui.view">
        <field name="name">xe.assignsubject.tree</field>
        <field name="model">xe.assignsubject</field>
        <field name="arch" type="xml">
            <list string="Assign Subject">
                <field name="course_id" string="Class"/>
                <field name="classroom_ids" domain="[('course_id', '=', course_id)]" widget="many2many_tags"/>
                <field name="subject_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_assignsubject_search" model="ir.ui.view">
        <field name="name">xe.assignsubject.search</field>
        <field name="model">xe.assignsubject</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Assign Subject">
                <field name="course_id"/>
                <field name="term_id"/>
                <newline/>
            </search>
        </field>
    </record>
    <record id="view_assignsubject_form" model="ir.ui.view">
        <field name="name">xe.assignsubject.form</field>
        <field name="model">xe.assignsubject</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Assign Subject">
                <header>
                    <button name="action_assign"
                            string="Assign" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="course_id" required="1" readonly="state != 'draft'"/>
                            <field name="term_id" required="1" readonly="state != 'draft'"
                                   domain="[('course_id', '=', course_id)]"/>
                        </group>
                        <group>
                        </group>
                        <separator string="Subjects"/>
                        <field name="subject_ids" nolabel="1"
                               readonly="state != 'draft'"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="act_assignsubject" model="ir.actions.act_window">
        <field name="name">Assign Subject</field>
        <field name="res_model">xe.assignsubject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assignsubject_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Assign Subject
            </p>
        </field>
    </record>

    <record id="view_electivesubject_tree" model="ir.ui.view">
        <field name="name">xe.electivesubject.tree</field>
        <field name="model">xe.electivesubject</field>
        <field name="arch" type="xml">
            <list string="Elective Subject">
                <field name="course_id"/>
                <field name="term_id"/>
                <field name="subject_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_electivesubject_search" model="ir.ui.view">
        <field name="name">xe.electivesubject.search</field>
        <field name="model">xe.electivesubject</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Elective Subject">
                <field name="course_id"/>
                <field name="term_id"/>
                <field name="subject_id"/>
                <newline/>
            </search>
        </field>
    </record>
    <record id="view_electivesubject_form" model="ir.ui.view">
        <field name="name">xe.electivesubject.form</field>
        <field name="model">xe.electivesubject</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Elective Subject">
                <header>
                    <button name="action_assign"
                            string="Assign" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="course_id" required="1" readonly="state != 'draft'"/>
                            <field name="term_id" required="1" readonly="state != 'draft'"
                                   domain="[('course_id', '=', course_id)]"/>
                        </group>
                        <group>
                            <field name="subject_id" required="1" domain="[('subject_mode', '=', 'yes')]"
                                   readonly="state != 'draft'"/>
                        </group>
                        <separator string="Student Details"/>
                        <field name="student_ids" nolabel="1"
                               readonly="state != 'draft'"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="act_electivesubject" model="ir.actions.act_window">
        <field name="name">Elective Subject</field>
        <field name="res_model">xe.electivesubject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_electivesubject_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Elective Subject
            </p>
        </field>
    </record>

