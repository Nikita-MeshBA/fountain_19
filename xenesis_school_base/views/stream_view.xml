<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stream_tree" model="ir.ui.view">
        <field name="name">xe.stream.tree</field>
        <field name="model">xe.stream</field>
        <field name="arch" type="xml">
            <list string="Stream">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_stream_search" model="ir.ui.view">
        <field name="name">stream.search</field>
        <field name="model">xe.stream</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Stream">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>
    <record id="view_stream_form" model="ir.ui.view">
        <field name="name">xe.stream.form</field>
        <field name="model">xe.stream</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Stream">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="code" required="1"/>
                            <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="act_stream" model="ir.actions.act_window">
        <field name="name">Stream</field>
        <field name="res_model">xe.stream</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stream_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Stream
            </p>
        </field>
    </record>
</odoo>