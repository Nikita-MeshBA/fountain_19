<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_activity_tree" model="ir.ui.view">
        <field name="name">xe.activity.tree</field>
        <field name="model">xe.activity</field>
        <field name="arch" type="xml">
            <tree string="Activity">
                <field name="date"/>
                <field name="student_id"/>
                <field name="teacher_id"/>
                <field name="type_id"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
    <record id="view_activity_form" model="ir.ui.view">
        <field name="name">xe.activity.form</field>
        <field name="model">xe.activity</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Activity">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="student_id"/>
                        </group>
                        <group>
                            <field name="teacher_id" required="1"/>
                            <field name="type_id"/>
                        </group>
                    </group>
                    <field name="description" nolabel="1" placeholder="Description..."/>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="act_activity" model="ir.actions.act_window">
        <field name="name">Activity</field>
        <field name="res_model">xe.activity</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add an Activity
            </p>
        </field>
    </record>
</odoo>