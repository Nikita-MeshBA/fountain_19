<odoo>

    <record id="reconcile_invoice_payment_cron" model="ir.cron">
        <field name="name">Allocate payments to unreconciled invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_reconcile_invoice_payment()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
<!--        <field name="numbercall">-1</field>-->
<!--        <field name="doall" eval="False"/>-->
    </record>

    <record id="assign_login_page_to_parent_cron" model="ir.cron">
        <field name="name">Allocate login page to parents</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._cron_assign_studdent_page()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
<!--        <field name="numbercall">-1</field>-->
        <field name="active" eval="True"/>
<!--        <field name="doall" eval="False"/>-->
    </record>

</odoo>