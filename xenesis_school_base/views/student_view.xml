<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kanban_view_student" model="ir.ui.view">
        <field name="name">Student Kanban</field>
        <field name="model">xe.student</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <field name="image_128" widget="image" class="o_kanban_image_fill_left"
                                   options="{'zoom': true, 'zoom_delay': 1000, 'background': true, 'preventClicks': false}"/>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name" placeholder="Student's Name"/>
                                        </strong>
                                    </div>
                                </div>
                                <ul>
                                    <li id="last_login"/>
                                    <li t-if="record.email.raw_value" class="o_text_overflow">
                                        <field name="email"/>
                                    </li>
                                    <li t-if="record.course_id.raw_value" class="o_force_ltr">
                                        <field name="course_id"/>
                                    </li>
                                    <li t-if="record.classroom_id.raw_value" class="o_force_ltr">
                                        <field name="classroom_id"/>
                                    </li>
                                    <li t-if="record.roll_number.raw_value" class="o_force_ltr">
                                        <field name="roll_number"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">xe.student.tree</field>
        <field name="model">xe.student</field>
        <field name="arch" type="xml">
            <list string="Students" js_class="view_student_tree">
                <field name="name"/>
                <field name="roll_number"/>
                <field name="course_id"/>
                <field name="classroom_id"/>
                <field name="nationality_id"/>
                <field name="email"/>
            </list>
        </field>
    </record>

