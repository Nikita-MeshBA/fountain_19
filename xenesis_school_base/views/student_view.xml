<record id="view_student_search" model="ir.ui.view">
    <field name="name">student.search</field>
    <field name="model">xe.student</field>
    <field name="arch" type="xml">
        <search string="Students">
            <field name="name"/>
        </search>
    </field>
</record>    <record id="view_student_form" model="ir.ui.view">
        <field name="name">xe.student.form</field>
        <field name="model">xe.student</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Students" edit="false" js_class="view_student_form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_medcheckup"
                                type="object"
                                string="Health Details"
                                groups="xenesis_school_base.group_xe_health_details"
                                class="oe_stat_button"
                                icon="fa-heartbeat">
                        </button>
                        <button type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" name="action_view_invoice" invisible="hide_parent_field">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_invoiced" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Invoiced</span>
                            </div>
                        </button>
                        <button name="action_view_parent"
                                type="object"
                                string="Parent Details"
                                class="oe_stat_button"
                                icon="fa-users" invisible="1">
                        </button>
                        <button name="action_view_siblings"
                                type="object"
                                string="Sibling Details"
                                class="oe_stat_button"
                                icon="fa-users" invisible="1">
                        </button>
                        <button name="action_view_migration_history"
                                type="object"
                                string="Migration History"
                                class="oe_stat_button"
                                icon="fa-book">
                        </button>
                        <!-- <button name="action_view_activity_logs"
                                type="object"
                                string="Activity Logs"
                                class="oe_stat_button"
                                icon="fa-list-ol">
                        </button> -->
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1 class="d-flex">
                            <field name="name" placeholder="Student's Full Name" required="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_auto_seq" invisible="1"/>
                            <field name="alumni_boolean"/>
                            <field name="active" invisible="1"/>
                            <field name="roll_number" required="is_auto_seq == False"
                                   invisible="is_auto_seq != False and roll_number == False"/>
                            <field name="email"/>
                            <field name="course_id" string="Class" required="1"/>
                            <field name="classroom_id" string="Classroom" domain="[('course_id', '=', course_id)]"/>
                            <field name="term_id" domain="[('course_id', '=', course_id)]" invisible="1"/>
                            <!-- <field name="stream_id" string="Stream"/> -->
                            <field name="nemis"/>
                            <field name="assessment_number"/>
                            <field name="hide_acc_balance" invisible="1"/>
                            <field name="total_balance_partner" invisible="hide_acc_balance == False"
                                   string="Accounting Balance"/>
                            <field name="parent_user_ids" widget="many2many_tags" invisible="1"/>
                        </group>
                        <group>
                            <field name="academic_year_id" string="Joined Academic Year"/>
                            <field name="current_academic_year_id" string="Current Academic Year"
                                   help="Admin module > Configuration > Create Academic Year"/>
                            <field name="joined_date"/>
                            <field name="leaving_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="general_information"
                              string="General Information">
                            <group col="4" colspan="4" name="general_detail">
                                <field name="gender" required="1"/>
                                <field name="dob"/>
                                <field name="nationality_id"/>
                                <field name="visa_info"/>
                                <field name="blood_group"/>
                                <field name="partner_id" options="{'no_create_edit': True}" required="1"
                                       invisible="1"/>
                                <field name="user_id" options="{'no_create_edit': True}" invisible="1"/>
                                <field name="company_id" options="{'no_create':True}"
                                       groups="base.group_multi_company"/>
                            </group>
                            <group string="Address Detail" name="address">
                                <label for="street" string="Address"/>
                                <div name="div_address">
                                    <field name="street" placeholder="Street..."/>
                                    <field name="street2" placeholder="Street2"/>
                                    <div class="address_format">
                                        <field name="city" placeholder="City" style="width: 40%"/>
                                        <field name="state_id" class="oe_no_button" placeholder="State"
                                               style="width: 37%" options="{'no_open': True}"/>
                                        <field name="zip" placeholder="ZIP" style="width: 20%"/>
                                    </div>
                                    <field name="country_id" placeholder="Country" class="oe_no_button"
                                           options="{'no_open': True}"/>
                                </div>
                            </group>
                        </page>
                        <page string="Alumni Details" invisible="alumni_boolean == False">
                            <group colspan="4" col="4">
                                <field name="passing_year_id"/>
                                <field name="current_position"/>
                                <field name="current_job"/>
                            </group>
                        </page>
                        <page name="academic_information" string="Academic Details" invisible="1">
                            <group string="Elective Subject"
                                   invisible="elective_subject_id == False">
                                <field name="elective_subject_id" readonly="1"
                                       invisible="elective_subject_id == False"/>
                            </group>
                            <group col="4" colspan="4" name="academic_informations">
                                <field name="course_detail_ids" nolabel="1">
                                    <list string="Class Details">
                                        <field name="roll_number" readonly="1"/>
                                        <field name="course_id" required="1"/>
                                        <field name="term_id" required="0"
                                               domain="[('course_id', '=', course_id)]"/>
                                        <!-- <field name="stream_id"/> -->
                                        <field name="classroom_id"/>
                                    </list>
                                    <form>
                                        <group cols="2" colspan="2">
                                            <field name="roll_number" readonly="1"/>
                                            <field name="course_id" required="1"/>
                                            <field name="term_id" required="0"
                                                   domain="[('course_id', '=', course_id)]"/>
                                            <!-- <field name="stream_id"/> -->
                                            <field name="classroom_id" domain="[('course_id', '=', course_id)]"/>
                                        </group>
                                    </form>
                                </field>
                            </group>
                        </page>
                        <page name="parent_details" string="Parent Details">
                            <field name="parent_ids">
                                <list editable="top">
                                    <field name="name" string="Parent Name"/>
                                    <field name="phone" string="Mobile" required="1"/>
                                    <field name="phone" string="Phone"/>
                                    <field name="email" string="Email"/>
                                    <field name="relation"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name" string="Parent Name"/>
                                            <field name="phone" string="Mobile" required="1"/>
                                            <field name="phone" string="Phone"/>
                                            <field name="email" string="Email"/>
                                            <field name="relation"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page name="subjects" string="Subjects">
                            <group string="Elective Subjects">
                                <field name='elective_subjects_ids'
                                       domain="[('subject_mode','=','yes')]">
                                    <list>
                                        <field name="name" width="60%;"/>
                                        <field name="code" width="40%;"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <field name="name"/>
                                                <field name="code"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </group>
                            <group string="Mandatory Subjects">
                                <field name='mandatory_subjects_ids'
                                       options="{'no_open':True,'no_create':1,'no_create_edit':1}"
                                       domain="[('course_ids', 'in', course_id)]" readonly="1" force_save="1">
                                    <list>
                                        <field name="name" width="60%;"/>
                                        <field name="code" width="40%;"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <field name="name"/>
                                                <field name="code"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </group>
                        </page>
                        <field name="hide_parent_field" invisible="1"/>
                        <field name="is_siblings" invisible="1"/>
                        <page name="student_details" invisible="is_siblings == False" string="Sibling Details">
<!--                            <field name="student_ids" options="{'no_open': True}"-->
<!--                                   domain="[('id','!=',active_id)]">-->
                                <field name="student_ids"
                                       options="{'no_open': True}"
                                       domain="[('id', '!=', id)]">
                                <list create="0" delete="0">
                                    <field name="roll_number" string="Admission Number"
                                           required="1"/>
                                    <field name="name" string="Student Name"/>
                                    <field name="course_id" string="Class"/>
                                    <field name="classroom_id" string="Classroom"
                                           domain="[('course_id', '=', course_id)]"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="roll_number" string="Admission Number"
                                                   required="1"/>
                                            <field name="name" string="Student Name"/>
                                            <field name="course_id" string="Class"/>
                                            <field name="classroom_id" string="Classroom"
                                                   domain="[('course_id', '=', course_id)]"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Documents" name="documents" invisible="hide_parent_field">
                            <group>
                                <field name="store_fname1" invisible="1"/>
                                <field name="store_fname9" invisible="1"/>
                                <field name="store_fname11" invisible="1"/>
                                <field name="store_fname3" invisible="1"/>
                                <field name="store_fname4" invisible="1"/>
                                <field name="store_fname5" invisible="1"/>
                                <field name="store_fname6" invisible="1"/>
                                <field name="student_birthcert" string="Student's Date of Birth Certificate"
                                       filename="store_fname1"/>
                                <field name="certificate_number"/>
                                <field name="previous_term_report" filename="store_fname9"
                                       string="Student Report Card "/>
                                <field name="leaving_certificate" filename="store_fname11"
                                       string="Previous School Leaving Certificate"/>
                                <field name="father_passport" filename="store_fname3"
                                       string="National ID Parent 1"/>
                                <field name="mother_passport" filename="store_fname4"
                                       string="National ID Parent 2"/>
                                <field name="passportcopy_father" filename="store_fname5"
                                       string="Passport Copy Parent 1"/>
                                <field name="passportcopy_mother" filename="store_fname6"
                                       string="Passport Copy Parent 2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_student_form_inherit" model="ir.ui.view">
        <field name="name">xe.student.form.inherit.parent</field>
        <field name="model">xe.student</field>
        <field name="inherit_id" ref="xenesis_school_base.view_student_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//field[@name='current_academic_year_id']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                   <attribute name="options">{"no_open": True}</attribute>
                </t>
            </xpath>
            <xpath expr="//field[@name='academic_year_id']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="options">{"no_open": True}</attribute>
                </t>
            </xpath>
            <xpath expr="//field[@name='nationality_id']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="options">{"no_open": True}</attribute>
                </t>
            </xpath>
            <xpath expr="//field[@name='course_id']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="style">pointer-events: none;</attribute>
                    <attribute name="options">{"no_open": True}</attribute>
                </t>
            </xpath>
            <xpath expr="//field[@name='classroom_id']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="required">1</attribute>
                    <attribute name="style">pointer-events: none;</attribute>
                    <attribute name="options">{"no_open": True}</attribute>
                </t>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="required">1</attribute>
                    <attribute name="style">pointer-events: none;</attribute>
                    <attribute name="options">{"no_open": True}</attribute>
                </t>
            </xpath>
            <xpath expr="//field[@name='parent_ids']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="readonly">1</attribute>
                </t>
            </xpath>
            <xpath expr="//field[@name='student_ids']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="readonly">1</attribute>
                </t>
            </xpath>
            <xpath expr="//field[@name='elective_subjects_ids']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="readonly">1</attribute>
                </t>
            </xpath>
            <xpath expr="//field[@name='invoice_ids']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="readonly">1</attribute>
                </t>
            </xpath>
            <xpath expr="//button[@name='add_siblings']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="invisible">1</attribute>
                </t>
            </xpath>
            <xpath expr="//page[@name='fee_details']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="invisible">1</attribute>
                </t>
            </xpath>
            <xpath expr="//page[@name='documents']" position="attributes">
                <t groups="xenesis_school_base.group_popup_disable">
                    <attribute name="invisible">1</attribute>
                </t>
            </xpath> -->
            <xpath expr="//form" position="attributes">
                <t groups="xenesis_school_base.group_xe_admin, xenesis_school_base.group_xe_staff">
                    <attribute name="create">1</attribute>
                    <attribute name="edit">1</attribute>
                </t>
            </xpath>
            <xpath expr="//sheet" position='after'>
                <t groups="xenesis_school_base.group_xe_admin, xenesis_school_base.group_xe_staff">
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

    <record id="act_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">xe.student</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_student_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Student
            </p>
        </field>
    </record>

    <record id="action_server_alumni_set" model="ir.actions.server">
        <field name="name">Set as Alumni</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_xe_student"/>
        <field name="binding_model_id" ref="model_xe_student"/>
        <field name="state">code</field>
        <field name="code">records.set_alumni_student()</field>
    </record>

    <menuitem
            id="menu_student"
            name="Students"
            action="act_student"
            parent="menu_administration_root"
            groups="xenesis_school_base.group_xe_staff"
            sequence="2"/>

    <menuitem id="menu_config" name="Configuration" parent="menu_administration_root" sequence="3"/>

    <menuitem id="menu_student_root" name="Students" groups="xenesis_school_base.group_xe_student"
              web_icon="xenesis_school_base,static/description/icon.png" sequence="6"/>

    <menuitem name="Students" id="student_profile_menu_id" action="act_student" parent="menu_student_root"
              groups="xenesis_school_base.group_xe_student"/>
</odoo>
