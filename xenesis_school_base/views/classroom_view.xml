<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_classroom_tree" model="ir.ui.view">
        <field name="name">xe.classroom.tree</field>
        <field name="model">xe.classroom</field>
        <field name="arch" type="xml">
            <tree string="Classroom">
                <field name="name"/>
                <field name="code"/>
                <field name="course_id"/>
                <!-- <field name="term_id" column_invisible="1"/> -->
                <field name="capacity"/>
            </tree>
        </field>
    </record>
    <record id="view_classroom_search" model="ir.ui.view">
        <field name="name">classroom.search</field>
        <field name="model">xe.classroom</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Classroom">
                <field name="name"/>
                <field name="code"/>
                <newline/>
            </search>
        </field>
    </record>
    <record id="view_classroom_form" model="ir.ui.view">
        <field name="name">classroom.form</field>
        <field name="model">xe.classroom</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Classroom">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="course_id"/>
                            <field name="teacher_id"/>
                            <field name="company_id" options="{'no_create':True}"
                                   groups="base.group_multi_company"/>
                            <field name="teacher_signature_html" string="Signature" widget="signature"
                                   class="oe_avatar oe_avatar"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="capacity"/>
                            <!-- <field name="term_id" domain="[('course_id', '=', course_id)]" invisible="1"/> -->
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="act_classroom" model="ir.actions.act_window">
        <field name="name">Classroom</field>
        <field name="res_model">xe.classroom</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_classroom_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a new Classroom</p>
        </field>
    </record>
</odoo>