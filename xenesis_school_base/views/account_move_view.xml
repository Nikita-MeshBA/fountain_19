<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!--  Account  Window-->
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">account.move.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="payment_reference" position="after">
                    <field name="course_id" string="Class" invisible="move_type != 'out_invoice'"/>
                    <field name="class_room_id" invisible="move_type != 'out_invoice'"
                           domain="[('course_id', '=', course_id)]"/>
                    <field name="terms" string="Term" invisible="move_type != 'out_invoice'"/>
                    <field name="roll_number" readonly="1" force_save="1" invisible="move_type != 'out_invoice'"/>
                </field>
                <xpath expr="//field[@name='amount_residual']" position="after">
                    <field name="total_balance_partner" string="Balance" class="oe_subtotal_footer_separator"
                           invisible="display_on_invoice == False" force_save="1"/>
                    <field name="grand_total_amount" string="Grand Total" class="oe_subtotal_footer_separator"
                           invisible="display_on_invoice == False" force_save="1"/>
                    <field name="display_on_invoice" invisible="1"/>
                </xpath>
                <xpath expr="//page[@id='invoice_tab']" position="after">
                    <page id="pending_invoices" string="Pending Invoices" invisible="display_on_invoice == False">
                        <field name="pending_invoice_ids">
                            <tree>
                                <field name="name"/>
                                <field name="amount_total" string="Total Amount"/>
                                <field name="amount_residual" string="Amount Due"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
