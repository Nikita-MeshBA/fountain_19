<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_adms" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="create_user" string="Create User" type="object" groups="hr.group_hr_manager"
                        invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_medcheckup" type="object"
                        class="oe_stat_button" string="Health Details" icon="fa-heartbeat">
                </button>
            </xpath>
            <field name="coach_id" position="after">
                <field name="teach_type" required="1"/>
            </field>
            <field name="marital" position="after">
                <field name="blood_group" required="0"/>
            </field>
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page name="subject_information" string="Academic" invisible="teach_type != 'teaching'">
                    <group string="Assigned Class and Term"
                           invisible="not assigned_course_id">
                        <field name="assigned_course_id" readonly="1"
                               invisible="not assigned_course_id"/>
                        <field name="assigned_term_id" readonly="1"
                               invisible="not assigned_term_id"/>
                    </group>
                    <separator string="Subject &amp; Class Details"/>
                    <field name="subjects_ids" widget='one2many' nolabel="1">
                        <tree editable="top">
                            <field name="course_id" string="Class" required="1"/>
                            <field name="classroom_ids" string="Class Room" domain="[('course_id', '=', course_id)]"
                                   widget="many2many_tags"/>
                            <field name="subject_ids" widget="many2many_tags"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_search_admins" model="ir.ui.view">
        <field name="name">hr.employee.view.search</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//filter[@name='message_needaction']" position="after">
                    <separator/>
                    <filter string="Teaching" name="teach_type" domain="[('teach_type', '=','teaching')]"/>
                    <filter string="Non Teaching" name="teach_type" domain="[('teach_type', '=','non')]"/>
                </xpath>
                <xpath expr="//filter[@name='group_manager']" position="after">
                    <filter name="teach_type" string="Teacher Type" domain="[]" context="{'group_by': 'teach_type'}"/>
                </xpath>

            </data>
        </field>
    </record>

    <record id="account.action_validate_account_move" model="ir.actions.act_window">
        <field name="name">Confirm Invoices</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">validate.account.move</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account.validate_account_move_view"/>
        <field name="context">{}</field>
        <field name="target">new</field>
        <field name="help">This wizard will validate all journal entries
            selected. Once journal entries are validated, you can not update them
            anymore.
        </field>
        <field name="groups_id"
               eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="company_view_inherited_school" model="ir.ui.view">
        <field name="name">res.company.form.inherited</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="current_academic_year_id" domain="[('company_id', '=', id)]"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_sequence" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='website']" position="before">
                <field name="mpesa_paybill"/>
                <field name="account"/>
            </xpath>

        </field>
    </record>
    <menuitem
            id="hr.menu_hr_root"
            name="Employees"
            groups="hr.group_hr_manager,hr.group_hr_user"
            web_icon="hr,static/description/icon.png"
            sequence="185"/>
    <menuitem
            name="Time Off"
            id="hr_holidays.menu_hr_holidays_root"
            sequence="225"
            web_icon="hr_holidays,static/description/icon.png"
            groups="hr_holidays.group_hr_holidays_responsible,hr_holidays.group_hr_holidays_user,hr_holidays.group_hr_holidays_manager"/>
    <menuitem id="hr_expense.menu_hr_expense_root" name="Expenses" sequence="230"
              web_icon="hr_expense,static/description/icon.png" groups="hr_expense.group_hr_expense_team_approver"/>

</odoo>