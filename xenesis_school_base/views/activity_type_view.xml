<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_activity_type_tree" model="ir.ui.view">
        <field name="name">xe.activity.type.tree</field>
        <field name="model">xe.activity.type</field>
        <field name="arch" type="xml">
            <list string="Activity Type">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_activity_type_form" model="ir.ui.view">
        <field name="name">xe.activity.type.form</field>
        <field name="model">xe.activity.type</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Activity Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                        </group>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="act_activity_type" model="ir.actions.act_window">
        <field name="name">Activity Type</field>
        <field name="res_model">xe.activity.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a Activity Type
            </p>
        </field>
    </record>
</odoo>