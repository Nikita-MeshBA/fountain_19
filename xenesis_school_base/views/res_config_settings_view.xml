<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_acad_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.acad</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Academic" string="Academic" name="academic_settings"
                     logo="/xenesis_school_base/static/description/icon.png">
                    <div class="app_settings_block" data-string="Academic"
                         string="Academic" data-key="xenesis_school_base" id="academic_block">
                        <h2>Academic Year</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-12 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label for="current_academic_year_id"/>
                                    <div class="content-group">
                                        <div class="mt16">
                                            <field name="company_id" invisible="1"/>
                                            <field name="current_academic_year_id"
                                                   class="o_light_label" readonly="0" force_save="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="class_admission_no_automatic"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="class_admission_no_automatic"/>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="is_add_discount_seperate" force_save="1" class="o_light_label"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="is_add_discount_seperate" string="Add Discount Line in Invoice"/>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16 o_settings_container" invisible="is_add_discount_seperate == False">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label for="discount_product_id" string="Discount Product"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="discount_product_id" force_save="1" class="o_light_label"/>
                                </div>

                            </div>
                        </div>
                        <div class="row mt16 o_settings_container" invisible="is_add_discount_seperate == False">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label for="discount_account_id" string="Discount Account"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <field name="discount_account_id" force_save="1" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="is_schedule_interview" force_save="1" class="o_light_label"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="is_schedule_interview" string="Enable Schedule Interview Button"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="default_balance_on_invoice">
                    <div class="o_setting_left_pane">
                        <field name="balance_on_invoice"/>
                    </div>
                    <div class="o_setting_right_pane" id="balance_on_invoice">
                        <label for="balance_on_invoice"/>
                        <div class="text-muted">
                            Display Balances on Invoice
                        </div>
                    </div>
                </div>
            </xpath>
              <xpath expr="//block[@name='users_setting_container']"
               position="inside">

            <setting string="Parent Generic Password"
                     help="Common password for parent portal login"
                     id="parent_generic_password_setting">
                <field name="parent_generic_password"/>
            </setting>

        </xpath>
        </field>
    </record>

    <record id="action_acadmic_configuration"
            model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
<!--        <field name="target">inline</field>-->
        <field name="target">current</field>
        <field name="context">{'module' : 'xenesis_school_base', 'bin_size':
            False}
        </field>
    </record>

</odoo>
