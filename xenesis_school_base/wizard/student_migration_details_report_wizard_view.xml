<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_migration_report_form" model="ir.ui.view">
        <field name="name">xe.student.migration.report.wizard.form</field>
        <field name="model">xe.student.migration.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Student Migration Details">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="migration_filter"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                        <field name="student_id"
                               invisible="migration_filter != 'student'" required="migration_filter == 'student'"/>
                        <field name="course_id"
                               invisible="migration_filter != 'course'" required="migration_filter == 'course'"/>
                        <field name="term_id"
                               invisible="migration_filter != 'term'" required="migration_filter == 'term'"/>
                    </group>
                </group>
                <footer>
                    <button name="check_report" string="Print" type="object" default_focus="1" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_student_migration_report" model="ir.actions.act_window">
        <field name="name">Student Migration Details</field>
        <field name="res_model">xe.student.migration.report.wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="student_migration_report_form"/>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
    <menuitem
            id="menu_student_migration_report"
            name="Student Migration Details"
            action="action_student_migration_report"
            parent="menu_base_report"
            sequence="2"
            groups="xenesis_school_base.group_xe_student"/>

</odoo>

