<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parent_user_create_view_form" model="ir.ui.view">
        <field name="name">xe.parent.user.form</field>
        <field name="model">xe.parent.user</field>
        <field name="arch" type="xml">
            <form string="Create Users For Parents">
                <p class="oe_grey">
                    Create User for selected Parents(s)
                </p>
                <separator string="Parents"/>
                <field name="parent_ids" readonly="1"/>
                <footer>
                    <button string="Create" name="create_user" type="object"
                            default_focus="1" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_parent_users" model="ir.actions.act_window">
        <field name="name">Create User</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xe.parent.user</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- TODO: check if we need this -->
        <field name="binding_model_id" ref="xenesis_school_base.model_xe_parent"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>


 
 












