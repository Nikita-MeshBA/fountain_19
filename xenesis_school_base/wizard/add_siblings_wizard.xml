<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="add_siblings_form" model="ir.ui.view">
        <field name="name">Add Siblings Enquiry</field>
        <field name="model">add.siblings.wizard</field>
        <field name="arch" type="xml">
            <form string="Siblings Enquiry">
                <group>
                    <field name="student_id" invisible="1"/>
                    <field name="sibling_ids" domain="[('id','!=',student_id)]">
                        <list editable="bottom">
                            <field name="roll_number" string="Admission Number"
                                   required="1"/>
                            <field name="name" string="Student Name"/>
                            <field name="course_id" string="Class"/>
                            <field name="classroom_id" string="Classroom"
                                   domain="[('course_id', '=', course_id)]"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button string="Add" name="action_ok" type="object" default_focus="1" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="act_siblings" model="ir.actions.act_window">
        <field name="name">Siblings</field>
        <field name="res_model">add.siblings.wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="add_siblings_form"/>
        <field name="context">{}</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a new Siblings</p>
        </field>
    </record>
</odoo>
