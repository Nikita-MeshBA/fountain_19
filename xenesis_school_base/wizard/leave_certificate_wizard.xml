<odoo>
    <record id="leave_certificate_form_wizard" model="ir.ui.view">
        <field name="name">xe.certificate.wizard.form</field>
        <field name="model">xe.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Leaving Certificate Generation">
                <group>
                    <group>
                        <field name="student_id" invisible="1"/>
                        <field name="leaving_date" required="1"/>
                        <field name="enrolled_course_id" required="1"/>
                    </group>
                    <field name="att_line_ids">
                        <tree editable="bottom">
                            <field name="attribute_id"/>
                            <field name="value"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_generation_leave_s" string="Generate Leaving Certificate" type="object"
                            default_focus="1"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.server" id="leaving_certificate_server_act">
        <field name="name">Generate Leaving Certificate</field>
        <field name="model_id" ref="model_xe_student"/>
        <field name="binding_model_id" ref="model_xe_student"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id"
               eval="[(4, ref('xenesis_school_base.group_xe_admin')),(4, ref('xenesis_school_base.group_xe_staff'))]"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_leave_certificate_form()
        </field>
    </record>
</odoo>