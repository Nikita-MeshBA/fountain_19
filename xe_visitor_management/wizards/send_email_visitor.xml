<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
	<data>
		<record id="visitor_email_send_wizard" model="ir.ui.view">
            <field name="name">visitor.send.email.wizard.form</field>
            <field name="model">send.email.visitor</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                                <field name="visitor_pass_ids" widget="many2many_tags"/>
                                <field name="email_template_id"/>
                                <field name="template_body" widget="html"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Send Email" name="action_send_email" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>
                </form>
            </field>
         </record>

         <record id="visitor_pass_send_email" model="ir.actions.act_window">
               <field name="name">Send Email</field>
               <field name="res_model">send.email.visitor</field>
               <field name="view_mode">form</field>
               <field name="target">new</field>
               <field name="binding_model_id" ref="model_visitor_pass"/>
               <field name="binding_view_types">list,form</field>
       </record>
	</data>
</odoo>