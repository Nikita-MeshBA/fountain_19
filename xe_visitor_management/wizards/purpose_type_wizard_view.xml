<?xml version="1.0"?>
<odoo>
	<data>
		<record model="ir.ui.view" id="purpose_type_wizard_form">
			<field name="name">purpose.type.wizard.form</field>
			<field name="model">purpose.type.wizard</field>
			<field name="type">form</field>
			<field name="arch" type="xml">
				<form string="Purpose Type Wise">
					<group col="2" colspan="2">
						<field name="purpose_type_id" required="1" />
					</group>
					<group col="4" colspan="4">
						<field name="from_date" required="1" />
						<field name="to_date" required="1" />
					</group>
					<footer>
						<span>
							<button string="Print" type="object" name="print_report"
								class="oe_highlight" />
							<button special="cancel" string="Close" type="object" />
						</span>
					</footer>
				</form>
			</field>
		</record>

		<record id="action_purpose_type_wizard" model="ir.actions.act_window">
			<field name="name">Purpose Type Wise</field>
			<field name="res_model">purpose.type.wizard</field>
			<field name="view_mode">list,form</field>
			<field name="view_id" ref="purpose_type_wizard_form" />
			<field name="target">new</field>
		</record>
			
	</data>
</odoo>
