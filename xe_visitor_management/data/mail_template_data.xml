<?xml version="1.0" ?>
<odoo>
    <data noupdate="1">
        <record id="email_template_visitor_pass" model="mail.template">
            <field name="name">Visitor Entry</field>
            <field name="subject">Visitor Meeting</field>
            <field name="email_from">{{object.company_id.name}}</field>
            <field name="email_to">{{object.meeting_with_id.work_email}}</field>
            <field name="model_id" ref="xe_visitor_management.model_visitor_pass" />
            <field name="auto_delete" eval="True" />
            <field name="body_html"><![CDATA[
                <p>Hello, {{object.meeting_with_id.name}}</p>
                <p>You got visitor <b>{{object.name}}</b></p>
                <p>Purpose: {{object.purpose}}</p>
            ]]>
            </field>
        </record>
    </data>
</odoo>