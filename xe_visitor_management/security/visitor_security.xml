        <record id="privilege_xe_visitor" model="res.groups.privilege">
            <field name="name">Visitor Management</field>
            <field name="category_id" ref="xenesis_school_base.module_category_xe_school"/>
        </record>

        <record id="group_xe_reception" model="res.groups">
            <field name="name">Reception Manager</field>
            <field name="privilege_id" ref="privilege_xe_visitor"/>
            <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="student_pass_general_rule" model="ir.rule">
            <field name="name">Student Pass General Rule</field>
            <field name="model_id" ref="model_student_pass" />
            <field name="groups"
                eval="[(4, ref('xe_visitor_management.group_xe_reception'))]" />
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <record model="ir.rule" id="view_students_pass_rule">
            <field name="name">Students Pass</field>
            <field name="model_id" ref="model_student_pass"/>
            <field name="groups"
                   eval="[(4, ref('xenesis_school_base.group_xe_student'))]"/>
            <field name="domain_force">['|',
                ('student_id.user_id','=',user.id), ('student_id.user_id','in',
                user.child_ids.ids)]
            </field>
        </record>
        <record id="doc_type_multi_company_rule" model="ir.rule">
            <field name="name">multi-company visitors document type rule</field>
            <field name="model_id" ref="model_document_type"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
        <record id="purpose_type_multi_company_rule" model="ir.rule">
            <field name="name">multi-company visitors purpose type rule</field>
            <field name="model_id" ref="model_purpose_type"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
        <record id="student_pass_multi_company_rule" model="ir.rule">
            <field name="name">multi-company visitors student pass rule</field>
            <field name="model_id" ref="model_student_pass"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
        <record id="visitor_pass_multi_company_rule" model="ir.rule">
            <field name="name">multi-company visitors pass rule</field>
            <field name="model_id" ref="model_visitor_pass"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
