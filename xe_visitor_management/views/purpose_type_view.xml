<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purpose_type_tree" model="ir.ui.view">
        <field name="name">purpose.type.tree</field>
        <field name="model">purpose.type</field>
        <field name="priority" eval="8" />
        <field name="arch" type="xml">
            <list string="Purpose Type" editable="bottom">
                <field name="name" />
                <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_purpose_type_search" model="ir.ui.view">
        <field name="name">purpose.type.search</field>
        <field name="model">purpose.type</field>
        <field name="priority" eval="8" />
        <field name="arch" type="xml">
            <search string="Purpose Type">
                <field name="name" string="Name"/>
            </search>
        </field>
    </record>
    <record id="act_open_purpose_type_view" model="ir.actions.act_window">
        <field name="name">Purpose Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purpose.type</field>
        <field name="view_id" ref="view_purpose_type_tree" />
        <field name="search_view_id" ref="view_purpose_type_search" />
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
