<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_visitor_pass_tree" model="ir.ui.view">
        <field name="name">visitor.pass.tree</field>
        <field name="model">visitor.pass</field>
        <field name="priority" eval="8" />
        <field name="arch" type="xml">
            <list string="Gate Pass">
                <field name="pass_number" />
                <field name="name" />
                <field name="meeting_with_id" />
                <field name="visitor_in_time" />
                <field name="visitor_out_time" />
                <field name="vehicle_number" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="view_visitor_pass_form" model="ir.ui.view">
        <field name="name">visitor.pass.form</field>
        <field name="model">visitor.pass</field>
        <field name="priority" eval="8" />
        <field name="arch" type="xml">
            <form string="Reception Management">
                <header groups="base.group_user">
                    <button name="action_visitor_in" invisible="state not in ['draft']" string="Visitor In" groups="xe_visitor_management.group_xe_reception" type="object" class="oe_highlight" />
                    <button name="action_approve_visitor" invisible="state not in ['visitor_in']" string="Approve Visitor" type="object" class="oe_highlight" />
                    <button name="action_visitor_out" invisible="state not in ['approve_visitor']" string="Visitor Out" groups="xe_visitor_management.group_xe_reception" type="object" class="oe_highlight" />
                    <button name="action_done" invisible="state not in ['visitor_out']" string="Done" type="object" groups="xe_visitor_management.group_xe_reception" class="oe_highlight" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,visitor_in,approve_visitor,visitor_out,done" />
                </header>
                <sheet>
                    <field name="state" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="pass_number" readonly="state in ['done', 'visitor_out']"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="state in ['done', 'visitor_out']"/>
                            <field name="meeting_with_id" readonly="state in ['done', 'visitor_out']"/>
                            <field name="phone" readonly="state in ['done', 'visitor_out']"/>
                            <field name="email" readonly="state in ['done', 'visitor_out']"/>
                            <field name="street" readonly="state in ['done', 'visitor_out']"/>
                            <field name="street2" readonly="state in ['done', 'visitor_out']"/>
                            <field name="city" readonly="state in ['done', 'visitor_out']"/>
                            <field name="po_box_no" readonly="state in ['done', 'visitor_out']"/>
                            <field name="visitor_in_time"/>
                            <field name="visitor_out_time"/>
                            <field name="document_type_id" readonly="state in ['done', 'visitor_out']"/>
                            <field name="document_number" readonly="state in ['done', 'visitor_out']"/>
                            <field name="vehicle_number" readonly="state in ['done', 'visitor_out']"/>
                            <field name="approved_by_id" readonly="state in ['done', 'visitor_out']"/>
                            <field name="duty_officer_name_id" readonly="state in ['done', 'visitor_out']"/>
                        </group>
                        <group>
                            <field name="purpose_type_id" readonly="state in ['done', 'visitor_out']"/>
                            <field name="purpose" required="approved_by_id != False" readonly="state in ['done', 'visitor_out']" />
                            <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user" />
                    <field name="message_ids" widget="mail_thread" />
                    <field name="activity_ids"/>
                </div>
            </form>
        </field>
    </record>
