    <record id="view_visitor_pass_search" model="ir.ui.view">
        <field name="name">visitor.pass.search</field>
        <field name="model">visitor.pass</field>
        <field name="arch" type="xml">
            <search string="Reception Management">
                <field name="pass_number"/>
                <field name="name"/>
                <field name="state"/>

                <filter name="visitor_in"
                        string="Visitor In"
                        domain="[('state', '=', 'visitor_in')]"/>

                <filter name="approve_visitor"
                        string="Approve Visitor"
                        domain="[('state', '=', 'approve_visitor')]"/>

                <filter name="visitor_out"
                        string="Visitor Out"
                        domain="[('state', '=', 'visitor_out')]"/>

                <filter name="done"
                        string="Done"
                        domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>    <record id="act_open_visitor_pass_view" model="ir.actions.act_window">
        <field name="name">Reception Management</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">visitor.pass</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_visitor_pass_search" />
        <field name="domain">[]</field>
    </record>
    <record id="act_open_visitor_pass_view_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="act_open_visitor_pass_view" />
        <field name="sequence" eval="20" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_visitor_pass_form" />
    </record>
    <record id="act_open_visitor_pass_view_tree" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="act_open_visitor_pass_view" />
        <field name="sequence" eval="10" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_visitor_pass_tree" />
    </record>

    <record id="seq_visitor_pass" model="ir.sequence">
        <field name="name">Visitor Pass</field>
        <field name="code">visitor.pass</field>
        <field name="prefix">VP</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
</odoo>