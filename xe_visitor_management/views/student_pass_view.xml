    <record id="act_open_student_pass_view" model="ir.actions.act_window">
        <field name="name">Student Pass</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">student.pass</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_student_pass_search" />
        <field name="domain">[]</field>
        <field name="context">{}</field>
