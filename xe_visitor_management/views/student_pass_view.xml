<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_student_pass_tree" model="ir.ui.view">
        <field name="name">student.pass.tree</field>
        <field name="model">student.pass</field>
        <field name="priority" eval="8" />
        <field name="arch" type="xml">
            <list string="Student Pass">
                <field name="student_id" />
                <field name="approved_by_id" />
                <field name="approved_time" />
                <field name="reason" />
            </list>
        </field>
    </record>
    <record id="view_student_pass_form" model="ir.ui.view">
        <field name="name">student.pass.form</field>
        <field name="model">student.pass</field>
        <field name="priority" eval="8" />
        <field name="arch" type="xml">
            <form string="Student Pass">
                <header>
                    <field name="verified" invisible="1"/>
                    <button name="action_approved" invisible="state not in ['draft']" string="Approved Student Pass" type="object" class="oe_highlight" />
                    <button name="action_draft" invisible="state not in ['approved']" string="Draft" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved" />
                </header>
                <sheet>
                    <group col="4">
                        <field name="student_id" />
                        <field name="application_number"/>
                        <field name="course_id" force_save="1" />
                        <field name="classroom_id" force_save="1"/>
                        <field name="batch_id" invisible="1"/>
                    </group>
                    <group col="4" colspan="4">
                        <field name="approved_by_id" readonly="1" />
                        <field name="approved_time" readonly="1" />
                        <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                    </group>

                    <group col="4">
                        <field name="person_name" />
                        <field name="relationship" />
                        <field name="reason" />
                        <field name="identification_no" />
                        <field name="mobile" />
                        <field name="send_otp" invisible="sent_sms == False"/>
                        <field name="sent_sms" invisible="1"/>
                    </group>
                    <group col="4">
                        <button name="sent_otp" string="Send OTP" type="object" class="oe_highlight" invisible="sent_sms == False"/>
                        <field name="stud_otp" invisible="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"
                        groups="base.group_user" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
