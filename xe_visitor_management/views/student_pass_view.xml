    <record id="act_open_student_pass_view_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="act_open_student_pass_view" />
        <field name="sequence" eval="20" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_student_pass_form" />
    </record>
    <record id="act_open_student_pass_view_tree" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="act_open_student_pass_view" />
        <field name="sequence" eval="10" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_student_pass_tree" />
    </record>

