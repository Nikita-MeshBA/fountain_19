<odoo>
    <data>
    	<record id="empoyee_wise_report" model="ir.actions.report">
			<field name="name">Employee Wise</field>
			<field name="model">purpose.type.wizard</field>
			<field name="report_type">qweb-pdf</field>
			<field name="report_name">xe_visitor_management.report_empoyee_wise</field>
			<field name="report_file">xe_visitor_management.report_empoyee_wise</field>
		</record>
        <template id="report_empoyee_wise">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                      <br/>
                        <div class="text-center">
                            <h3>
                                <strong>Employee Wise Details</strong>
                            </h3>
                        </div>
                        <br/>
                        <div class="text-center">
                            <strong>Meeting With : <span t-esc="get_data['meeting_with_id'][1]" /></strong>
                            <br/>
                            <strong>From Date : <span t-esc="get_data['from_date']" /> </strong>
                            to
                            <strong>To Date : <span t-esc="get_data['to_date']" /> </strong>
                        </div>
                        <br/><br/>
                        <table width="100%" class="table table-bordered table-condensed">
                            <thead>
                                <th class="text-center">Pass No.</th>
                                <th class="text-center">Name</th>
                                <th class="text-center">Approved By</th>
                                <th class="text-center">Reception Duty Officer</th>
                                <th class="text-center">In Time</th>
                                <th class="text-center">Out Time</th>
                                <th class="text-center">State</th>
                            </thead>
                            <tbody>
                                <t t-foreach="get_object" t-as="obj">
                                    <tr t-foreach="obj['record']" t-as="l">
                                        <td class="text-center">
                                            <t t-esc="l['pass_number']" />
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="l['name']" />
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="l['approved_by_id']" />
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="l['duty_officer_name_id']" />
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="l['visitor_in_time']" />
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="l['visitor_out_time']" />
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="l['state']" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div> 
                </t>
            </t>
        </template>
    </data>
</odoo>
