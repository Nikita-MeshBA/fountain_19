   <template id="external_layout_standard_inherit" inherit_id="web.external_layout_standard">

    <!-- Adjust the logo and header layout for marksheet reports -->
<!--    <xpath expr="//div[hasclass('header')]/div[1]/img" position="attributes">-->
       <xpath expr="//div[contains(@t-attf-class, 'header')]/div[1]/img" position="attributes">
        <attribute name="t-attf-style" add="max-height: 110px;" separator=" "/>
    </xpath>

    <!-- Replace the company tagline with the marksheet title -->
<!--    <xpath expr="//div[hasclass('header')]/div[1]/div[@t-field='company.report_header']" position="replace">-->
       <xpath expr="//div[contains(@t-attf-class, 'header')]/div[1]/div[@t-field='company.report_header']" position="replace">
        <div t-if="doc_model == 'xe.marksheet.line'"
             class="o_company_tagline mw-50 fw-bold text-center">
            <strong>Student MarkSheet</strong>
        </div>
        <div t-else=""
             t-field="company.report_header"
             class="o_company_tagline mw-50 fw-bold"/>
    </xpath>

    <!-- Add company details to the header for marksheet reports -->
<!--    <xpath expr="//div[hasclass('header')]/div[hasclass('row')]" position="inside">-->
       <xpath expr="//div[contains(@t-attf-class, 'header')]/div[@class='row']" position="inside">
        <div class="col-6 text-end"
             t-if="doc_model == 'xe.marksheet.line' and company.company_details">
            <span t-field="company.company_details"/>
        </div>
    </xpath>

</template>
    <template id="report_combine_marksheetline_report">
        <style>
            .font{
            font-size:14px;
            font-family:"Helvetica"
            }
            @page{
            size: A4;
            }
        </style>
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="font">
                    <div class="page">
                        <div class="row">
                            <div class="col-6" style="font-size: 14px;">
                                <b>Student Name:</b>
                                <span t-out="'%s' % get_lines['student']"/>
                            </div>
                            <div class="col-6" style="font-size: 14px;">
                                <b>Admission Number:</b>
                                <span t-out="'%s' % get_lines['admission_no']"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6" style="font-size: 14px;">
                                <b>Class:</b>
                                <span t-out="'%s' % get_lines['course']"/>
                            </div>
                            <div class="col-6" style="font-size: 14px;">
                                <b>Class Room:</b>
                                <span t-out="'%s' % get_lines['classroom_name']"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6" style="font-size: 14px;">
                                <b>Class Teacher:</b>
                                <span t-out="'%s' % get_lines['classroom_teacher_name']"/>
                            </div>
                            <div class="col-6" style="font-size: 14px;">
                                <b>Head Teacher:</b>
                                <span t-out="'%s' % get_lines['class_teacher_name']"/>
                            </div>
                        </div>
                        <br></br>
                        <table class="table table-sm" style="font-size: 14px;">
                            <tr style="border: 1px solid black;">
                                <th rowspan="3" width="25%" class="text-center" style="border: 1px solid black;">Subject</th>
                                <t t-foreach="get_lines['session_details']" t-as="session_dt">
                                    <t t-set="term_name" t-value="list(session_dt.keys())"/>
                                    <t t-set="term_length" t-value="2*len(session_dt[term_name[0]])"/>
                                    <th class="text-center" t-att-colspan="term_length" style="border: 1px solid black;">
                                        <t t-esc="term_name[0]"/>
                                    </th>
                                </t>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <t t-foreach="get_lines['session_details']" t-as="session_dt">
                                    <t t-set="term_name" t-value="list(session_dt.keys())"/>
                                    <t t-foreach="session_dt[term_name[0]]" t-as="exam_type">
                                        <th class="text-center" t-att-colspan="2" style="border: 1px solid black;">
                                            <t t-esc="exam_type"/>
                                        </th>
                                    </t>
                                </t>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <t t-foreach="get_lines['session']" t-as="session">
                                    <th class="text-center" style="border: 1px solid black;">Obtained Marks</th>
                                    <th class="text-center" style="border: 1px solid black;">Grade</th>
                                </t>
                            </tr>
                            <t t-foreach="get_lines['exam_details']" t-as="detail">
                                <tr style="border: 1px solid black;">
                                    <td class="text-left" style="border: 1px solid black;">
                                        <span t-att-style="'margin-left:15px !important;' if detail['is_child'] else 'margin-left:0px !important'"
                                              t-out="'%s' % detail['exam']"/>
                                    </td>
                                    <t t-foreach="get_lines['session']" t-as="session">
                                        <td class="text-center" style="border: 1px solid black;">
                                            <span t-out="'%s' % detail['obtained_marks_' + str(session)] if 'obtained_marks_' + str(session) in detail else ''"/>
                                        </td>
                                        <td class="text-center" style="border: 1px solid black;">
                                            <span t-out="'%s' %  detail['grade_'+ str(session)] if 'grade_'+ str(session) in  detail else ''"
                                                  t-att-style="'display:none;' if detail['hide_grade'] else ''"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                            <tr style="border: 1px solid black;">
                                <td width="25%" style="border: 1px solid black;">
                                    <strong>
                                        Total Marks
                                    </strong>
                                </td>
                                <t t-foreach="get_lines['session']" t-as="session">
                                    <td class="text-center" style="border: 1px solid black;">
                                        <strong>
                                            <t t-out="'%s'% get_lines['mlt_sessions_total'][session]['obtained_marks_' + str(session)]"/>
                                        </strong>
                                    </td>
                                    <td/>
                                </t>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <td width="25%" style="border: 1px solid black;">
                                    <strong>
                                        Average
                                    </strong>
                                </td>
                                <t t-foreach="get_lines['session']" t-as="session">
                                    <td class="text-center" style="border: 1px solid black;">
                                        <strong>
                                            <t t-out="'%s'% get_lines['mlt_sessions_total'][session]['avg_marks_' + str(session)]"/>
                                        </strong>
                                    </td>
                                    <td/>
                                </t>
                            </tr>
                        </table>
                        <div class="container" style="page-break-before: auto;">
                            <div class="row" style="display: inline;page-break-before: auto; font-size: 14px;">
                                <div style="text-decoration: underline;">Comments:</div>
                                <div>
                                    <span t-out="get_lines['session_details'][0]['teacher_comment']"/>
                                </div>
                            </div>
                            <br></br>
                        </div>
                        <div class="container" style="page-break-before: auto;">
                            <div class="row" style="page-break-before: auto;">
                                <div style="font-size: 14px;" class="col-4">Class Teacher Signature:
                                    <br></br>
                                    <t t-if="get_lines['teacher_signature']">
                                        <img class="image"
                                             t-attf-src="data:image/png;base64,#{ get_lines['teacher_signature'] }"
                                             style="max-height: 250px; max-width: 250px; margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px;"/>
                                    </t>
                                </div>
                                <div style="font-size: 14px;" class="col-4">Head Teacher Signature:
                                    <br></br>
                                    <t t-if="get_lines['head_teacher_signature']">
                                        <img class="image"
                                             t-attf-src="data:image/png;base64,#{ get_lines['head_teacher_signature'] }"
                                             style="max-height: 250px; max-width: 250px; margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px;"/>
                                    </t>
                                </div>
                                <div class="col-4">
                                    <div style="font-size: 14px">Closing Date of Term:
                                        <span t-out="get_lines['term_end_date']"/>
                                    </div>
                                    <div style="font-size: 14px">Opening Date of Term:
                                        <span t-out="get_lines['opening_next_term_date']"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>