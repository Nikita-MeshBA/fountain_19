<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_marksheetline_report">
        <style>
            .font{
            font-size:14px;
            font-family:"Helvetica"
            }
            @page{
            size: A4;
            }
        </style>
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="font">
                    <div class="page">
                        <t t-if="get_lines['evaluation_type'] == 'normal'">
                            <div class="row" style="margin-top: -40px; font-size: 16px;">
                                <div class="col-6">
                                    <b>Admission Number: </b><span t-out="'%s' % get_lines['admission_no']"/>
                                </div>
                                <div class="col-6" style="font-size: 16px;">
                                    <b>Student Name: </b><span t-out="'%s' % get_lines['student']"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6" style="font-size: 16px;">
                                    <b>Class: </b><span t-out="'%s' % get_lines['course']"/>
                                </div>
                                <div class="col-6" style="font-size: 16px;">
                                    <b>Class Room: </b><span t-out="'%s' % get_lines['classroom_name']"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6" style="font-size: 16px;">
                                    <b>Exam Name: </b><span t-out="'%s' % get_lines['exam_session']"/>
                                </div>
                            </div>
                            <br></br>
                            <table class="table table-bordered table-sm">
                                <tr style="border: 1px solid black;">
                                    <th style="border: 1px solid black;" class="text-center">Subject</th>
                                    <th style="border: 1px solid black;" class="text-center">Obtained Marks</th>
                                    <th style="border: 1px solid black;" class="text-center">Grade</th>
                                </tr>
                                <t t-foreach="get_lines['exam_details']" t-as="detail">
                                    <tr style="border: 1px solid black;">
                                        <td style="border: 1px solid black;" class="text-left">
                                            <span t-att-style="'margin-left:15px !important;' if detail['is_child'] else 'margin-left:0px !important'"
                                                  t-out="'%s' % detail['exam']"/>
                                        </td>
                                        <td style="border: 1px solid black;" class="text-center">
                                            <span t-out="'%s' % detail['obtained_marks']"/>
                                        </td>
                                        <td style="border: 1px solid black;" class="text-center">
                                            <span t-out="'%s' %  detail['grade']"
                                                  t-att-style="'display:none;' if detail['hide_grade'] else ''"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                            <table class="table table-bordered table-sm">
                                <tr style="border: 1px solid black;">
                                    <th style="border: 1px solid black;" class="text-center">Month/Year of Passing</th>
                                    <th style="border: 1px solid black;" class="text-center">Obtained Percentage/Total Percentage</th>
                                    <th style="border: 1px solid black;" class="text-center">Percentage</th>
                                    <th style="border: 1px solid black;" class="text-center">Average Grade</th>
                                </tr>
                                <tr style="border: 1px solid black;">
                                    <td style="border: 1px solid black;" class="text-center">
                                        <span t-out="'%s' % get_lines['date']"/>
                                    </td>
                                    <td style="border: 1px solid black;" class="text-center">
                                        <span t-out="'%s' % get_lines['total_obtained_marks']"/>
                                        /
                                        <span t-out="'%s' % get_lines['total_marks']"/>
                                    </td>
                                    <td style="border: 1px solid black;" class="text-center">
                                        <span t-out="'%s' % get_lines['total_percentage']"/>
                                        %
                                    </td>
                                    <td style="border: 1px solid black;" class="text-center">
                                        <span t-out="'%s' % get_lines['avg_grade']"/>
                                    </td>
                                </tr>
                            </table>
                            <div class="container" style="page-break-before: auto;">
                                <div class="row" style="display: inline;page-break-before: auto; font-size: 16px;">
                                    <div style="text-decoration: underline;">Comments:</div>
                                    <div>
                                        <span t-out="get_lines['head_master_comment']"/>
                                    </div>
                                </div>
                                <br></br>
                            </div>
                            <div class="container" style="page-break-before: auto;">
                                <div class="row" style="page-break-before: auto;">
                                    <div style="font-size: 16px;" class="col-4">Class Teacher Signature:
                                        <br></br>
                                        <t t-if="get_lines['teacher_signature']">
                                            <img class="image"
                                                 t-attf-src="data:image/png;base64,#{ get_lines['teacher_signature'] }"
                                                 style="max-height: 250px; max-width: 250px; margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px;"/>
                                        </t>
                                    </div>
                                    <div style="font-size: 16px;" class="col-4">Head Teacher Signature:
                                        <br></br>
                                        <t t-if="get_lines['head_teacher_signature']">
                                            <img class="image"
                                                 t-attf-src="data:image/png;base64,#{ get_lines['head_teacher_signature'] }"
                                                 style="max-height: 250px; max-width: 250px; margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px;"/>
                                        </t>
                                    </div>
                                    <div class="col-4">
                                        <div style="font-size: 16px">Closing Date of Term:
                                            <span t-out="get_lines['term_end_date']"/>
                                        </div>
                                        <div style="font-size: 16px">Opening Date of Term:
                                            <span t-out="get_lines['opening_next_term_date']"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-if="get_lines['evaluation_type'] == 'grade'">
                            <div class="row" style="margin-top: -40px; font-size: 16px;">
                                <div class="col-6" style="font-size: 16px;">
                                    <b>Student Name: </b><span t-out="'%s' % get_lines['student']"/>
                                </div>
                                <div class="col-6" style="font-size: 16px;">
                                    <b>Class: </b><span t-out="'%s' % get_lines['course']"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6" style="font-size: 16px;">
                                    <b>Exam Name: </b><span t-out="'%s' % get_lines['exam_session']"/>
                                </div>
                            </div>
                            <br/>
                            <table class="table table-bordered table-sm">
                                <tr style="border: 1px solid black;">
                                    <th style="border: 1px solid black;" class="text-center">Subject</th>
                                    <th style="border: 1px solid black;" class="text-center">Exam Type</th>
                                    <th style="border: 1px solid black;" class="text-center">Grade</th>
                                    <th style="border: 1px solid black;" class="text-center">Absent</th>
                                </tr>
                                <t t-foreach="get_lines['exam_details']" t-as="detail">
                                    <tr style="border: 1px solid black;">
                                        <td style="border: 1px solid black;" class="text-left">
                                            <span t-out="'%s' % detail['exam']"/>
                                        </td>
                                        <td style="border: 1px solid black;" class="text-left">
                                            <span t-out="'%s' % detail['exam_type']"/>
                                        </td>
                                        <td style="border: 1px solid black;" class="text-center">
                                            <span t-out="'%s' % detail['grade']"/>
                                        </td>
                                        <td style="border: 1px solid black;" class="text-center">
                                            <span t-out="'%s' % 'P' if detail['obtained_marks'] &gt; 0 else 'A'"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                            <table class="table table-bordered table-sm">
                                <tr style="border: 1px solid black;">
                                    <th style="border: 1px solid black;" class="text-center">Month/Year of Passing</th>
                                    <th style="border: 1px solid black;" class="text-center">Obtained Grade</th>
                                    <th style="border: 1px solid black;" class="text-center">Percentage</th>
                                    <th style="border: 1px solid black;" class="text-center">Result</th>
                                </tr>
                                <tr style="border: 1px solid black;">
                                    <td style="border: 1px solid black;" class="text-center">
                                        <span t-out="'%s' % get_lines['date']"/>
                                    </td>
                                    <td style="border: 1px solid black;" class="text-center">
                                        <span t-out="'%s' % get_lines['total_grade']"/>
                                    </td>
                                    <td style="border: 1px solid black;" class="text-center">
                                        <span t-out="'%s' % get_lines['total_percentage']"/>
                                        %
                                    </td>
                                    <td style="border: 1px solid black;" class="text-center">
                                        <span t-out="'%s' % get_lines['total_status']"/>
                                    </td>
                                </tr>
                            </table>
                            <div class="container" style="page-break-before: auto;">
                                <div class="row" style="display: inline;page-break-before: auto; font-size: 16px;">
                                    <div style="text-decoration: underline;">Comments:</div>
                                    <div>
                                        <span t-out="get_lines['head_master_comment']"/>
                                    </div>
                                </div>
                                <br></br>
                            </div>
                            <div class="container" style="page-break-before: auto;">
                                <div class="row" style="page-break-before: auto;">
                                    <div style="font-size: 16px;" class="col-4">Class Teacher Signature:
                                        <br></br>
                                        <t t-if="get_lines['teacher_signature']">
                                            <img class="image"
                                                 t-attf-src="data:image/png;base64,#{ get_lines['teacher_signature'] }"
                                                 style="max-height: 250px; max-width: 250px; margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px;"/>
                                        </t>
                                    </div>
                                    <div style="font-size: 16px;" class="col-4">Head Teacher Signature:
                                        <br></br>
                                        <t t-if="get_lines['head_teacher_signature']">
                                            <img class="image"
                                                 t-attf-src="data:image/png;base64,#{ get_lines['head_teacher_signature'] }"
                                                 style="max-height: 250px; max-width: 250px; margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px;"/>
                                        </t>
                                    </div>
                                    <div class="col-4">
                                        <div style="font-size: 16px">Closing Date of Term:
                                            <span t-out="get_lines['term_end_date']"/>
                                        </div>
                                        <div style="font-size: 16px">Opening Date of Term:
                                            <span t-out="get_lines['opening_next_term_date']"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>

