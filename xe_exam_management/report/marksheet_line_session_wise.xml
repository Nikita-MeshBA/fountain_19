<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="session_wise_mark_line">
        <style>
            .font{
            font-size:14px;
            font-family:"Helvetica"
            }
            @page{
            margin-top:1%;
            size: A4;
            }
        </style>
        <t t-call="web.html_container">
            <t t-call="xe_exam_management.marksheet_report_external_layout">
                <div class="font">
                    <div class="page">
                        <br/>
                        <t t-foreach="data_line" t-as="obj">
                            <t t-if="obj">
                                <div class="row"
                                     style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 16px;text-align:left !important;">
                                    <div class="col-3">
                                        <b>Admission Number:</b>
                                        <span t-esc="obj['admission_number']"/>
                                    </div>
                                    <div class="col-3">
                                        <b>Name:</b>
                                        <span t-esc="obj['student_name']"/>
                                    </div>
                                    <div class="col-3">
                                        <b>Grade:</b>
                                        <span t-esc="obj['course_name']"/>
                                    </div>
                                    <div class="col-3">
                                        <b>Term:</b>
                                        <span t-esc="obj['academic_term']"/>
                                    </div>
                                </div>
                                <br/>
                                <div class="row"
                                     style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 16px;text-align:center !important;">
                                    <div class="col-12">
                                        <h3 align="left">
                                            <strong>
                                                <span t-esc="obj['term']"/>
                                            </strong>
                                        </h3>
                                    </div>
                                </div>
                                <br/>
                                <table class="table table-bordered table-sm"
                                       style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 16px;text-align:center !important;">
                                    <tr style="border: 1px solid black;">
                                        <t t-foreach="header_data" t-as="h_data">
                                            <th class="text-center" style="border: 1px solid black;">
                                                <span t-esc="h_data"/>
                                            </th>
                                        </t>
                                    </tr>
                                    <t t-foreach="obj['result_line']" t-as="line">
                                        <tr style="border: 1px solid black;">
                                            <td class="text-left" style="border: 1px solid black;">
                                                <span t-esc="line['LEARNING AREA']"/>
                                            </td>
                                            <t t-foreach="header_data" t-as="h_data">
                                                <t t-if="h_data in line">
                                                    <t t-if="h_data == 'MARKS'">
                                                        <td class="text-left" style="border: 1px solid black;">
                                                            <span t-esc="line.get('MARKS')"/>
                                                        </td>
                                                    </t>
                                                    <t t-if="h_data != 'LEARNING AREA' and h_data != 'MARKS'">
                                                        <td class="text-left" style="border: 1px solid black;">
                                                            <input type="checkbox" id="checkbox_EE"
                                                                   checked="checked"/>
                                                        </td>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <td style="border: 1px solid black;"/>
                                                </t>
                                            </t>
                                        </tr>
                                    </t>
                                </table>
                                <br/>
                                <table class="table table-bordered table-sm"
                                       style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 16px;text-align:center !important;">
                                    <tr style="border: 1px solid black;">
                                        <t t-foreach="point_lines" t-as="point_head">
                                            <th class="text-center" style="border: 1px solid black;">
                                                <span t-esc="point_head"/>
                                            </th>
                                        </t>
                                    </tr>
                                    <tr style="border: 1px solid black;">
                                        <t t-foreach="point_lines" t-as="point_head">
                                            <td class="text-center" style="border: 1px solid black;">
                                                <span t-esc="point_lines[point_head]"/>
                                            </td>
                                        </t>
                                    </tr>
                                </table>
