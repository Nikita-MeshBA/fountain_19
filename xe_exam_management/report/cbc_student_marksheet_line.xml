<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="cbc_mark_line_rep">
        <style>
            .font{
            font-size:14px;
            font-family:"Helvetica"
            }
            @page{
            margin-top:10%;
            size: A4;
            }
        </style>
        <t t-call="web.html_container">
            <t t-call="xe_exam_management.marksheet_report_external_layout">
                <div class="font">
                    <div class="page">
                        <t t-if="get_lines['evaluation_type'] in ['1-3 CBC']">
                            <div class="container"
                                 style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 16px;text-align:left !important;">
                                <div class="row">
                                    <div class="col-4">
                                        <b>Pupil Name:</b>
                                        <span t-out="'%s' %  get_lines['student']"/>
                                    </div>
                                    <div class="col-4">
                                        <b>Admission No:</b>
                                        <span t-out="'%s' % get_lines['admission_no']"/>
                                    </div>
                                    <div class="col-4">
                                        <b>Classroom:</b>
                                        <span t-out="'%s' % get_lines['classroom_name']"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4">
                                        <b>Class Teacher:</b>
                                        <span t-out="'%s' %  get_lines['classroom_teacher_name']"/>
                                    </div>
                                    <div class="col-4">
                                        <b>Head Teacher:</b>
                                        <span t-out="'%s' % get_lines['class_teacher_name']"/>
                                    </div>
                                    <div class="col-4">
                                        <b>Academic Year:</b>
                                        <span t-out="'%s' % get_lines['academic_year_id']"/>
                                    </div>
                                </div>
                            </div>
                            <br></br>
                            <div class="row"
                                 style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 16px;text-align:center !important;">
                                <div class="col-12">
                                    <h3 align="center">
                                        <strong>
                                            <span t-esc="'%s %s' % (get_lines['academic_term'] ,get_lines['term'])"/>
                                        </strong>
                                    </h3>
                                </div>
                            </div>
                            <br/>
                            <table class="table table-bordered table-sm"
                                   style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 16px;text-align:center !important; border: 1px solid black;">
                                <tr>
                                    <th style="border: 1px solid black;" class="text-center">LEARNING AREA</th>
                                    <t t-if="get_lines['show_marks']">
                                        <th style="border: 1px solid black;" class="text-center">MARKS</th>
                                    </t>
                                    <t t-foreach="get_lines['rubrics_details']" t-as="rubric">
                                        <th style="border: 1px solid black;" class="text-center">
                                            <span t-out="'%s' % rubric.name.upper()"/>
                                        </th>
                                    </t>
                                </tr>
                                <t t-set="rubric_list" t-value="get_lines['rubrics_details'].mapped('name')"/>
                                <t t-foreach="get_lines['exam_details']" t-as="detail">
                                    <tr style="border: 1px solid black;">
                                        <td style="border: 1px solid black;" class="text-left">
                                            <span t-out="'%s' % detail['exam']"/>
                                        </td>
                                        <t t-if="get_lines['show_marks']">
                                            <td style="border: 1px solid black;" class="text-left">
                                                <span t-out="'%s' % detail['obtained_marks']"/>
                                            </td>
                                        </t>
                                        <t t-foreach="rubric_list" t-as="r">
                                            <td style="border: 1px solid black;">
                                                <t t-if="detail.get(r)">
                                                    <input type="checkbox" checked="checked"/>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </table>
                            <table class="table table-bordered table-sm"
                                   style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 16px;text-align:center !important; border: 1px solid black;">
                                <tr style="border: 1px solid black;">
                                    <t t-foreach="get_lines['rubrics_details']" t-as="rubric">
                                        <th style="border: 1px solid black;" class="text-center">
                                            <span t-out="'%s' % rubric.name"/>
                                        </th>
                                    </t>
                                </tr>
                                <tr style="border: 1px solid black;">
                                    <t t-foreach="get_lines['rubrics_details']" t-as="rubric">
                                        <td style="border: 1px solid black;" class="text-center"><span
                                                t-out="'%s' % rubric.min_per"/>-
                                            <span t-out="'%s' % rubric.max_per"/>
                                        </td>
                                    </t>
                                </tr>
                            </table>
                            <br></br>
                            <div class="container" style="page-break-before: auto;">
                                <div class="row" style="display: inline;page-break-before: auto; font-size: 16px;">
                                    <div style="text-decoration: underline;">Comments:</div>
                                    <div>
                                        <span t-out="get_lines['head_master_comment']"/>
                                    </div>
                                </div>
                            </div>
                            <br></br>
                            <div class="container" style="page-break-before: auto;">
                                <div class="row" style="page-break-before: auto;">
                                    <div style="font-size: 16px;" class="col-4">Class Teacher Signature:
                                        <br></br>
                                        <t t-if="get_lines['teacher_signature']">
                                            <img class="image"
                                                 t-attf-src="data:image/png;base64,#{ get_lines['teacher_signature'] }"
                                                 style="max-height: 250px; max-width: 250px; margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px;"/>
                                        </t>
                                    </div>
                                    <div style="font-size: 16px;" class="col-4">Head Teacher Signature:
                                        <br></br>
                                        <t t-if="get_lines['head_teacher_signature']">
                                            <img class="image"
                                                 t-attf-src="data:image/png;base64,#{ get_lines['head_teacher_signature'] }"
                                                 style="max-height: 250px; max-width: 250px; margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px;"/>
                                        </t>
                                    </div>
                                    <div class="col-4">
                                        <div style="font-size: 16px">Closing Date of Term:
                                            <span t-out="get_lines['term_end_date']"/>
                                        </div>
                                        <div style="font-size: 16px">Opening Date of Term:
                                            <span t-out="get_lines['opening_next_term_date']"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <p style="page-break-after: always;"/>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>