<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_xe_exam_type_tree" model="ir.ui.view">
        <field name="name">xe.exam.type.tree</field>
        <field name="model">xe.exam.type</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Exam Type" editable="bottom">
                <field name="name" required="1"/>
                <field name="code"/>
                <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
