<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_xe_result_template_tree" model="ir.ui.view">
        <field name="name">xe.result.template.tree</field>
        <field name="model">xe.result.template</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Result Template">
                <field name="name"/>
                <field name="exam_session_id"/>
                <field name="result_date"/>
            </list>
        </field>
    </record>

    <record id="view_xe_result_template_form" model="ir.ui.view">
        <field name="name">xe.result.template.form</field>
        <field name="model">xe.result.template</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Result Template">
                <header>
                    <button string="Generate Result" type="object" invisible="state not in ['draft']"
                            name="generate_result"
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,result_generated"/>
                </header>
                <sheet>
                    <group colspan="4" col="4">
                        <field name="name" select="1"/>
                        <field name="result_date"/>
                        <field name="exam_session_id"/>
                        <field name="evaluation_type" invisible="1"/>
                        <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                    </group>
                    <separator string="Grades" colspan="4" invisible="evaluation_type != 'grade'"/>
                    <field name="grade_ids" colspan="4" nolabel="1"
                           invisible="evaluation_type != 'grade'" required="evaluation_type == 'grade'"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_xe_result_template_search" model="ir.ui.view">
        <field name="name">xe.result.template.search</field>
        <field name="model">xe.result.template</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Result Template">
                <field name="name" select="True"/>
                <field name="exam_session_id"/>
                <field name="result_date" select="True"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_open_xe_result_template_view">
        <field name="name">Result Templates</field>
        <field name="res_model">xe.result.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_xe_result_template_search"/>
    </record>

    <record model="ir.actions.act_window.view" id="act_open_xe_result_template_view_form">
        <field name="act_window_id" ref="act_open_xe_result_template_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_xe_result_template_form"/>
    </record>

    <record model="ir.actions.act_window.view" id="act_open_xe_result_template_view_tree">
        <field name="act_window_id" ref="act_open_xe_result_template_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_xe_result_template_tree"/>
    </record>
</odoo>
