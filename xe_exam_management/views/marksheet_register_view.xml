<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_xe_marksheet_register_tree" model="ir.ui.view">
        <field name="name">xe.marksheet.register.tree</field>
        <field name="model">xe.marksheet.register</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Marksheet Register">
                <field name="exam_session_id"/>
                <field name="generated_date"/>
                <field name="generated_by_id"/>
                <field name="state" invisible="1"/>
                <field name="evaluation_type" invisible="1"/>
                <field name="total_pass" invisible="evaluation_type == '1-3 CBC'"/>
                <field name="total_failed" invisible="evaluation_type == '1-3 CBC'"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_xe_marksheet_register_form" model="ir.ui.view">
        <field name="name">xe.marksheet.register.form</field>
        <field name="model">xe.marksheet.register</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Marksheet Register">
                <header>
                    <button name="action_send_email" string="Send by Email" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,cancelled" invisible="1"/>
                </header>
                <sheet>
                    <group colspan="4" col="4">
                        <field name="name"/>
                        <field name="exam_session_id"/>
                        <field name="generated_by_id"/>
                        <field name="generated_date"/>
                        <field name="total_pass" invisible="evaluation_type == '1-3 CBC'"/>
                        <field name="total_failed" invisible="evaluation_type == '1-3 CBC'"/>
                        <field name="result_template_id"/>
                        <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                        <field name="evaluation_type" invisible="1"/>
                    </group>
                    <separator string="Marksheets" colspan="4"/>
                    <group colspan="4">
                        <field name="marksheet_line_ids" nolabel="1" readonly="state != 'draft'">
                            <list create="false">
                                <field name="student_id"/>
                                <field name="evaluation_type" invisible="1"/>
                                <field name="total_marks" invisible="parent.evaluation_type == '1-3 CBC'"/>
                                <field name="status" invisible="parent.evaluation_type == '1-3 CBC'"/>
                                <field name="percentage" invisible="parent.evaluation_type == '1-3 CBC'"/>
                                <field name="head_master_comment"/>
                                <field name="extra_curr_comment"/>
                                <field name="head_teacher_comment"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_xe_marksheet_register_search" model="ir.ui.view">
        <field name="name">xe.marksheet.register.search</field>
        <field name="model">xe.marksheet.register</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Marksheet Register">
                <field name="exam_session_id"/>
                <field name="generated_date"/>
                <field name="generated_by_id"/>
                <field name="state"/>
                <field name="total_pass"/>
                <field name="total_failed"/>
                <field name="name"/>
                <newline/>
                <group expand="0" string="Group By...">
                    <filter string="Exam Session" name="exam_session" domain="[]"
                            context="{'group_by':'exam_session_id'}"/>
                    <filter string="Generated By" name="generated_by_id" domain="[]"
                            context="{'group_by':'generated_by_id'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by':'state'}"/>
                    <filter string="Total Pass" name="total_pass" domain="[]" context="{'group_by':'total_pass'}"/>
                    <filter string="Total Fail" name="total_fail" domain="[]" context="{'group_by':'total_failed'}"/>
                    <filter string="Marksheet Register" name="marksheet_register" domain="[]"
                            context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="act_open_xe_marksheet_register_view">
        <field name="name">Marksheet Registers</field>
        <field name="res_model">xe.marksheet.register</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_xe_marksheet_register_search"/>
    </record>
    <record model="ir.actions.act_window.view" id="act_open_xe_marksheet_register_view_form">
        <field name="act_window_id" ref="act_open_xe_marksheet_register_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_xe_marksheet_register_form"/>
    </record>
    <record model="ir.actions.act_window.view" id="act_open_xe_marksheet_register_view_tree">
        <field name="act_window_id" ref="act_open_xe_marksheet_register_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_xe_marksheet_register_tree"/>
    </record>
</odoo>
