<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_xe_rubrics_code_tree" model="ir.ui.view">
        <field name="name">xe.rubrics.code.tree</field>
        <field name="model">xe.rubrics.code</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Rubrics Code" editable="bottom">
                <field name="name" required="1"/>
                <field name="code" required="1"/>
                <field name="points"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_open_xe_rubrics_code_view">
        <field name="name">Rubrics Code</field>
        <field name="res_model">xe.rubrics.code</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_xe_rubrics_code" name="Rubrics Code"
              parent="xe_exam_management.menu_exam_configuration" sequence="40"
              action="act_open_xe_rubrics_code_view"
              groups="xe_exam_management.group_subject_rubrics_configuration"/>
</odoo>