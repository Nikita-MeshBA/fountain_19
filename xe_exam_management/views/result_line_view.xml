<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_xe_result_line_tree" model="ir.ui.view">
        <field name="name">xe.result.line.tree</field>
        <field name="model">xe.result.line</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Result Line">
                <field name="student_id"/>
                <field name="exam_id"/>
                <field name="marks"/>
                <field name="grade" invisible="1"/>
                <field name="status" invisible="evaluation_type == '1-3 CBC'"/>
                <field name="evaluation_type" invisible="1"/>
                <field name="comments"/>
            </list>
        </field>
    </record>
    <record id="view_xe_result_line_form" model="ir.ui.view">
        <field name="name">xe.result.line.form</field>
        <field name="model">xe.result.line</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Result Line">
                <sheet>
                    <group colspan="4" col="4">
                        <field name="student_id"/>
                        <field name="exam_id"/>
                        <field name="marks"/>
                        <field name="comments" invisible="1"/>
                        <field name="evaluation_type" invisible="1"/>
                        <field name="marksheet_line_id" invisible="1"/>
                        <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                        <field name="comments"/>
                        <field name="evaluation_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_xe_result_line_search" model="ir.ui.view">
        <field name="name">xe.result.line.search</field>
        <field name="model">xe.result.line</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Result Line">
                <field name="marksheet_line_id"/>
                <field name="exam_id"/>
                <field name="marks"/>
                <newline/>
                <group expand="0" string="Group By...">
                    <filter string="Marksheet Line" name="marksheet_line" domain="[]"
                            context="{'group_by':'marksheet_line_id'}"/>
                    <filter string="Exam" name="exam" domain="[]" context="{'group_by':'exam_id'}"/>
                    <filter string="Marks" name="marks" domain="[]" context="{'group_by':'marks'}"/>
                    <filter string="Students" name="students" domain="[]" context="{'group_by':'student_id'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="act_open_xe_result_line_view">
        <field name="name">Result Lines</field>
        <field name="res_model">xe.result.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_xe_result_line_search"/>
    </record>
    <record model="ir.actions.act_window.view" id="act_open_xe_result_line_view_form">
        <field name="act_window_id" ref="act_open_xe_result_line_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_xe_result_line_form"/>
    </record>
    <record model="ir.actions.act_window.view" id="act_open_xe_result_line_view_tree">
        <field name="act_window_id" ref="act_open_xe_result_line_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_xe_result_line_tree"/>
    </record>
</odoo>
