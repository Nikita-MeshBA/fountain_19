<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="import_session_rubrics_wizard_form">
        <field name="name">import.session.rubrics.wizard.form</field>
        <field name="model">import.session.rubrics</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_upload" type="object" class="oe_highlight" string="Upload"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>