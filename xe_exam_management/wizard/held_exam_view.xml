<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_xe_held_exam_form" model="ir.ui.view">
        <field name="name">xe.held.exam.form</field>
        <field name="model">xe.held.exam</field>
        <field name="type">form</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Held Exam Wizard">
                <group col="2">
                    <group>
                        <field name="exam_id" invisible="1"/>
                        <field name="subject_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="course_id" readonly="1"/>
                        <field name="academic_term_id" readonly="1"/>
                    </group>
                </group>
                <separator string="Absent Attendees" colspan="4"/>
                <field name="attendees_line_ids" nolabel="1" domain="[('exam_id','=', exam_id)]"/>
                <footer>
                    <button string="Held" class="oe_highlight" type="object" name="held_exam"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_open_xe_held_exam_view">
        <field name="name">Held Exam Wizard</field>
        <field name="res_model">xe.held.exam</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record model="ir.actions.act_window.view" id="act_open_xe_held_exam_view_form">
        <field name="act_window_id" ref="act_open_xe_held_exam_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_xe_held_exam_form"/>
    </record>
</odoo>