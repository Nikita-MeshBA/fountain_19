<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_xe_exam"
            model="ir.module.category">
        <field name="name">Exam</field>
        <field name="description">Helps you to Manage Access Rights</field>
        <field name="sequence">17</field>
    </record>

    <record id="privilege_xe_exam" model="res.groups.privilege">
        <field name="name">Exam</field>
        <field name="category_id" ref="module_category_xe_exam"/>
    </record>

    <record id="group_xe_exam_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_xe_exam"/>
        <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_xe_exam_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="privilege_xe_exam"/>
        <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
        <field name="implied_ids"
               eval="[(4, ref('xe_exam_management.group_xe_exam_user')), (4, ref('base.group_user'))]"/>
        <field name="user_ids"
               eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record model="ir.rule" id="exam_session_user_rule">
        <field name="name">Exam Session -User Rule</field>
        <field name="model_id" ref="model_xe_exam_session"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_user'))]"/>
        <field name="domain_force">[('exam_ids.staff_id.user_id','in',user.ids)]</field>
    </record>
    <record model="ir.rule" id="exam_session_admin_rule">
        <field name="name">Exam Session-Admin Rule</field>
        <field name="model_id" ref="model_xe_exam_session"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <record model="ir.rule" id="exam_user_rule">
        <field name="name">Exam -User Rule</field>
        <field name="model_id" ref="model_xe_exam"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_user'))]"/>
        <field name="domain_force">[('staff_id.user_id','in',user.ids)]</field>
    </record>
    <record model="ir.rule" id="exam_admin_rule">
        <field name="name">Exam -Admin Rule</field>
        <field name="model_id" ref="model_xe_exam"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <record model="ir.rule" id="exam_attendee_user_rule">
        <field name="name">Exam Attendees -User Rule</field>
        <field name="model_id" ref="model_xe_exam_attendees"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_user'))]"/>
        <field name="domain_force">[('exam_id.staff_id.user_id','in',user.ids)]</field>
    </record>
    <record model="ir.rule" id="exam_attendeed_admin_rule">
        <field name="name">Exam Attendee -Admin Rule</field>
        <field name="model_id" ref="model_xe_exam_attendees"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <record model="ir.rule" id="marksheet_register_user_rule">
        <field name="name">Marksheet Register -User Rule</field>
        <field name="model_id" ref="model_xe_marksheet_register"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_user'))]"/>
        <field name="domain_force">[('exam_session_id.exam_ids.staff_id.user_id','in',user.ids)]</field>
    </record>
    <record model="ir.rule" id="marksheet_register_admin_rule">
        <field name="name">Marksheet Register -Admin Rule</field>
        <field name="model_id" ref="model_xe_marksheet_register"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <record model="ir.rule" id="result_line_user_rule">
        <field name="name">Result Line -User Rule</field>
        <field name="model_id" ref="model_xe_result_line"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_user'))]"/>
        <field name="domain_force">[('exam_id.staff_id.user_id','in',user.ids)]</field>
    </record>
    <record model="ir.rule" id="result_line_admin_rule">
        <field name="name">Result Line -Admin Rule</field>
        <field name="model_id" ref="model_xe_result_line"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <record model="ir.rule" id="result_templ_user_rule">
        <field name="name">Result Template -User Rule</field>
        <field name="model_id" ref="model_xe_result_template"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_user'))]"/>
        <field name="domain_force">[('exam_session_id.exam_ids.staff_id.user_id','in',user.ids)]</field>
    </record>
    <record model="ir.rule" id="result_templ_admin_rule">
        <field name="name">Result Template -Admin Rule</field>
        <field name="model_id" ref="model_xe_result_template"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>
    <record model="ir.rule" id="marksheet_line_user_rule">
        <field name="name">Marksheet Line -User Rule</field>
        <field name="model_id" ref="model_xe_marksheet_line"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_user'))]"/>
        <field name="domain_force">user.get_marksheet_lines()</field>
    </record>
    <record model="ir.rule" id="marksheet_line_admin_rule">
        <field name="name">Marksheet Line -Admin Rule</field>
        <field name="model_id" ref="model_xe_marksheet_line"/>
        <field name="groups" eval="[(4, ref('xe_exam_management.group_xe_exam_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <record id="group_rubrics_configurations" model="res.groups">
        <field name="name">Manage Rubrics Configuration(Default)</field>
    </record>
    <record id="group_subject_rubrics_configuration" model="res.groups">
        <field name="name">Manage Subject Wise Rubrics Configuration</field>
    </record>

</odoo>
