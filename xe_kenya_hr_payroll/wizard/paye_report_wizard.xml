<odoo>
    <record model="ir.ui.view" id="paye_report_wizard">
        <field name="name">PAYE Report</field>
        <field name="model">paye.report.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="PAYE Report">
                <group>
                    <group>
                        <field name="date_start"/>
                    </group>
                    <group>
                        <field name="date_end"/>
                    </group>
                </group>
                <footer>

                    <button name="get_xlsx_report" string="Get Excel Report" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_paye_report_wizard" model="ir.actions.act_window">
        <field name="name">PAYE Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">paye.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem action="action_paye_report_wizard"
              id="menu_paye_report_wizard"
              parent="payroll_report"
              sequence="202"/>
</odoo>
