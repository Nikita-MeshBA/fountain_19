<odoo>
    <record model="ir.ui.view" id="shif_deduction_report_wizard">
        <field name="name">SHIF Deduction Report</field>
        <field name="model">shif.deduction.report.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="month" required="1"/>
                    </group>
                    <group>
                        <field name="year" required="1"/>
                    </group>
                </group>
                <footer>
                    <button name="get_xlsx_report" string="Get Report" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shif_deduction_report_wizard" model="ir.actions.act_window">
        <field name="name">SHIF Deduction Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">shif.deduction.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem action="action_shif_deduction_report_wizard" name="SHIF Deduction Report" id="menu_shif_deduction_report_wizard" parent="xe_kenya_hr_payroll.payroll_report" sequence="306"/>
</odoo>
