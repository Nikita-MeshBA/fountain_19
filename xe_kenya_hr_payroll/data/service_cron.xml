<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_contract_expiry" model="ir.cron">
            <field name="name">Contract Expiry Cron</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
<!--            <field name="numbercall">-1</field>-->
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=2, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
<!--            <field name="doall" eval="False"/>-->
<!--            <field name="model_id" ref="model_hr_contract"/>-->
            <field name="model_id" ref="hr.model_hr_version"/>
            <field name="code">model._expiry_contract_notification()</field>
            <field name="state">code</field>
        </record>

        <record forcecreate="True" id="send_email_kenya_action" model="ir.actions.server">
            <field name="name">Send Email</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="state">code</field>
            <field name="code">model.send_email_tree()</field>
            <field name="binding_model_id" ref="model_hr_payslip"/>
        </record>

        <record id="ir_cron_visa_expiry" model="ir.cron">
            <field name="name">Visa Expiry Cron</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
<!--            <field name="numbercall">-1</field>-->
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=4, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
<!--            <field name="doall" eval="False"/>-->
            <field name="model_id" ref="model_hr_employee"/>
            <field name="code">model._expiry_visa_notification()</field>
            <field name="state">code</field>
        </record>
    </data>
</odoo>
