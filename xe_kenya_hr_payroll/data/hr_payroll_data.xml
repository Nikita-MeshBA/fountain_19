            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
range_list = [
    {'range': range(0, 5999), 'amount': 150},
    {'range': range(6000, 7999), 'amount': 300},
    {'range': range(8000, 11999), 'amount': 400},
    {'range': range(12000, 14999), 'amount': 500},
    {'range': range(15000, 19999), 'amount': 600},
    {'range': range(20000, 24999), 'amount': 750},
    {'range': range(25000, 29999), 'amount': 850},
    {'range': range(30000, 34999), 'amount': 900},
    {'range': range(35000, 39999), 'amount': 950},
    {'range': range(40000, 44999), 'amount': 1000},
    {'range': range(45000, 49999), 'amount': 1100},
    {'range': range(50000, 59999), 'amount': 1200},
    {'range': range(60000, 69999), 'amount': 1300},
    {'range': range(70000, 79999), 'amount': 1400},
    {'range': range(80000, 89999), 'amount': 1500},
    {'range': range(90000, 99999), 'amount': 1600}
]
GROSS = int(round(categories.GROSS))
for item in range_list:
    if GROSS in item['range']:
        result = item['amount']
    elif GROSS not in item['range'] and GROSS > 100000:
        result = 1700
        </field>
        </record>

