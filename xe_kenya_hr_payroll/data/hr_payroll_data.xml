        <record id="hr_rule_PAYE" model="hr.salary.rule">
            <field name="name">PAYE</field>
            <field name="sequence" eval="102"/>
            <field name="code">PAYE</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
range_list = [{'range': range(0, 24000), 'percentage': 0.10, 'amount': 0},
{'range': range(24001, 32334), 'percentage': 0.25, 'amount': 2400}]
TS = int(round(categories.TS))
for item in range_list:
    if TS in item['range']:
        value = TS - (item['range'][0] >
                      0 and (item['range'][0] - 1) or item['range'][0])
        value1 = value * item['percentage']
        result = value1 + item['amount']
    elif TS not in item['range'] and TS > 32333:
        value = TS - 32333
        value1 = value * 0.30
        result = value1 + 4483.25
if TS > 23999.99:
    result = result - contract.monthly_personal_relief - (0.15 * contract.monthly_medical_insurance) - contract.insurance_premium - contract.monthly_insurance_relief
else:
    result = 0
</field>
