            <field name="sequence" eval="8"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
if contract.payroll_type == '13_month':
    result = payslip.work_perc*(contract.house_bonus/13)
else:
    result = payslip.work_perc*(contract.house_bonus/12)
        </field>
