        <record id="hr_rule_TC" model="hr.salary.rule">
            <field name="name">Tax Charged</field>
            <field name="sequence" eval="101"/>
            <field name="code">TC</field>
            <field name="category_id" ref="xe_kenya_hr_payroll.TC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
range_list = [
    {'range': range(0, 24000), 'percentage': 0.10, 'amount': 0},
    {'range': range(24001, 32333), 'percentage': 0.25, 'amount': 2400}]
TS = int(round(categories.TS))
for item in range_list:
    if TS in item['range']:
        value = TS - (item['range'][0] >
                      0 and (item['range'][0] - 1) or item['range'][0])
        value1 = value * item['percentage']
        result = value1 + item['amount']
    elif TS not in item['range'] and TS > 32333:
        value = TS - 32333
        value1 = value * 0.30
        result = value1 + 4483
if TS &lt;23999.99 or TS == 23999.99:
    result = 0
else:
    result = result
        </field>
        </record>

