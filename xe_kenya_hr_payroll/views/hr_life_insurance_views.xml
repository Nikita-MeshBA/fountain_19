<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_life_insurance_tree" model="ir.ui.view">
        <field name="name">hr.life.insurance.tree</field>
        <field name="model">hr.life.insurance</field>
        <field name="type">list</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Life Insurance">
                <field name="employee_id" invisible="1"/>
                <field name="name"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount"/>
                <field name="duration"/>
                <field name="amount_premium"/>
                <field name="deduction_applied"/>
            </list>
        </field>
    </record>

    <record id="view_hr_life_insurance_form" model="ir.ui.view">
        <field name="name">hr.life.insurance.form</field>
        <field name="model">hr.life.insurance</field>
        <field name="type">form</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Life Insurance">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Name" required="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="amount" required="1"/>
                            <field name="amount_premium"/>
                        </group>
                        <group>
                            <field name="duration" required="1"/>
                            <field name="deduction_applied" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="employee_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_life_insurance_search" model="ir.ui.view">
        <field name="name">hr.life.insurance.search</field>
        <field name="model">hr.life.insurance</field>
        <field name="type">search</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Life Insurance">
                <field name="name" select="True"/>
            </search>
        </field>
    </record>

    <record id="act_open_hr_life_insurance_view" model="ir.actions.act_window">
        <field name="name">Life Insurance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.life.insurance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_life_insurance_search"/>
        <field name="context">{}</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Life Insurance
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_life_insurance"
              parent="hr.menu_human_resources_configuration"
              sequence="5"
              action="act_open_hr_life_insurance_view"
              groups="base.group_no_one"/>

</odoo>