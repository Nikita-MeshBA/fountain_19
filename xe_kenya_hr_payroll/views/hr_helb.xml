<odoo>
    <record id="view_hr_helb_tree" model="ir.ui.view">
        <field name="name">hr.helb.tree</field>
        <field name="model">hr.helb</field>
        <field name="type">list</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Higher Education Loan Board">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount"/>
                <field name="duration"/>
                <field name="amount_deduct"/>
                <field name="deduction_applied"/>
            </list>
        </field>
    </record>

    <record id="view_hr_helb_form" model="ir.ui.view">
        <field name="name">hr.helb.form</field>
        <field name="model">hr.helb</field>
        <field name="type">form</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Higher Education Loan Board">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Name"
                                   required="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="amount" required="1"/>
                            <field name="amount_deduct"/>
                        </group>
                        <group>
                            <field name="duration" required="1"/>
                            <field name="deduction_applied" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_helb_search" model="ir.ui.view">
        <field name="name">hr.helb.search</field>
        <field name="model">hr.helb</field>
        <field name="type">search</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Higher Education Loan Board">
                <field name="name" select="True"/>
            </search>
        </field>
    </record>

    <record id="act_open_hr_helb_view" model="ir.actions.act_window">
        <field name="name">Higher Education Loan Board</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.helb</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_helb_search"/>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_hr_helb"
              parent="hr.menu_human_resources_configuration"
              sequence="6"
              action="act_open_hr_helb_view"
              groups="base.group_no_one"/>
</odoo>