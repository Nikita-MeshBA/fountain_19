<odoo>
    <record model="ir.ui.view" id="employee_salary_grade_list">
        <field name="name">hr.salary.grade.list</field>
        <field name="model">hr.salary.grade</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="currency_id" invisible="1"/>
                <field name="low_band"/>
                <field name="mid_band"/>
                <field name="high_band"/>
            </list>
        </field>
    </record>
    <record model="ir.actions.act_window" id="hr_salary_grade_act">
        <field name="name">Employee Grade</field>
        <field name="res_model">hr.salary.grade</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Employee Grade" id="salary_grade_config" parent="hr.menu_human_resources_configuration"
              action="hr_salary_grade_act" sequence="2" groups="hr.group_hr_manager"/>
</odoo>