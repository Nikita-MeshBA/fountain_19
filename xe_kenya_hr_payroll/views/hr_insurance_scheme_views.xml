<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_insurance_scheme_tree" model="ir.ui.view">
        <field name="name">hr.insurance.scheme.tree</field>
        <field name="model">hr.insurance.scheme</field>
        <field name="type">list</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Insurance Scheme">
                <field name="name"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="view_hr_insurance_scheme_form" model="ir.ui.view">
        <field name="name">hr.insurance.scheme.form</field>
        <field name="model">hr.insurance.scheme</field>
        <field name="type">form</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Insurance Scheme">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="amount" required="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_insurance_scheme_search" model="ir.ui.view">
        <field name="name">hr.insurance.scheme.search</field>
        <field name="model">hr.insurance.scheme</field>
        <field name="type">search</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Insurance Scheme">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_insurance_scheme" model="ir.actions.act_window">
        <field name="name">Insurance Scheme</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.insurance.scheme</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_insurance_scheme_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Insurance Scheme
            </p>
        </field>
    </record>

    <menuitem
            id="menu_hr_insurance_scheme"
            action="action_insurance_scheme"
            parent="hr.menu_human_resources_configuration"
            sequence="4"
            groups="base.group_no_one"/>
</odoo>