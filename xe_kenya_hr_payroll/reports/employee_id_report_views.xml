<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_id_card" model="report.paperformat">
        <field name="name">ID CARD</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">68</field>
        <field name="page_width">50</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">200</field>
    </record>
    <record id="hr_employee_id_print" model="ir.actions.report">
        <field name="name">Print Employee ID</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">xe_kenya_hr_payroll.print_employee_id</field>
        <field name="report_file">xe_kenya_hr_payroll.print_employee_id</field>
        <field name="binding_model_id" ref="model_hr_employee"/>
        <field name="paperformat_id"
               ref="xe_kenya_hr_payroll.paperformat_id_card"/>
        <field name="binding_type">report</field>
    </record>

    <template id="employee_front_side_report">
        <div class="page">
            <div class="row">
                <table style="width:100%;height:100%">
                    <tr
                            style="border: 0px solid black;background-color:#a52a2a;width:20%;height:15%">
                        <td>
                            <img t-if="employee.company_id.logo" width="80" height="80"
                                 style="padding:25px;"
                                 t-att-src="image_data_uri(employee.company_id.logo)"
                                 alt="Company Logo"/>
                        </td>
                        <td align="center" colspan="2" style="font-size:18px;width:80%;15%">
                            <span t-esc="employee.company_id.name"
                                  style="font-size:20px"></span>
                            <br/>
                            <span t-esc="employee.company_id.street"></span>
                            <br/>
                            <span t-esc="employee.company_id.city"></span>
                            ,
                            <span t-esc="employee.company_id.state_id.name">-</span>
                            <span t-esc="employee.company_id.zip"></span>
                            <br/>
                            <span t-esc="employee.company_id.country_id.name"></span>
                        </td>
                    </tr>
                    <tr style="border: 0px solid red;width:100%;height:35%">
                        <td style="width:30%;height:35%">
                            <img t-att-src="image_data_uri(employee.image_1920)"
                                 width="140" height="170" alt="Employee Image"
                                 style="padding:5px;"/>
                        </td>
                        <td align="left" style="font-size:16px;line-height: 8px;width:30%;height:35%">
                            <strong>
                                <p>Employee Name</p>
                                <br/>
                                <p>Employee ID</p>
                                <br/>
                                <p>Designation</p>
                                <br/>
                                <p style="line-height: 18px;">Principal Signature</p>
                            </strong>
                        </td>
                        <td align="left" style="font-size:16px;line-height: 8px;width:40%;height:35%">
                            <strong>
                                <br/>
                                <p>
                                    :
                                    <t t-esc="employee.name"/>
                                </p>
                                <br/>
                                <p>
                                    :
                                    <t t-esc="employee.registration_number"/>
                                </p>
                                <br/>
                                <p>
                                    :
                                    <t t-esc="employee.job_title"/>
                                </p>
                                <br/>
                                <p>
                                    <img t-if="employee.company_id.signature"
                                         t-att-src="image_data_uri(employee.company_id.signature)"
                                         width="140" height="60" alt="Signature"/>
                                </p>
                            </strong>
                        </td>
                    </tr>
                    <tr align="center"
                        style="border: 1px solid blue;width:100%;height:50%">
                        <td colspan="3">
                            <t t-if="employee.registration_number">
                                <div t-field="employee.registration_number"
                                     t-options="{'widget': 'barcode', 'width': 400, 'height': 80, 'img_align': 'center'}"/>
                            </t>
                            <t t-else="">
                                <div t-field="employee.identification_id"
                                     t-options="{'widget': 'barcode', 'width': 400, 'height': 80, 'img_align': 'center'}"/>
                            </t>
                            <br/>
                        </td>
                    </tr>
                    <tr
                            style="border: 0px solid green;background-color:#a52a2a;width:100%;height:52px">
                        <td colspan="3"></td>
                    </tr>

                </table>
            </div>
        </div>
    </template>

    <template id="employee_back_side_report">
        <div class="page">
            <div class="row">
                <table style="width:100%;height:100%">
                    <tr
                            style="border: 0px solid black;background-color:#a52a2a;width:20%;height:20%">
                        <td>
                            <img t-if="employee.company_id.logo" width="80" height="80"
                                 style="padding:25px;"
                                 t-att-src="image_data_uri(employee.company_id.logo)"
                                 alt="Company Logo"/>
                        </td>
                        <td align="center" colspan="2" style="font-size:20px;width:80%;height:20%">
                            <span t-esc="employee.company_id.name"
                                  style="font-size:22px"></span>
                            <br/>
                            <span t-esc="employee.company_id.street"></span>
                            <br/>
                            <span t-esc="employee.company_id.city"></span>
                            ,
                            <span t-esc="employee.company_id.state_id.name">-</span>
                            <span t-esc="employee.company_id.zip"></span>
                            <br/>
                            <span t-esc="employee.company_id.country_id.name"></span>
                        </td>
                    </tr>
                    <tr style="border: 0px solid red;width:100%;height:100%">
                        <td align="left" colspan="2" style="font-size:16px;">
                            <p style="line-height: 32px;">
                                <b>Resident Address:</b>
                                <br/>
                                <span style="margin-left:104pt;">
                                    <b>
                                        <t t-esc="employee.address_id.street"/>
                                    </b>
                                </span>
                                <br/>
                                <span style="margin-left:104pt;">
                                    <b>
                                        <t t-esc="employee.address_id.city"/>
                                    </b>
                                </span>
                                <br/>
                                <span style="margin-left:104pt;">
                                    <b>
                                        <t t-esc="employee.address_id.state_id.name"/>
                                    </b>
                                </span>
                                <br/>
                                <span style="margin-left:104pt;">
                                    <b>
                                        <t t-esc="employee.address_id.zip"/>
                                    </b>
                                </span>
                                <br/>
                                <span style="margin-left:104pt;">
                                    <b>
                                        <t t-esc="employee.address_id.country_id.name"/>
                                    </b>
                                </span>
                            </p>
                        </td>
                    </tr>
                    <tr align="center"
                        style="border: 0px solid blue;width:100%;height:50%">
                        <td colspan="3" align="center">
                            <p style="line-height: 29px;">
                                <span style="font-size:18px;">
                                    <b>Contact Information</b>
                                </span>
                                <br/>
                                <span style="font-size:16px;">
                                    <b>Emergency:</b>
                                    <t t-esc="employee.phone"/>
                                </span>
                                <br/>
                                <span style="font-size:16px;">
                                    <b>Official:</b>
                                    <t t-esc="employee.work_phone"/>
                                </span>
                                <br/>
                            </p>
                        </td>
                    </tr>
                    <tr
                            style="border: 0px solid green;background-color:#a52a2a;width:100%;height:49px">
                        <td colspan="3"></td>
                    </tr>
                </table>
            </div>
        </div>
    </template>

    <template id="print_employee_id">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="employee">
                <t t-if="employee.company_id.type_select == 'both'">
                    <t t-call="xe_kenya_hr_payroll.employee_front_side_report"/>
                    <t t-call="xe_kenya_hr_payroll.employee_back_side_report"/>
                </t>
                <t t-elif="employee.company_id.type_select == 'front'">
                    <t t-call="xe_kenya_hr_payroll.employee_front_side_report"/>
                </t>
                <t t-elif="employee.company_id.type_select == 'back'">
                    <t t-call="xe_kenya_hr_payroll.employee_back_side_report"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
