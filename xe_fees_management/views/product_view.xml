<odoo>
    <record id="view_product_template_inherit" model="ir.ui.view">
        <field name="name">product.template.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="is_fee"/>
            </field>
        </field>
    </record>

    <record id="product_normal_form_inherit" model="ir.ui.view">
        <field name="name">product.product</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="is_fee_product" string="Fee" invisible="type != 'service'"/>
                <field name="fee_receipt_id" invisible="is_fee_product == False or type != 'service'"/>
            </field>
        </field>
    </record>
</odoo>