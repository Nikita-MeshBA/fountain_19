<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fees_term_multi_company_rule" model="ir.rule">
        <field name="name">multi-company fees term</field>
        <field name="model_id" ref="model_xe_fees_term"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="fees_term_line_multi_company_rule" model="ir.rule">
        <field name="name">multi-company fees term line rule</field>
        <field name="model_id" ref="model_xe_fees_term_line"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Fees Type Rule -->
    <record model="ir.rule" id="fee_type_rule">
        <field name="name">Fee Type Rule</field>
        <field name="model_id" ref="model_xe_fees_type"/>
        <field name="groups" eval="[(4, ref('xenesis_school_base.group_xe_admin'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Fees Structure Rule -->
    <record id="fees_structure_multi_company_rule" model="ir.rule">
        <field name="name">multi-company fees structure rule</field>
        <field name="model_id" ref="model_xe_fees_structure"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Fees Receipt Rule -->
    <record id="fees_receipt_multi_company_rule" model="ir.rule">
        <field name="name">multi-company fees receipt rule</field>
        <field name="model_id" ref="model_fee_receipt"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
</odoo>