<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_warehouse_management">
        <field name="name">Inventory</field>
        <field name="description">Helps you manage your inventory and main stock operations:
            delivery orders, receptions, etc.
        </field>
        <field name="sequence">4</field>
    </record>
    <record id="group_stock_school_staff" model="res.groups">
        <field name="name">School Staff</field>
<!--        <field name="category_id" ref="xe_internal_product_request.module_category_warehouse_management"/>-->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="stock.group_stock_user" model="res.groups">
        <field name="name">User</field>
<!--        <field name="category_id" ref="xe_internal_product_request.module_category_warehouse_management"/>-->
        <field name="implied_ids" eval="[(4, ref('group_stock_school_staff'))]"/>
    </record>
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="name">Manager</field>
<!--        <field name="category_id" ref="xe_internal_product_request.module_category_warehouse_management"/>-->
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
<!--        <field name="users" eval="[(4, ref('base.user_root'))]"/>-->
    </record>
    <record model="ir.rule" id="pdt_reqst_staff">
        <field name="name">Product Request Rule Staff</field>
        <field name="model_id" ref="model_xe_product_request"/>
        <field name="groups" eval="[(4, ref('group_stock_school_staff'))]"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
    </record>
    <record model="ir.rule" id="pdt_reqst_user">
        <field name="name">Product Request Rule Inventory User</field>
        <field name="model_id" ref="model_xe_product_request"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
    </record>

    <record model="ir.rule" id="pdt_reqst_admin">
        <field name="name">Product Request Rule Inventory Manager</field>
        <field name="model_id" ref="model_xe_product_request"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>
</odoo>