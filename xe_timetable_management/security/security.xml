                <record id="module_category_time_table" model="ir.module.category">
            <field name="name">Timetable Access Rights</field>
            <field name="description">Helps you to Manage Access Rights</field>
            <field name="sequence">15</field>
        </record>

        <record id="privilege_timetable" model="res.groups.privilege">
            <field name="name">Timetable Access Rights</field>
            <field name="category_id" ref="module_category_time_table"/>
        </record>

        <record id="group_timetable_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_timetable"/>
            <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_timetable_admin" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_timetable"/>
            <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
            <field name="implied_ids" eval="[(4, ref('group_timetable_user')), (4, ref('base.group_user'))]"/>
        </record>
        <record model="ir.rule" id="timetable_manager_rule">
            <field name="name">Timetable - Manager Rule</field>
            <field name="model_id" ref="model_xe_timetable_sessions" />
            <field name="groups" eval="[(4, ref('group_timetable_admin'))]" />
            <field name="domain_force"> [(1,'=',1)]</field>
        </record>
        <record model="ir.rule" id="session_user_rule">
            <field name="name">Session Teacher - User Rule</field>
            <field name="model_id" ref="model_xe_session_lines" />
            <field name="groups" eval="[(4, ref('group_timetable_user')),(4, ref('xenesis_school_base.group_xe_staff'))]" />
            <field name="domain_force"> [('teacher_id.user_id','in',[user.id])]</field>
        </record>
        <record model="ir.rule" id="session_stud_user_rule">
            <field name="name">Session Student - User Rule</field>
            <field name="model_id" ref="model_xe_session_lines" />
            <field name="groups" eval="[(4, ref('group_timetable_user')),(4, ref('xenesis_school_base.group_xe_student'))]" />
            <field name="domain_force"> [('message_partner_ids','in',[user.partner_id.id])]</field>
        </record>

        <record model="ir.rule" id="session_manager_rule">
            <field name="name">Session Manager Rule</field>
            <field name="model_id" ref="model_xe_session_lines" />
            <field name="groups" eval="[(4, ref('group_timetable_admin'))]" />
            <field name="domain_force"> [(1,'=',1)]</field>
        </record>

        <record id="timetable_session_multi_company_rule" model="ir.rule">
            <field name="name">multi-company timetable session rule</field>
            <field name="model_id" ref="model_xe_timetable_sessions"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
    
        <record id="timings_multi_company_rule" model="ir.rule">
            <field name="name">multi-company timetable timing rule</field>
            <field name="model_id" ref="model_xe_timings"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <record model="ir.rule" id="session_company_rule">
            <field name="name">Session Company Rule</field>
            <field name="model_id" ref="model_xe_session_lines" />
            <field name="domain_force"> ['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>