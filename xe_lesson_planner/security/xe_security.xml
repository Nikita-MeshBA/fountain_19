        <field name="implied_ids" eval="[(4, ref('xe_lesson_planner.group_lesson_plan_teacher'))]"/>
    </record>

    <!-- Show Scheme of Work Based on User -->
    <record model="ir.rule" id="view_schem_of_work_access_user">
        <field name="name">Scheme Of Work User Rule</field>
        <field name="model_id" ref="model_scheme_of_work"></field>
        <field name="groups" eval="[(4, ref('xe_lesson_planner.group_lesson_plan_teacher'))]"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
    </record>
    <record model="ir.rule" id="view_schem_of_work_access_manager">
        <field name="name">Scheme Of Work Manager Rule</field>
        <field name="model_id" ref="model_scheme_of_work"/>
        <field name="groups" eval="[(4, ref('xe_lesson_planner.group_lesson_plan_department_head'))]"/>
        <field name="domain_force">['|',('employee_id.user_id','=',user.id),('department_head_id.user_id','=',user.id)]</field>
    </record>

    <!-- Show Lesson Plan Based on User -->
    <record model="ir.rule" id="view_lesson_plan_access_user">
