<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lesson_plan" model="ir.module.category">
        <field name="name">Lesson Planner</field>
        <field name="description">Helps you to Manage Access Rights</field>
        <field name="sequence">16</field>
    </record>
    
    <record id="group_lesson_plan_teacher" model="res.groups">
        <field name="name">Teacher</field>
<!--        <field name="category_id" ref="xe_lesson_planner.module_category_lesson_plan"/>-->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_lesson_plan_department_head" model="res.groups">
