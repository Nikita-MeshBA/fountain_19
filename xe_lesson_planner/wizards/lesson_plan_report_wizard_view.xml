<?xml version="1.0"?>
<odoo>
    <record model="ir.ui.view" id="lesson_plan_report_wizard_form">
        <field name="name">lesson.plan.report.wizard.form</field>
        <field name="model">lesson.plan.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Fees Details">
                <group>
                    <group>
                        <field name="date_from" required="1"/>
                        <field name="fees_filter"/>
                    </group>
                    <group>
                        <field name="date_to" required="1"/>
                        <field name="department_id" invisible="fees_filter != 'department'" required="fees_filter == 'department'"/>
                        <field name="employee_id"
                               invisible="fees_filter != 'employee'" required="fees_filter == 'employee'"/>
                        <field name="all_courses" widget="radio" invisible="fees_filter != 'course'"/>
                        <field name="course_id" invisible="all_courses != 'select_course' or fees_filter != 'course'" required="all_courses == 'select_course'" />
                         <field name="class_room_id" invisible="fees_filter != 'classroom'" required="fees_filter == 'classroom'" />
                    </group>
                </group>
                <footer groups="base.group_user">
                    <button name="check_report" type="object" string="Print"
                            class="oe_highlight"/>
                    <button name="check_report_xls" type="object" string="Print XLSX"
                            class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="lesson_plan_report_wizard_act" model="ir.actions.act_window">
        <field name="name">Lesson Plan Details</field>
        <field name="res_model">lesson.plan.report.wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="xe_lesson_planner.lesson_plan_report_wizard_form"/>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
</odoo>
