        <record id="act_cbc_lesson_plan" model="ir.actions.act_window">
            <field name="name">CBC Lesson Plan</field>
            <field name="res_model">cbc.lesson.plan</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_cbc_lesson_plan_search" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add a New CBC Lesson Plan</p>
            </field>
        </record>
        <!-- End Lesson Plan structure-->

        <!-- Sequence -->
        <record id="seq_scheme_of_work" model="ir.sequence">
            <field name="name">Scheme Of Work</field>
            <field name="code">scheme.of.work</field>
            <field name="prefix">SOW</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <record id="seq_lesson_plan" model="ir.sequence">
            <field name="name">Lesson Plan</field>
            <field name="code">lesson.plan</field>
            <field name="prefix">LP</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <record id="seq_cbc_scheme_of_work" model="ir.sequence">
            <field name="name">CBC Scheme Of Work</field>
            <field name="code">cbc.scheme.of.work</field>
            <field name="prefix">CBC-SOW</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <record id="seq_cbc_lesson_plan" model="ir.sequence">
            <field name="name">CBC Lesson Plan</field>
            <field name="code">cbc.lesson.plan</field>
            <field name="prefix">CBC-LP</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

    </data>
</odoo>