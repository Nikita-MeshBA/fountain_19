        <record id="act_scheme_of_work" model="ir.actions.act_window">
            <field name="name">Scheme Of Work</field>
            <field name="res_model">scheme.of.work</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_scheme_of_work_search" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add a new Scheme Of Work</p>
            </field>
        </record>
        <!-- End Schema Of Work structure-->

        <!-- Start Lesson Plan structure-->
        <record id="view_lesson_plan_tree" model="ir.ui.view">
            <field name="name">lesson.plan.tree</field>
            <field name="model">lesson.plan</field>
            <field name="arch" type="xml">
                <list string="Lesson Plan">
                    <field name="seq_name_lp" string="Sequence"/>
                    <field name="lesson" />
                    <field name="employee_id" string="Teacher" />
                    <field name="company_id" />
                    <field name="status" string="Status" decoration-info="status == 'draft'" decoration-warning="status == 'waiting_for_approval'" decoration-success="status in ['1st_approval', '2nd_approval']" widget="badge" />
                </list>
            </field>
        </record>

        <record id="view_lesson_plan_search" model="ir.ui.view">
            <field name="name">lesson.plan.search</field>
            <field name="model">lesson.plan</field>
            <field name="arch" type="xml">
                <search string="Lesson Plan">
                    <field name="employee_id" string="Teacher" />
                    <field name="seq_name_lp"  string="Sequence"/>
                    <field name="status" string="Status" />
                    <field name="class_id" string="Class" />
                    <field name="classroom_id" string="Class Room" />
                    <newline />
                </search>
            </field>
        </record>

        <record id="view_lesson_plan_form" model="ir.ui.view">
            <field name="name">lesson.plan.form</field>
            <field name="model">lesson.plan</field>
            <field name="arch" type="xml">
                <form string="Lesson Plan">
                    <header>
                        <field name="is_lesson_plan" invisible="1" />
                        <field name="is_submit" invisible="1" />
                        <field name="is_resubmit" invisible="1" />
                        <button name="button_submit" string="Submit" type="object" invisible="status != 'draft'" class="oe_highlight"/>
                        <button name="button_first_approval" string="Approve" type="object" invisible="status != 'waiting_for_approval'" class="oe_highlight"/>
                        <button name="button_second_approval" string="Approve" type="object" invisible="status != '1st_approval'" class="oe_highlight"/>
                        <button name="reset_draft" string="Reset to Draft" type="object" invisible="status not in ['waiting_for_approval', '1st_approval']"/>
                        <field name="status" widget="statusbar" />
                    </header>
                    <sheet>
                        <group col="2">
                            <group>
                                <field name="seq_name_lp" string="Name"/>
                                <field name="employee_id" string="Teacher" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="company_id" string="School" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="reg_no" string="Register Number" invisible="1"/>
                                <field name="week" string="Period Per Week" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="class_id" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="classroom_id" domain="[('course_id', '=', class_id)]" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="no_of_students" string="Number of Students" readonly="status in ['1st_approval','2nd_approval']" force_save="1" required="1"/>
                            </group>
                            <group>
                                <field name="academic_year_id" string="Year" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="academic_term_id" string="Term" domain="[('academic_year_id', '=', academic_year_id)]" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="subject_id" domain="[('course_ids', 'in', [class_id])]" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="lesson" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="topic" string="Strand" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="sub_topic" string="Sub strand" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="lesson_date" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <!-- <field name="department_head_id" string="Department Head" force_save="1" readonly="status in ['1st_approval','2nd_approval']"/>
                                <field name="head_teacher_id" string="Head Teacher" force_save="1" readonly="status in ['1st_approval','2nd_approval']"/> -->
                                <field name="scheme_of_work_id" invisible="1" />
                            </group>
                        </group>
                        <notebook>
                            <page name="lesson_plan_line" string="Lesson Plan Details">
                                <field name="lesson_plan_ids" readonly="status in ['1st_approval','2nd_approval']">
                                    <list editable="bottom">
                                        <field name="time" />
                                        <field name="content" />
                                        <field name="learning_activities" />
                                        <field name="learning_resources" />
                                        <field name="lesson_plan_id" invisible="1" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>
        
