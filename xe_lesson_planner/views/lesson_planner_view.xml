<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Start Schema Of Work structure-->
        <record id="view_scheme_of_work_tree" model="ir.ui.view">
            <field name="name">scheme.of.work.tree</field>
            <field name="model">scheme.of.work</field>
            <field name="arch" type="xml">
                <list string="Scheme of Work">
                    <field name="seq_name" string="Sequence"/>
                    <field name="employee_id" string="Teacher" />
                    <field name="department_head_id" string="Department Head" />
                    <field name="department_id" string="Department" invisible="1" />
                    <field name="department_manager_id" string="Department manager" invisible="1" />
                    <field name="company_id" />
                    <field name="class_id" string="Class" />
                    <field name="status" string="Status" decoration-info="status == 'draft'" decoration-warning="status == 'waiting_for_approval'" decoration-success="status in ['1st_approval', '2nd_approval']" widget="badge" />
                </list>
            </field>
        </record>

        <record id="view_scheme_of_work_search" model="ir.ui.view">
            <field name="name">scheme.of.work.search</field>
            <field name="model">scheme.of.work</field>
            <field name="arch" type="xml">
                <search string="Scheme Of Work Search">
                    <field name="employee_id" string="Teacher" />
                    <field name="seq_name" string="Sequence"/>
                    <field name="status" string="Status" />
                    <field name="class_id" string="Class" />
                    <field name="classroom_id" string="Class Room" />
                    <newline />
                </search>
            </field>
        </record>

        <record id="view_scheme_of_work_form" model="ir.ui.view">
            <field name="name">scheme.of.work.form</field>
            <field name="model">scheme.of.work</field>
            <field name="arch" type="xml">
                <form string="Scheme of Work">
                    <header>
                        <field name="is_scheme_of_work" invisible="1" />
                        <field name="is_submit" invisible="1" />
                        <field name="is_resubmit" invisible="1" />
                        <button name="button_submit" string="Submit" type="object" invisible="status != 'draft'" class="oe_highlight"/>
                        <button name="button_first_approval" string="Approve" type="object" invisible="status != 'waiting_for_approval'" class="oe_highlight"/>
                        <button name="button_second_approval" string="Approve" type="object" invisible="status != '1st_approval'" class="oe_highlight"/>
                        <button name="reset_draft" string="Reset to Draft" type="object" invisible="status not in ['waiting_for_approval', '1st_approval']"/>
                        <field name="status" widget="statusbar" />
                    </header>
                    <sheet>
                        <group col="2">
                            <group>
                                <field name="seq_name" string="Name"/>
                                <field name="employee_id" string="Teacher" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="company_id" string="School" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="assigned_sub_ids" string="Subjects" widget="many2many_tags" readonly="status in ['1st_approval','2nd_approval']" required="1" domain="[('course_ids', 'in', [class_id])]"/>
                                <field name="reg_no" string="Register Number" invisible="1" />
                                <field name="period_per_week" string="Period Per Week" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="type_select" widget="radio" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                            </group>
                            <group>
                                <field name="class_id" invisible="type_select in ['class_room']" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="classroom_id" domain="[('course_id', '=', class_id)]" invisible="type_select in ['class']" readonly="status in ['1st_approval','2nd_approval']" required="type_select == 'both'"/>
                                <field name="year_id" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="term_id" domain="[('academic_year_id', '=', year_id)]" readonly="status in ['1st_approval','2nd_approval']" required="1"/>
                                <field name="department_head_id" string="Department Head" force_save="1" readonly="status in ['1st_approval','2nd_approval']" required="1" invisible="1"/>
                                <field name="department_id" string="Department" invisible="1" />
                                <field name="department_manager_id" string="Department Manager" invisible="1" />
                                <field name="head_teacher_id" string="Head Teacher" force_save="1" readonly="status in ['1st_approval','2nd_approval']" required="1" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="scheme_of_work_line" string="Scheme Of Work Details">
                                <field name="scheme_of_work_ids" readonly="status in ['1st_approval','2nd_approval']">
                                    <list editable="bottom">
                                        <field name="week" />
                                        <field name="lesson" />
                                        <field name="topic" string="Strand" />
                                        <field name="sub_topic" string="Sub strand" />
                                        <field name="objectives" />
                                        <field name="learning_activities" />
                                        <field name="learning_resources" />
                                        <field name="key_inquiry_questions" />
                                        <field name="assessment_methods" />
                                        <field name="remarks" />
                                        <field name="scheme_of_work_id" invisible="1" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>
        
