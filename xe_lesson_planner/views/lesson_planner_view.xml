        <!--Configuration Menu -->
        <menuitem id="menu_lesson_planner_sub_root4" name="Configuration" groups="xe_lesson_planner.group_lesson_plan_teacher,xe_lesson_planner.group_lesson_plan_department_head" parent="menu_lesson_planner_root" sequence="30" />
        <menuitem id="menu_lesson_planner_header1" name="Lesson Plan Header" action="xe_lesson_planner.lesson_planner_header_action" parent="xe_lesson_planner.menu_lesson_planner_sub_root4" sequence="2" />
