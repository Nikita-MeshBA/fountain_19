        <menuitem id="menu_lesson_planner_report" name="Lesson Planner Analysis" groups="xe_lesson_planner.group_lesson_plan_teacher" action="xe_lesson_planner.lesson_plan_report_wizard_act" parent="xe_lesson_planner.menu_lesson_planner_sub_root3" sequence="1" />
        <menuitem id="menu_lesson_planner_analysis" name="Scheme of Work" action="xe_lesson_planner.lesson_plan_report_wizard_act" parent="xe_lesson_planner.menu_lesson_planner_report" sequence="1" />
