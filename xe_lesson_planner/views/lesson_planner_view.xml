        <menuitem id="menu_cbc_lesson_plan" name="Lesson Plan" action="xe_lesson_planner.act_cbc_lesson_plan" groups="xe_lesson_planner.group_lesson_plan_teacher" parent="menu_cbc_lesson_planner_sub_root2" sequence="2" />
