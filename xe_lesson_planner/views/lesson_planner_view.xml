        <record id="view_cbc_lp_header_form" model="ir.ui.view">
            <field name="name">cbc.lp.header.form</field>
            <field name="model">cbc.lp.header</field>
            <field name="arch" type="xml">
                <form string="Lesson Plan Header">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="lesson_planner_header_action" model="ir.actions.act_window">
            <field name="name">Lesson Plan Header</field>
            <field name="res_model">cbc.lp.header</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add a new Lesson Plan Header</p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_lesson_planner_root" name="Lesson Planner" sequence="8" groups="xe_lesson_planner.group_lesson_plan_teacher" web_icon="xe_lesson_planner,static/description/icon.png" />
        <menuitem id="menu_lesson_planner_sub_root" name="8-4-4 Lesson Plan" groups="xe_lesson_planner.group_lesson_plan_teacher" parent="menu_lesson_planner_root" sequence="1" />
        <menuitem id="menu_cbc_lesson_planner_sub_root2" name="CBC Lesson Plan" groups="xe_lesson_planner.group_lesson_plan_teacher,xe_lesson_planner.group_lesson_plan_department_head" parent="menu_lesson_planner_root" sequence="10" />

        <!-- Lesson Plan Menu -->
