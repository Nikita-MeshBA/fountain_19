        <record id="act_lesson_plan" model="ir.actions.act_window">
            <field name="name">Lesson Plan</field>
            <field name="res_model">lesson.plan</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_lesson_plan_search" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add a new Lesson Plan</p>
            </field>
        </record>
