  <!-- Lesson Plan Report Template -->
  <template id="report_cbc_lesson_plan">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="xe_lesson_planner.xen_custom_layout_header1">
          <div class="page">
            <style>
              .table, .th, .td {
                border: 1px solid black;
                border-collapse: collapse;
              }
            </style>
            <div class="oe_structure"/>
            <div>
              <center style="color:rgb(40, 46, 79); font-size: 22px; !important;"><b><u>LESSON PLAN</u></b></center><br/>
                        </div>
            <table class="table table-bordered">
              <tbody>
                <tr>
                  <td colspan="4" style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 12px;text-align:left !important;">
                    <b>NAME:</b>
                    <span t-esc="o.employee_id.name"/>
                  </td>
                  <td colspan="8" style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 12px;text-align:left !important;">
                    <b>LEARNING AREA:</b>
                    <span t-esc="o.subject_id.name"/>
                  </td>
                </tr>
                <tr>
                  <td colspan="4" style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 12px;text-align:left !important;">
                    <b>GRADE:</b>
                    <span t-esc="o.class_id.name"/>
                  </td>
                  <td colspan="4" style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 12px;text-align:left !important;">
                    <b>STREAM:</b>
                    <span t-esc="o.classroom_id.name"/>
                  </td>
                  <td colspan="4" style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 12px;text-align:left !important;">
                    <b>DATE:</b>
                    <!-- <span t-esc="str(o.lesson_date[:10])"/> -->
                    <span t-esc="o.lesson_date" t-options='{"widget": "date"}'/>
                  </td>
                </tr>
                 <tr>
                  <td colspan="4" style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 12px;text-align:left !important;">
                    <b>ROLL:</b>
                    <span t-esc="o.no_of_students"/>
                  </td>
                  <td colspan="4" style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 12px;text-align:left !important;">
                    <b>AGE:</b>
                    <span t-esc="o.age"/>
                  </td>
                  <td colspan="4" style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 12px;text-align:left !important;">
                    <b>TIME:</b>
                    <span t-esc="str(o.lesson_date)[10:]"/>
                  </td>
                </tr>

              </tbody>
            </table>
            <br/>
            <div class="row">
              <div>
                 <span><b>THEME:</b> <span t-esc="o.theme"/></span>
              </div>
            </div>
            <div class="row">
              <div>
                 <span><b>STRAND:</b> <span t-esc="o.topic"/></span>
              </div>
            </div>
            <div class="row">
              <div>
                 <span><b>SUB STRAND:</b> <span t-esc="o.sub_topic"/></span>
              </div>
            </div>


            <br/>
            <div class="row">
              <div>
                 <span><b>Specific Learning Outcomes</b></span>
              </div>
            </div>
            <div class="row">
              <div>
                <table class="table table-bordered" style="width:100%">
                  <tbody>
                    <t t-set="count" t-value="1"/>
                    <t t-foreach="o.learning_outcomes_ids" t-as="lo_id">
                      <tr>
                        <td style="width:7%">
                          <center><t t-esc="count"/></center>
                        </td>
                        <td>
                            <t t-esc="lo_id.name"/>
                        </td>
                      </tr>
                      <t t-set="count" t-value="count + 1"/>
                    </t>
                  </tbody>
                </table>
              </div>
            </div>


            <br/>
            <div class="row">
              <div>
                 <span><b>Key Inquiry Questions:</b></span>
              </div>
            </div>
            <div class="row">
              <div>
                <table class="table table-bordered" style="width:100%">
                  <tbody>
                    <t t-set="count" t-value="1"/>
                    <t t-foreach="o.key_inquiry_questions_ids" t-as="kiq_id">
                      <tr>
                        <td style="width:7%">
                          <center><t t-esc="count"/></center>
                        </td>
                        <td>
                            <t t-esc="kiq_id.name"/>
                        </td>
                      </tr>
                      <t t-set="count" t-value="count + 1"/>
                    </t>
                  </tbody>
                </table>
              </div>
            </div>


            <br/>
            <div class="row">
              <div>
                 <span><b>Learning Resources: </b></span>
              </div>
            </div>
            <div class="row">
              <div>
                <table class="table table-bordered" style="width:100%">
                  <tbody>
                    <t t-set="count" t-value="1"/>
                    <t t-foreach="o.learning_resources_ids" t-as="lr_id">
                      <tr>
                        <td style="width:7%">
                          <center><t t-esc="count"/></center>
                        </td>
                        <td>
                            <t t-esc="lr_id.name"/>
                        </td>
                      </tr>
                      <t t-set="count" t-value="count + 1"/>
                    </t>
                  </tbody>
                </table>
              </div>
            </div>


            <br/>
            <div class="row">
              <div>
                 <span><b>Organization Of Learning: </b></span>
              </div>
            </div>
            <div class="row">
              <div>
                <table class="table table-bordered" style="width:100%">
                  <tbody>
                    <tr>
                      <th>TIME</th>
                      <th>LEARNING EXPERIENCES</th>
                    </tr>
                    <t t-foreach="o.lesson_plan_ids" t-as="lp_id">
                      <tr>
                        <td style="width:20%">
                          <center><t t-esc="lp_id.time"/></center>
                        </td>
                        <td style="width:80%; white-space: pre-wrap; word-wrap: break-word;">
                            <t t-esc="lp_id.learning_experiences"/>
                        </td>
                      </tr>
                    </t>
                  </tbody>
                </table>
              </div>
            </div>

            <br/>
            <div class="row">
              <div>
                 <span><b>Reflection on the Lesson: </b> <t t-esc="o.reflection"/></span>
              </div>
            </div>



          </div>
        </t>
      </t>
    </t>
  </template>
