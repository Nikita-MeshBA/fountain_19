<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- CBC Scheme of work report template -->
  <template id="report_cbc_scheme_of_work">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="xe_lesson_planner.xen_custom_layout_header1">
          <div claas="container">
            <div class="page">
              <div>
                <center style="color:#203cd6s; font-size: 60px; !important;"><b>SCHEME OF WORK</b></center><br/>
                          </div>
                <table class="table table-bordered">
                  <tbody>
                    <tr>
                      <td style="font-family: Times, Times New Roman, serif; background-color: #c3c4d6; font-size: 40px;text-align:right !important;">
                        <b>NAME:</b>
                      </td>
                      <td style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 40px;text-align:left !important;">
                        <span t-esc="o.employee_id.name"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="font-family: Times, Times New Roman, serif; background-color: #c3c4d6; font-size: 40px;text-align:right !important;">
                        <b>T.S.C. NO.:</b>
                      </td>
                      <td style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 40px;text-align:left !important;">
                        <span t-esc="o.employee_id.tsc_no"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="font-family: Times, Times New Roman, serif; background-color: #c3c4d6; font-size: 40px;text-align:right !important;">
                        <b>LEARNING AREA:</b>
                      </td>
                      <td style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 40px;text-align:left !important;">
                        <span t-esc="', '.join([rec.name for rec in o.assigned_sub_ids])"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="font-family: Times, Times New Roman, serif; background-color: #c3c4d6; font-size: 40px;text-align:right !important;">
                        <b>GRADE:</b>
                      </td>
                      <td style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 40px;text-align:left !important;">
                        <span t-esc="o.class_id.name"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="font-family: Times, Times New Roman, serif; background-color: #c3c4d6; font-size: 40px;text-align:right !important;">
                        <b>TERM:</b>
                      </td>
                      <td style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 40px;text-align:left !important;">
                        <span t-esc="o.term_id.name"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="font-family: Times, Times New Roman, serif; background-color: #c3c4d6; font-size: 40px;text-align:right !important;">
                        <b>YEAR:</b>
                      </td>
                      <td style="font-family: Times, Times New Roman, serif; color: # 555; font-size: 40px;text-align:left !important;">
                        <span t-esc="o.year_id.name"/>
                      </td>
                    </tr>
                  </tbody>
                </table>
                <div class="row" style="page-break-before:always;"></div>
                <!-- <div class="pt-5"> -->
                  
                <table class="table table-bordered table-sm o_main_table">
                    <thead>
                      <tr style="background-color: #b9bdba">
                        <th>WK</th>
                        <th>LSN</th>
                        <th>STRAND</th>
                        <th>SUB STRAND</th>
                        <th>SPECIFIC LEARNING OUTCOMES</th>
                        <th>SUGGESTED LEARNING EXPERIENCES</th>
                        <th>KEY INQUIRY QUESTION(S)</th>
                        <th>LEARNING RESOURCES</th>
                        <th>ASSESSMENT TECHNIQUES</th>
                        <th>REFLECTION</th>
                      </tr>
                    </thead>
                    <tbody>
                      <t t-foreach="o.cbc_scheme_of_work_ids" t-as="work_id">
                        <tr>
                          <td><span t-esc="work_id.week"/></td>
                          <td><span t-esc="work_id.lesson"/></td>
                          <td><span t-esc="work_id.topic"/></td>
                          <td><span t-esc="work_id.sub_topic"/></td>
                          <td><span t-esc="work_id.objectives"/></td>
                          <td><span t-esc="work_id.learning_activities"/></td>
                          <td><span t-esc="work_id.key_inquiry_questions"/></td>
                          <td><span t-esc="work_id.learning_resources"/></td>
                          <td><span t-esc="work_id.assessment_methods"/></td>
                          <td><span t-esc="work_id.remarks"/></td>
                        </tr>
                      </t>
                  </tbody>
                </table>
                <!-- </div> -->
            </div>
          </div>
        </t>
      </t>
    </t>
  </template>
