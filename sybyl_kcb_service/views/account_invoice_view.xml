<odoo>
    <record model="ir.ui.view" id="account_move_view_inherit_little">
        <field name="name">account_move.view.buttons</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" name="button_kcb_cash_entries" string="KCB Transaction" type="object"
                        groups="account.group_account_invoice,account.group_account_manager" icon="fa-bars"/>
            </div>
        </field>
    </record>
    <record id="view_account_journal_form_inherited_little" model="ir.ui.view">
        <field name="name">account.journal.form.inherited.little</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="is_kcb_journal"/>
            </field>
        </field>
    </record>
</odoo>