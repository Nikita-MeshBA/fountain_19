    <record id="action_kcb_transaction" model="ir.actions.act_window">
        <field name="name">Transaction</field>
        <field name="res_model">kcb.transaction</field>
        <field name="view_mode">list,form</field>
<!--        <field name="search_view_id" ref="view_kcb_transaction_search"/>-->
