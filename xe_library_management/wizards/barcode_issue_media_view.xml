<?xml version="1.0"?>
<odoo>
    <record model="ir.ui.view" id="barcode_issue_media_form">
        <field name="name">barcode.issue.media.form</field>
        <field name="model">barcode.issue.media</field>
        <field name="arch" type="xml">
            <form string="media Issue">
                <group>
                    <group col="2">
                        <field name="transaction_type"/>
                        <field name="type" invisible="1"/>
                    </group>
                    <group col="2">
                        <field name="library_card_id" required="1"
                               options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                        <field name="media_unit_ids" widget="many2many_tags" invisible="1"/>
                    </group>
                </group>
                <!-- <group col="4" attrs="{'invisible':['|', ('type', '=', 'others'), ('type', '=', False)]}"> -->
                <group col="4" invisible="type == 'others' or type == False">
                    <field name="student_id" string="Student" readonly="1"/>
                    <field name="course_id" string="Class" readonly="1"/>
                    <field name="classroom_id" string="Classroom" readonly="1"/>
                </group>
                <!-- <group>
                    <field name="media_unit_number" required="1" />
                    <field name="library_card_number"
                        attrs="{'invisible':[('transaction_type','=','return')],'required':[('transaction_type','=','issue')]}" />
                </group>
                 <group col="4" attrs="{'invisible':[('transaction_type','=','return')]}">
                        <field name="issued_date" attrs="{'required':[('transaction_type','=','issue')]}"/>
                        <field name="return_date" attrs="{'required':[('transaction_type','=','issue')]}"/>
                </group>
                <group col="4" attrs="{'invisible':[('transaction_type','=','issue')]}">
                        <field name="move_due_date" readonly="1"/>
                        <field name="actual_return_date" attrs="{'required':[('transaction_type','=','return')]}"/>
                        <field name="penalty" readonly="1" force_save="1"/>
                </group> -->
                <field name="barcode_issue_media_line_ids">
                    <list>
                        <field name="media_unit_id" required="1"
                               options="{'no_open': True, 'no_edit': True, 'no_create': True}"/>
                        <field name="media_id" readonly="1"/>
                        <field name="media_isbn" readonly="1"/>
                        <!-- <field name="issued_date" attrs="{'invisible':[('parent.transaction_type','=','return')], 'required':[('parent.transaction_type','=','issue')]}"/> -->
                        <field name="issued_date" invisible="parent.transaction_type == 'return'"
                               required="'parent.transaction_type' == 'issue'"/>
                        <!-- <field name="return_date" attrs="{'invisible':[('parent.transaction_type','=','return')], 'required':[('parent.transaction_type','=','issue')]}"/> -->
                        <field name="return_date" invisible="parent.transaction_type == 'return'"
                               required="'parent.transaction_type' == 'issue'"/>
                        <!-- <field name="actual_return_date" attrs="{'invisible':[('parent.transaction_type','=','issue')], 'required':[('parent.transaction_type','=','return')]}"/> -->
                        <field name="actual_return_date" invisible="parent.transaction_type == 'issue'"
                               required="'parent.transaction_type' == 'return'"/>
                        <!-- <field name="move_due_date" string="Renew Return Date" attrs="{'invisible':[('parent.transaction_type','=','issue')]}"/> -->
                        <field name="move_due_date" string="Renew Return Date"
                               invisible="parent.transaction_type == 'issue'"/>
                        <field name="penalty" invisible="parent.transaction_type == 'issue'"/>
                    </list>
                    <form>
                        <group>
                            <group>
                                <field name="domain_media_unit_ids" invisible="1" widget="many2many_tags"/>
                                <field name="media_unit_id" required="1"
                                       options="{'no_open': True, 'no_edit': True, 'no_create': True}"
                                       domain="[('id', 'in', domain_media_unit_ids)]"/>
                                <field name="media_id" readonly="1"/>
                                <field name="media_isbn" readonly="1"/>
                                <!-- <field name="issued_date" attrs="{'invisible':[('parent.transaction_type','=','return')], 'required':[('parent.transaction_type','=','issue')]}"/> -->
                                <field name="issued_date" invisible="parent.transaction_type == 'return'"
                                       required="'parent.transaction_type' == 'issue'"/>
                                <field name="return_date" invisible="parent.transaction_type == 'return'"
                                       required="'parent.transaction_type' == 'issue'"/>
                                <field name="actual_return_date" invisible="parent.transaction_type == 'issue'"
                                       required="'parent.transaction_type' == 'return'"/>
                                <field name="move_due_date" string="Renew Return Date"
                                       invisible="parent.transaction_type == 'issue'"/>
                                <field name="penalty" invisible="parent.transaction_type == 'issue'"/>
                            </group>
                        </group>
                    </form>
                </field>
                <footer groups="base.group_user">
                    <button name="barcode_do_issue" type="object"
                            string="Proceed" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="barcode_issue_media_act">
        <field name="name">Issue media</field>
        <field name="res_model">barcode.issue.media</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="barcode_issue_media_form"/>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>

    <!-- <menuitem id="barcode_issue_media_menu" parent="xe_library_management.menu_xe_library_root"
        sequence="15" name="Issue Media" action="barcode_issue_media_act"
        groups="xe_library_management.group_xe_library" /> -->
</odoo>