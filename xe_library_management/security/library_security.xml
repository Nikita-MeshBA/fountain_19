    <record model="ir.rule" id="author_multi_comp_rule">
        <field name="name">Author multi-company</field>
        <field name="model_id" ref="xe_library_management.model_xe_author"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|','|',('company_id','=',False),('company_id','child_of',[user.company_id.id]),('company_id','child_of',[x.id
            for x in user.company_ids])]
        </field>
    </record>

