<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_xe_media_queue_tree" model="ir.ui.view">
        <field name="name">xe.media.queue.tree</field>
        <field name="model">xe.media.queue</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Media Queue Request">
                <field name='name'/>
                <field name="media_id"/>
                <field name="user_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_xe_media_queue_form" model="ir.ui.view">
        <field name="name">xe.media.queue.form</field>
        <field name="model">xe.media.queue</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="media Queue Request">
                <header groups="base.group_user">
                    <button name="action_accept" string="Accept" type="object"
                            invisible="state != 'request'" class="oe_highlight"
                            groups="xenesis_school_base.group_xe_admin,xe_library_management.group_xe_library"/>
                    <!-- states="request" class="oe_highlight" -->
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('request', 'accept')"
                            groups="xenesis_school_base.group_xe_admin,xe_library_management.group_xe_library"/>
                    <!-- states="request,accept" -->
                    <button name="action_request" string="Request Again"
                            invisible="state != 'reject'" type="object"
                            groups="xenesis_school_base.group_xe_staff,xenesis_school_base.group_xe_student"/>
                    <field name="state" widget="statusbar" statusbar_visible="request,reject,accept"
                           statusbar_colors='{"reject":"red"}'/>
                </header>
                <sheet>
                    <div style="font-size:20px;font-weight:bold;">
                        <field name="name"/>
                    </div>
                    <group col="4">
                        <field name="user_id" placeholder="Name"/>
                        <field name="media_id" placeholder="Media"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_xe_media_queue_search" model="ir.ui.view">
        <field name="name">xe.media.queue.search</field>
        <field name="model">xe.media.queue</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Media Queue Request">
                <field name="user_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <newline/>
                <group>
                    <filter string="Media" name="media_id" domain="[]" context="{'group_by':'media_id'}"/>
                    <filter string="Partner" name="user_id" domain="[]" context="{'group_by':'user_id'}"/>
                    <filter string="Status" name="state" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="act_open_xe_media_queue_view">
        <field name="name">Media Queue Requests</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xe.media.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_xe_media_queue_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
