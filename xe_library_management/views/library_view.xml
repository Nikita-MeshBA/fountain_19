<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Library Card Type -->
    <record id="view_xe_library_card_type_tree" model="ir.ui.view">
        <field name="name">xe.library.card.type.tree</field>
        <field name="model">xe.library.card.type</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Library Card Type">
                <field name="name"/>
                <field name="allow_media"/>
                <field name="duration"/>
                <field name="penalty_amt_per_day"/>
            </list>
        </field>
    </record>
    <record id="view_xe_library_card_type_form" model="ir.ui.view">
        <field name="name">xe.library.card.type.form</field>
        <field name="model">xe.library.card.type</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Library Card Type">
                <sheet>
                    <group col="4">
                        <field name="name" required="1"/>
                        <field name="allow_media" required="1"/>
                        <field name="duration" required="1"/>
                        <field name="is_penalty"/>
                        <field name="penalty_amt_per_day" invisible="is_penalty == False"/>
                        <field name="product_id" invisible="is_penalty == False" required="is_penalty == True"/>
                        <field name="type" required="1"/>
                        <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_xe_library_card_type_search" model="ir.ui.view">
        <field name="name">xe.library.card.type.search</field>
        <field name="model">xe.library.card.type</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Library Card Type">
                <field name="name"/>
                <field name="duration"/>
                <field name="penalty_amt_per_day"/>
                <field name="type"/>
                <newline/>
                <group>
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="act_open_xe_library_card_type_view">
        <field name="name">Library Card Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xe.library.card.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_xe_library_card_type_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
