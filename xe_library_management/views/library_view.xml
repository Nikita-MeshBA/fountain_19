    <!-- Library Card -->
    <record id="view_xe_library_card_tree" model="ir.ui.view">
        <field name="name">xe.library.card.tree</field>
        <field name="model">xe.library.card</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Library Card" create="false">
                <field name="number"/>
                <field name="issue_date"/>
                <field name="partner_id"/>
                <field name="library_card_type_id"/>
            </list>
        </field>
    </record>
    <record id="view_xe_library_card_form" model="ir.ui.view">
        <field name="name">xe.library.card.form</field>
        <field name="model">xe.library.card</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Library Card" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="library_card_type_id" required="1"/>
                            <field name="course_id" invisible="type != 'student'" required="type == 'student'"/>
                            <!-- <field name="partner_id" readonly="1" force_save="1"/>-->
                        </group>
                        <group>
                            <field name="issue_date" required="1"/>
                            <field name="type" invisible="1"/>
                            <!-- <field name="batch_id" attrs="{'invisible':[('type','!=','student')],'required':[('type','=','student')]}"/>-->
                            <field name="student_id" options="{'no_create': True , 'no_open': True}"
                                   invisible="type != 'student'" required="type == 'student'"/>
                            <field name="faculty_id" options="{'no_create': True , 'no_open': True}"
                                   invisible="type != 'others'" required="type == 'others'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_xe_library_card_search" model="ir.ui.view">
        <field name="name">xe.library.card.search</field>
        <field name="model">xe.library.card</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Library Card">
                <field name="number"/>
                <field name="issue_date"/>
                <field name="partner_id"/>
                <field name="library_card_type_id"/>
                <newline/>
                <group>
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="act_open_xe_library_card_view">
        <field name="name">Library Cards</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xe.library.card</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_xe_library_card_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
