<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_xe_publisher_tree" model="ir.ui.view">
        <field name="name">xe.publisher.tree</field>
        <field name="model">xe.publisher</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Publisher">
                <field name="name"/>
                <field name="address_id"/>
                <field name="media_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="view_xe_publisher_form" model="ir.ui.view">
        <field name="name">xe.publisher.form</field>
        <field name="model">xe.publisher</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Publisher">
                <sheet>
                    <group col="4">
                        <field name="name"/>
                        <field name="address_id" context="{'show_address': 1}"
                               xetions='{"always_reload": True}'/>
                        <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                    </group>
                    <group col="4" string="Media(s)">
                        <field name="media_ids" colspan="4" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_xe_publisher_search" model="ir.ui.view">
        <field name="name">xe.publisher.search</field>
        <field name="model">xe.publisher</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Publisher">
                <field name="name"/>
                <field name="address_id"/>
                <field name="media_ids"/>
                <newline/>
                <group>
                    <filter string="Publisher" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="act_open_xe_publisher_view">
        <field name="name">Publishers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xe.publisher</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_xe_publisher_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <record model="ir.actions.act_window.view" id="act_open_xe_publisher_view_form">
        <field name="act_window_id" ref="act_open_xe_publisher_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_xe_publisher_form"/>
    </record>
    <record model="ir.actions.act_window.view" id="act_open_xe_publisher_view_tree">
        <field name="act_window_id" ref="act_open_xe_publisher_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_xe_publisher_tree"/>
    </record>
</odoo>
