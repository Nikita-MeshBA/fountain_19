<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_xe_tag_tree" model="ir.ui.view">
        <field name="name">xe.tag.tree</field>
        <field name="model">xe.tag</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Tag">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_xe_tag_form" model="ir.ui.view">
        <field name="name">xe.tag.form</field>
        <field name="model">xe.tag</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" options="{'no_create':True}" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_xe_tag_search" model="ir.ui.view">
        <field name="name">xe.tag.search</field>
        <field name="model">xe.tag</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <search string="Tag">
                <field name="name"/>
                <newline/>
                <group>
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="act_open_xe_tag_view">
        <field name="name">Tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xe.tag</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_xe_tag_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <record model="ir.actions.act_window.view" id="act_open_xe_tag_view_form">
        <field name="act_window_id" ref="act_open_xe_tag_view"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_xe_tag_form"/>
    </record>
    <record model="ir.actions.act_window.view" id="act_open_xe_tag_view_tree">
        <field name="act_window_id" ref="act_open_xe_tag_view"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_xe_tag_tree"/>
    </record>
</odoo>
