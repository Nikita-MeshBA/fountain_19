<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_xe_student_form_library_inherit" model="ir.ui.view">
        <field name="name">xe.student.form.library.inherit</field>
        <field name="model">xe.student</field>
        <field name="inherit_id" ref="xenesis_school_base.view_student_form"/>
        <field name="priority" eval="9"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet[1]" position="before">
                <header>
                    <field name="library_card_id" invisible="1"/>
                    <button name="action_library_card" string="Create Library Card" class="oe_highlight"
                            type="object" groups="xe_library_management.group_xe_library"
                            invisible="library_card_id != False"/>
                </header>
            </xpath>
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_view_media_movement" type="object" string="Library" class="oe_stat_button"
                        icon="fa-book"
                        groups="xenesis_school_base.group_xe_parent,xenesis_school_base.group_xe_student">
                </button>
            </xpath>
        </field>
    </record>
    <record id="action_create_lib_card" model="ir.actions.server">
        <field name="sequence" eval="5"/>
        <field name="state">code</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="xenesis_school_base.model_xe_student"/>
        <field name="binding_model_id" ref="xenesis_school_base.model_xe_student"/>
        <field name="binding_view_types">list</field>
        <field name="code">model.create_card_act()</field>
        <field name="name">Create Library Card</field>
        <field name="group_ids"
               eval="[(4, ref('xenesis_school_base.group_xe_admin')),(4, ref('xenesis_school_base.group_xe_staff'))]"/>
    </record>
</odoo>
