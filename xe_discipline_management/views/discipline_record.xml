        <record id="view_xe_discipline_search" model="ir.ui.view">
    <field name="name">xe.discipline.search</field>
    <field name="model">xe.discipline.records</field>
    <field name="arch" type="xml">
        <search string="Discipline Records">
            <field name="name"/>
        </search>
    </field>
    </record>

        <record model="ir.actions.act_window" id="discipline_act_wndw">
            <field name="name">Discipline Records</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">xe.discipline.records</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="sequence_discipline" model="ir.sequence">
            <field name="name">Discipline sequence</field>
            <field name="code">xe.discipline.records.seq</field>
            <field name="prefix">DSPLN/%(range_year)s/</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="True" name="use_date_range"/>
            <field eval="False" name="company_id"/>
            <field name="padding">4</field>
        </record>
        <menuitem name="Discipline Records" id="discipline_record_root" parent="discipline_main_menu" action="discipline_act_wndw" sequence="1"/>
        <menuitem name="Reports" id="discipline_report_root_menu" parent="discipline_main_menu"/>
    </data>
