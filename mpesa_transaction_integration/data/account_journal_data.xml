<odoo>
    <data noupdate="1">
        <record id="mpesa_journal" model="account.journal">
            <field name="name">Mpesa</field>
            <field name="code">SAP</field>
            <field name="type">bank</field>
            <field name="is_mpesa_journal" eval="True"/>
        </record>
    </data>

    <record id="mpesa_payment_transaction_cron" model="ir.cron">
        <field name="name">Mpesa Payment Transaction: Generate invoice payment entries</field>
        <field name="model_id" ref="model_mpesa_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_invoice_payment_entries()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
<!--        <field name="numbercall">-1</field>-->
<!--        <field name="doall" eval="False"/>-->
        <field name="active" eval="False"/>
    </record>
    <record id="mpesa_match_invoice_record_cron" model="ir.cron">
        <field name="name">Mpesa Payment Transaction: Match Invoice with Payments</field>
        <field name="model_id" ref="model_mpesa_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_match_invoice_payment_entries()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
<!--        <field name="numbercall">-1</field>-->
<!--        <field name="doall" eval="False"/>-->
        <field name="active" eval="False"/>
    </record>

</odoo>