        <record id="view_mpesa_payment_transaction_filter" model="ir.ui.view">
        <field name="name">mpesa.payment.transaction.select</field>
        <field name="model">mpesa.payment.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Mpesa Transaction">
                <field name="bill_ref_number"/>
                <field name="first_name"/>
                <field name="middle_name"/>
                <field name="last_name"/>
                <field name="date"/>

                <filter name="draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>

                <filter name="paid"
                        string="Reconciled"
                        domain="[('state', '=', 'done')]"/>

                <filter name="cancel"
                        string="Cancelled"
                        domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>
    <record id="action_mpesa_payment_transaction_form" model="ir.actions.act_window">
        <field name="name">Mpesa Transactions</field>
        <field name="res_model">mpesa.payment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="mpesa_payment_transaction_tree_view"/>
        <!-- <field name="search_view_id" ref="view_mpesa_payment_transaction_filter"/>-->
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Transaction are not empty.
            </p>
        </field>
    </record>

    <record id="mpesa_payment_creation_cron" model="ir.cron">
        <field name="name">Mpesa Automatic Payment Creation Cron</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="state">code</field>
        <field name="code">model._cron_mpesa_payment_creation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
<!--        <field name="numbercall">-1</field>-->
<!--        <field name="doall" eval="False"/>-->
    </record>

