<odoo>
    <record id="mpesa_payment_transaction_from_view" model="ir.ui.view">
        <field name="name">mpesa.payment.transaction.form.view</field>
        <field name="model">mpesa.payment.transaction</field>
        <field name="arch" type="xml">
            <form string="Mpesa Payment Transaction" create="false" edit="false">
                <header>
                    <button name="validate_invoice_payment" type="object" string="Reconcile" class="oe_highlight"
                            invisible="state in ['done', 'cancel']"/>
                    <button name="button_manual_reconcile_payment" type="object" string="Manual Reconcile" invisible="state in ['done', 'cancel']"/>
                    <button name="state_cancel" type="object" string="Cancel" invisible="state in ['cancel', 'done']"/>
                    <button name="state_draft" type="object" string="Set to Draft"
                            invisible="state in ['draft', 'done']"/>
                    <field name='state' widget="statusbar" statusbar_visible='draft,done,cancel'/>
                </header>
                <sheet>
                    <h1 class="mt0">
                        <div>
                            <field name="invoice_name" readonly="1" class="oe_inline"/>
                        </div>
                    </h1>
                    <field name="invoice_id"/>
                    <group>
                        <group>
                            <field name="first_name"/>
                            <field name="middle_name"/>
                            <field name="last_name"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="transaction_type"/>
                            <field name="trans_id"/>
                            <field name="trans_time"/>
                            <field name="trans_amount"/>
                            <field name="business_shortcode"/>
                            <field name="bill_ref_number"/>
                        </group>
                        <group>
                            <field name="invoice_number"/>
                            <field name="org_account_balance"/>
                            <field name="third_party_transid"/>
                            <field name="msisdn"/>
                            <field name="org_account_balance"/>
                        </group>
                    </group>
                    <group>
                        <field name="payment_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="datas"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mpesa_payment_transaction_tree_view" model="ir.ui.view">
        <field name="name">mpesa.payment.transaction.form.view</field>
        <field name="model">mpesa.payment.transaction</field>
        <field name="arch" type="xml">
            <list create="false" edit="false"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancel'">
                <field name="state" column_invisible="1"/>
                <field name="first_name"/>
                <field name="middle_name"/>
                <field name="last_name"/>
                <field name="transaction_type" string="Type"/>
                <field name="date"/>
                <field name="business_shortcode"/>
                <field name="bill_ref_number" string="Bill Reference"/>
                <field name="invoice_id" string="Invoice"/>
                <field name="trans_amount" string="Amount"/>
                <button name="validate_invoice_payment" string="Reconcile" type="object"
                        invisible="state in ['done', 'cancel']"/>
                <button name="state_cancel" string="Cancel" type="object"
                        invisible="state in ['done', 'cancel']"/>
            </list>
        </field>
    </record>

