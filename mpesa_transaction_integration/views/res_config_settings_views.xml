<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mpesacash.payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="integration" position="inside">
                <settings class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <label string="MpesaCash Payment" for="mpesa_api_key"/>
                        <div class="text-muted">
                            Synchronize mpesa cash payments
                        </div>
                        <div id="model_sma">
                            <div class="content-group">
                                <div class="mt16 row">
                                    <div>
                                        <label for="mpesa_api_key" string="API KEY"
                                               class="col-xs-3 col-md-3 o_light_label"/>
                                        <field name="mpesa_api_key" nolabel="1"/>
                                        <br/>
                                    </div>
                                    <div>
                                        <label for="mpesa_secret" string="Client Secret"
                                               class="col-xs-3 col-md-3 o_light_label"/>
                                        <field name="mpesa_secret" password="True" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </settings>
                <!-- <settings class="col-xs-12 col-md-6 o_setting_box" id="payment_method">
                    <div class="o_setting_left_pane">
                        <field name="is_reconcile"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="transaction_by" string="Reconcilation Payment Methods"/>
                        <div class="text-muted" invisible="not is_reconcile">
                            Mpesa Reconcilation Payment Methods
                        </div>
                        <div class="content-group" invisible="not is_reconcile">
                            <field name="transaction_by" class="o_light_label mt16" widget="radio"/>
                        </div>
                    </div>
                </settings> -->
            </block>
        </field>
    </record>
</odoo>
