<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
	<t t-name="MpesaCashDashboard">
		<div class="o_view_manager_content">
            <div class="container-fluid oe_background_grey">
                <div class="mpesa_dashboard_main">
                    <div class="row o_transaction_card"/>
                    <div class="row chart">
                      <div class="col-md-12 col-xs-12">
                        <div class="o_transaction_chart">
                          <canvas id="o_transaction_chart"/>
                        </div>
                      </div>
                    </div>
                    <div class="row o_table">
                      <div class="col-md-12 col-xs-12">
                        <div id="o_transaction_table">

                        </div>
                      </div>
                    </div>
                </div>
            </div>
        </div>
	</t>

    <t t-name="DateRangePicker">
        <div class="d-md-inline-flex pull-right" style="display: -webkit-inline-box;margin-right:50px;">
            <div id="reportrange" style="background: #fff; cursor: pointer; padding: 5px 10px;
             border: 1px solid #ccc; width: 100%">
                <i class="fa fa-calendar"></i>
                <span></span>
                <i class="fa fa-caret-down"></i>
            </div>
        </div>
        <div class="pull-left"></div>
    </t>

    <t t-name="TransactionCard">
        <div class="col-xs-4 col-md-4">
            <div class="card card-stats">
                <!-- Card body -->
                <div class="card-body">
                  <div class="row">
                    <div class="col">
                      <h5 class="card-title text-uppercase text-muted mb-0">Transaction Value</h5>
                        <span class="h2 font-weight-bold mb-0">KES <t t-esc="total"/></span>
                    </div>
                      <div class="col-auto">
                    </div>
                  </div>
                    <p class="mt-3 mb-0 text-sm">
                    <!-- <span class="text-success mr-2"><i class="fa fa-arrow-up"></i> <t t-esc="days_ago_total_amount"/>%</span>
                    <span class="text-nowrap"><t t-esc="widget.days"/> DAYS AGO</span> -->
                        <span class="mode" style="float: right;">
                      <a class="view" href="#o_transaction_chart"><i class="glyphicon glyphicon-eye-open"/>View</a>
                            <a class="list" href="#o_transaction_table"><i class="glyphicon glyphicon-list"/>List</a>
                    </span>
                  </p>
                </div>
              </div>
        </div>
        <div class="col-xs-4 col-md-4">
            <div class="card card-stats">
                <!-- Card body -->
                <div class="card-body">
                  <div class="row">
                    <div class="col">
                      <h5 class="card-title text-uppercase text-muted mb-0">Transaction Count</h5>
                        <span class="h2 font-weight-bold mb-0"><t t-esc="total_count"/></span>
                    </div>
                      <div class="col-auto">
                      
                    </div>
                  </div>
                    <p class="mt-3 mb-0 text-sm">
                    <!-- <span class="text-success mr-2"><i class="fa fa-arrow-up"></i> <t t-esc="days_ago_count"/>%</span>
                    <span class="text-nowrap"><t t-esc="widget.days"/> DAYS AGO</span> -->
                        <span class="mode" style="float: right;">
                      <a class="view" href="#o_transaction_chart"><i class="glyphicon glyphicon-eye-open"/>View</a>
                            <a class="list" href="#o_transaction_table"><i class="glyphicon glyphicon-list"/>List</a>
                    </span>
                  </p>
                </div>
              </div>
        </div>
        <div class="col-xs-4 col-md-4">
            <div class="card card-stats">
                <!-- Card body -->
                <div class="card-body">
                  <div class="row">
                    <div class="col">
                      <h5 class="card-title text-uppercase text-muted mb-0">Customer Count</h5>
                        <span class="h2 font-weight-bold mb-0"><t t-esc="customer_count"/></span>
                    </div>
                      <div class="col-auto">
                      
                    </div>
                  </div>
                    <p class="mt-3 mb-0 text-sm">
                    <!-- <span class="text-success mr-2"><i class="fa fa-arrow-up"></i> <t t-esc="days_ago_cutomer_count"/>%</span>
                    <span class="text-nowrap"><t t-esc="widget.days"/> DAYS AGO</span> -->
                        <span class="mode" style="float: right;">
                      <a class="view" href="#o_transaction_chart"><i class="glyphicon glyphicon-eye-open"/>View</a>
                            <a class="list" href="#o_transaction_table"><i class="glyphicon glyphicon-list"/>List</a>
                    </span>
                  </p>
                </div>
              </div>
        </div>
    </t>

    <t t-name="MPesaListView">
        <table id="oe_table" style="width:100% !important;" class="table table-striped table-bordered">
            <t t-set="is_empty" t-value="_.isEmpty(fields)"/>
            <thead>
                <t t-foreach="fields" t-as="field">
                    <th><t t-esc="field"/></th>
                </t>
                <t t-if="!is_empty">
                    <th></th>
                </t>
            </thead>
        </table>
    </t>

</templates>