<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mpesa_transaction_report_wizard" model="ir.ui.view">
        <field name="name">mpesa.transaction.report.wizard.form.view</field>
        <field name="model">mpesa.transaction.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Transaction Report">
                <group>
                    <group>
                        <field name="start_date"/>
                    </group>
                    <group>
                        <field name="end_date"/>
                    </group>
                </group>
                <footer>
                    <button name="get_report" string="PDF" type="object" class="btn-primary"/>
                    <button name="print_xlsx" string="XLSX" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mpesa_transaction_report_wizard" model="ir.actions.act_window">
        <field name="name">Transaction Report</field>
        <field name="res_model">mpesa.transaction.report.wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mpesa_transaction_report_wizard"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="mpesa_transaction_integration.model_mpesa_transaction_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <menuitem id="menu_transaction_report"
              name="Transaction Report"
              parent="menu_mpesa_payment_root"
              sequence="3"
              action="action_mpesa_transaction_report_wizard"
              groups="account.group_account_manager"/>
</odoo>