<odoo>


    <record id="sybyl_cooperative_transaction_list" model="ir.ui.view">
        <field name="name">coop.bank.transaction.list</field>
        <field name="model">coop.bank.transaction</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="state" optional="hide" invisible="1"/>
                <field name="message_id" optional="hide" invisible="1"/>
                <field name="odoo_id" optional="hide" invisible="1"/>
                <field name="student_id" optional="hide" invisible="1"/>
                <field name="invoice_id" optional="hide" invisible="1"/>
                <field name="connection_id" optional="hide" invisible="1"/>
                <field name="transaction_reference_code"/>
                <field name="transaction_date" optional="hide" invisible="1"/>
                <field name="transaction_datetime"/>
                <field name="total_amount"/>
                <field name="currency" optional="hide" invisible="1"/>
                <field name="document_reference_number"/>
                <field name="bank_code" optional="hide" invisible="1"/>
                <field name="branch_code" optional="hide" invisible="1"/>
                <field name="payment_date" optional="hide" invisible="1"/>
                <field name="payment_reference_code"/>
                <field name="payment_code" optional="hide" invisible="1"/>
                <field name="payment_mode" optional="hide" invisible="1"/>
                <field name="payment_amount" optional="hide" invisible="1"/>
                <field name="additional_info" optional="hide" invisible="1"/>
                <field name="account_number" optional="hide" invisible="1"/>
                <field name="account_name" optional="hide" invisible="1"/>
                <field name="institution_code" optional="hide" invisible="1"/>
                <field name="log_ids" optional="hide" invisible="1"/>
                <button name="view_manual_reconcile" type="object" string="Reconcile" class="oe_highlight" invisible="state in ('done', 'cancel')"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="sybyl_cooperative_transaction_form">
        <field name="name">coop.bank.transaction.form</field>
        <field name="model">coop.bank.transaction</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="view_manual_reconcile" type="object" string="Reconcile" class="oe_highlight" invisible="state in ('done', 'cancel')"/>
                    <button name="state_cancel" type="object" string="Cancel" class="oe_highlight" invisible="state in ('cancel', 'done')"/>
                    <button name="state_draft" type="object" string="Set to Draft" invisible="state in ('draft', 'done')"/>
                    <field name='state' widget="statusbar" statusbar_visible='draft,done,cancel'/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="message_id"/>
                            <field name="odoo_id"/>
                            <field name="student_id"/>
                            <field name="invoice_id"/>
                            <field name="invoice_amount"/>
                            <field name="connection_id"/>
                            <field name="transaction_reference_code"/>
                            <field name="transaction_date"/>
                            <field name="transaction_datetime"/>
                            <field name="total_amount"/>
                            <field name="currency"/>
                            <field name="document_reference_number"/>
                            <field name="payment_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="bank_code"/>
                            <field name="branch_code"/>
                            <field name="payment_date"/>
                            <field name="payment_reference_code"/>
                            <field name="payment_code"/>
                            <field name="payment_mode"/>
                            <field name="payment_amount"/>
                            <field name="additional_info"/>
                            <field name="account_number"/>
                            <field name="account_name"/>
                            <field name="institution_code"/>
                        </group>
                    </group>
                    <field name="log_ids" optional="hide"/>
                </sheet>
            </form>
        </field>
    </record>

    
