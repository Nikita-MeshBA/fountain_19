        <record id="view_coop_payment_transaction_filter" model="ir.ui.view">
        <field name="name">coop.payment.transaction.select</field>
        <field name="model">coop.bank.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Coop Transaction">
                <field name="transaction_reference_code"/>
                <field name="state"/>

                <filter name="draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>

                <filter name="paid"
                        string="Reconciled"
                        domain="[('state', '=', 'done')]"/>

                <filter name="cancel"
                        string="Cancelled"
                        domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="sybyl_cooperative_transaction_action_window">
        <field name="name">COOP-Bank Transactions</field>
        <field name="res_model">coop.bank.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="sybyl_cooperative_transaction_menu" parent="account.menu_finance_receivables" sequence="199"
              action="sybyl_cooperative_transaction_action_window"/>
